# Local secrets — copy this file to application-local.yml and fill in your values.
# application-local.yml is gitignored.

auraboot:
  payment:
    enabled: true
    stripe:
      secret-key: sk_test_your_key_here
      publishable-key: pk_test_your_key_here
      webhook-secret: whsec_your_secret_here
  performance:
    slow-query-threshold-ms: 20
    sql-count-warn-threshold: 50
    sql-count-error-threshold: 100

logging:
  level:
    org.apache.ibatis: DEBUG
    org.mybatis: DEBUG

# QQ Mail SMTP for verification codes. Use the QQ Mail authorization code,
# never the mailbox login password. Keep application-local.yml untracked.
# spring:
#   mail:
#     host: smtp.qq.com
#     port: 465
#     username: your-account@qq.com
#     password: your-qq-mail-authorization-code
#     properties:
#       mail.smtp.auth: true
#       mail.smtp.ssl.enable: true
#       mail.smtp.connectiontimeout: 10000
#       mail.smtp.timeout: 10000
#       mail.smtp.writetimeout: 10000
# auraboot:
#   mail:
#     from: your-account@qq.com
