{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auraboot.com/schemas/application-lock-v1.json",
  "title": "AuraBoot Application Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "manifestDigest", "composition", "artifacts", "identity"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "manifestDigest": { "$ref": "#/definitions/digest" },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphDigest", "nodes"],
      "properties": {
        "graphDigest": { "$ref": "#/definitions/digest" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "order"],
            "properties": {
              "kind": { "enum": ["runtime", "api", "web", "plugin", "migration", "config", "route", "block", "action", "widget", "provider", "i18n"] },
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "export": { "type": "string", "minLength": 1 },
              "rendering": { "const": "universal" },
              "permission": { "type": "string", "minLength": 1 },
              "featureKey": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "version", "uri", "digest", "source"],
        "properties": {
          "type": { "enum": ["runtime", "maven", "npm", "plugin", "config", "migration", "oci"] },
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "pattern": "^(maven|npm|oci|artifact):" },
          "digest": { "$ref": "#/definitions/digest" },
          "localPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "commit"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          }
        }
      }
    },
    "identity": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
