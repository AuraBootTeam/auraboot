{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auraboot.com/schemas/deployment-capabilities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deploymentId",
    "generation",
    "platformRelease",
    "platformContracts",
    "supportedApplications",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "platformRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "digest"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "platformContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "pluginApi",
        "dslSchema"
      ],
      "properties": {
        "runtime": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "pluginApi": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "dslSchema": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "supportedApplications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application",
          "compatibilityEpochs"
        ],
        "properties": {
          "application": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,99}$"
          },
          "compatibilityEpochs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "key",
          "contract",
          "providerDigests"
        ],
        "properties": {
          "kind": {
            "enum": [
              "handler",
              "web",
              "schema"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "providerDigests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
