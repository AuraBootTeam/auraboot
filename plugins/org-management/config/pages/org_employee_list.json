{
  "pageKey": "org_employee_list",
  "name:zh-CN": "人员管理",
  "name:en": "Employee Management",
  "modelCode": "org_employee",
  "description": "Employee list with status tabs and CRUD",
  "kind": "list",
  "schemaVersion": 4,
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "block_emp_tabs",
      "blockType": "tabs",
      "layout": {
        "colSpan": 12,
        "rowSpan": 1
      },
      "tabs": [
        {
          "key": "all",
          "label": {
            "zh-CN": "全部",
            "en": "All"
          },
          "filter": null
        },
        {
          "key": "active",
          "label": {
            "zh-CN": "在职",
            "en": "Active"
          },
          "filter": {
            "field": "org_emp_status",
            "operator": "EQ",
            "value": "active"
          }
        },
        {
          "key": "on_leave",
          "label": {
            "zh-CN": "休假",
            "en": "On Leave"
          },
          "filter": {
            "field": "org_emp_status",
            "operator": "EQ",
            "value": "on_leave"
          }
        },
        {
          "key": "resigned",
          "label": {
            "zh-CN": "离职",
            "en": "Resigned"
          },
          "filter": {
            "field": "org_emp_status",
            "operator": "EQ",
            "value": "resigned"
          }
        }
      ]
    },
    {
      "id": "block_emp_toolbar",
      "blockType": "form-buttons",
      "layout": {
        "colSpan": 12,
        "rowSpan": 1
      },
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "icon": "Plus",
          "label": {
            "zh-CN": "新建",
            "en": "Create"
          },
          "action": {
            "type": "navigate",
            "to": "org_employee_form"
          },
          "permissionCode": "org.hr.manage"
        }
      ]
    },
    {
      "id": "block_emp_table",
      "blockType": "table",
      "layout": {
        "colSpan": 12,
        "rowSpan": 1
      },
      "defaultSort": {
        "field": "org_emp_name",
        "order": "asc"
      },
      "searchFields": [
        "org_emp_code",
        "org_emp_name",
        "org_emp_status"
      ],
      "searchPlaceholder": {
        "zh-CN": "搜索人员编号、姓名或状态",
        "en": "Search employee number, name or status"
      },
      "columns": [
        {
          "field": "org_emp_code",
          "width": 150,
          "fixed": "left"
        },
        {
          "field": "org_emp_name",
          "width": 150
        },
        {
          "field": "org_emp_dept_id",
          "width": 150
        },
        {
          "field": "org_emp_position_id",
          "width": 150
        },
        {
          "field": "org_emp_report_to",
          "width": 150
        },
        {
          "field": "org_emp_phone",
          "width": 130
        },
        {
          "field": "org_emp_email",
          "width": 180
        },
        {
          "field": "org_emp_hire_date",
          "width": 120
        },
        {
          "field": "org_emp_status",
          "width": 100,
          "renderType": "tag",
          "dictCode": "org_emp_status"
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "buttons": [
            {
              "code": "edit",
              "icon": "Edit",
              "label": {
                "zh-CN": "编辑",
                "en": "Edit"
              },
              "action": {
                "type": "navigate",
                "to": "org_employee_form"
              },
              "permissionCode": "org.hr.manage"
            },
            {
              "code": "open_account",
              "icon": "KeyRound",
              "label": {
                "zh-CN": "开通账号",
                "en": "Open Account"
              },
              "confirm": {
                "zh-CN": "确认为该人员开通登录账号？如需新建用户，将生成一次性临时密码。",
                "en-US": "Open a login account for this employee? A one-time temporary password will be generated when a new user is created."
              },
              "action": {
                "type": "command",
                "command": "org:open_employee_account"
              },
              "permissionCode": "org.hr.manage"
            },
            {
              "code": "delete",
              "icon": "Trash2",
              "danger": true,
              "label": {
                "zh-CN": "删除",
                "en": "Delete"
              },
              "confirm": "delete.confirm",
              "action": {
                "type": "command"
              },
              "permissionCode": "org.hr.manage"
            }
          ],
          "label": {
            "zh-CN": "操作",
            "en": "Actions"
          }
        }
      ],
      "empty": {
        "title": {
          "zh-CN": "没有符合条件的人员",
          "en": "No matching employees"
        },
        "description": {
          "zh-CN": "请清空或调整筛选条件；如需新增人员，请联系人事管理员。",
          "en": "Clear or adjust the filters. Contact an HR administrator to create an employee."
        }
      }
    }
  ],
  "title": {
    "zh-CN": "人员管理",
    "en": "Employee Management"
  }
}
