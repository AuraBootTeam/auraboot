{
  "pageKey": "ab_team_detail",
  "name:zh-CN": "团队详情",
  "name:en": "Team Detail",
  "modelCode": "ab_team",
  "description": "DSL-driven team detail page backed by ab_team",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "team_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "back",
          "label": {
            "zh-CN": "返回",
            "en": "Back"
          },
          "action": {
            "type": "navigate",
            "to": "/organization/teams"
          }
        },
        {
          "code": "edit",
          "variant": "primary",
          "label": {
            "zh-CN": "编辑",
            "en": "Edit"
          },
          "action": {
            "type": "navigate",
            "to": "/organization/teams/{pid}/edit"
          },
          "permissionCode": "org.team.manage"
        }
      ]
    },
    {
      "id": "team_basic",
      "blockType": "form-section",
      "title": {
        "zh-CN": "团队信息",
        "en": "Team Information"
      },
      "readOnly": true,
      "fields": [
        {
          "field": "name",
          "colSpan": 6,
          "label": {
            "zh-CN": "名称",
            "en-US": "Name"
          }
        },
        {
          "field": "code",
          "colSpan": 6,
          "label": {
            "zh-CN": "编码",
            "en-US": "Code"
          }
        },
        {
          "field": "status",
          "dictCode": "org_team_status",
          "colSpan": 6,
          "label": {
            "zh-CN": "状态",
            "en-US": "Status"
          }
        },
        {
          "field": "description",
          "colSpan": 12,
          "label": {
            "zh-CN": "说明",
            "en-US": "Description"
          }
        },
        {
          "field": "created_at",
          "colSpan": 6,
          "label": {
            "zh-CN": "创建时间",
            "en-US": "Created at"
          }
        },
        {
          "field": "updated_at",
          "colSpan": 6,
          "label": {
            "zh-CN": "更新时间",
            "en-US": "Updated at"
          }
        }
      ]
    },
    {
      "id": "team_members",
      "blockType": "custom",
      "component": "TeamMembersBlock",
      "props": {
        "teamPidField": "pid",
        "title": {
          "zh-CN": "团队成员",
          "en-US": "Team members"
        }
      }
    }
  ],
  "title": {
    "zh-CN": "团队详情",
    "en": "Team Detail"
  }
}
