[
  {
    "decisionCode": "tpm_acceptance_route",
    "decisionName": "交付验收 · 审批分级",
    "scopeType": "BPM",
    "ownerModule": "tpm",
    "enabled": true,
    "kind": "DECISION_TABLE",
    "runtimeAdapter": "PLATFORM_DECISION_TABLE",
    "contentJson": {
      "hitPolicy": "FIRST",
      "inputs": [
        {
          "id": "amount",
          "label": "交付金额",
          "expr": {
            "type": "path",
            "scope": "record",
            "path": "data.tpm_ac_amount",
            "dataType": "decimal"
          }
        },
        {
          "id": "risk",
          "label": "风险等级",
          "expr": {
            "type": "path",
            "scope": "record",
            "path": "data.tpm_ac_risk",
            "dataType": "enum"
          }
        },
        {
          "id": "issues",
          "label": "未解决问题数",
          "expr": {
            "type": "path",
            "scope": "record",
            "path": "data.tpm_ac_open_issues",
            "dataType": "integer"
          }
        },
        {
          "id": "materials",
          "label": "材料内容已齐全",
          "expr": {
            "type": "path",
            "scope": "record",
            "path": "data.tpm_ac_materials_complete",
            "dataType": "boolean"
          }
        }
      ],
      "outputs": [
        {
          "id": "route",
          "label": "审批路径",
          "dataType": "string"
        }
      ],
      "rules": [
        {
          "ruleId": "high-risk",
          "priority": 10,
          "when": {
            "risk": {
              "operator": "EQ",
              "value": "high"
            }
          },
          "then": {
            "route": "enhanced"
          }
        },
        {
          "ruleId": "incomplete-evidence",
          "priority": 15,
          "when": {
            "materials": {
              "operator": "EQ",
              "value": false
            }
          },
          "then": {
            "route": "enhanced"
          }
        },
        {
          "ruleId": "large-amount",
          "priority": 20,
          "when": {
            "amount": {
              "operator": "GTE",
              "value": 100000
            },
            "issues": {
              "operator": "GT",
              "value": 0
            }
          },
          "then": {
            "route": "enhanced"
          }
        },
        {
          "ruleId": "standard",
          "priority": 30,
          "when": {
            "amount": {
              "operator": "GTE",
              "value": 0
            },
            "risk": {
              "operator": "EQ",
              "value": "normal"
            }
          },
          "then": {
            "route": "standard"
          }
        }
      ]
    },
    "publish": true
  },
  {
    "decisionCode": "tpm_acceptance_deadline",
    "decisionName": "交付验收 · 处理时限",
    "scopeType": "SLA",
    "ownerModule": "tpm",
    "enabled": true,
    "kind": "DECISION_TABLE",
    "runtimeAdapter": "PLATFORM_DECISION_TABLE",
    "contentJson": {
      "hitPolicy": "FIRST",
      "inputs": [
        {
          "id": "node",
          "label": "审批节点",
          "expr": {
            "type": "path",
            "scope": "record",
            "path": "data.targetKey",
            "dataType": "string"
          }
        }
      ],
      "outputs": [
        {
          "id": "deadlineMinutes",
          "label": "截止分钟",
          "dataType": "integer"
        }
      ],
      "rules": [
        {
          "ruleId": "enhanced",
          "priority": 10,
          "when": {
            "node": {
              "operator": "EQ",
              "value": "tpm_enhanced_review"
            }
          },
          "then": {
            "deadlineMinutes": 120
          }
        },
        {
          "ruleId": "standard",
          "priority": 20,
          "when": {
            "node": {
              "operator": "EQ",
              "value": "tpm_standard_review"
            }
          },
          "then": {
            "deadlineMinutes": 480
          }
        }
      ]
    },
    "publish": true
  }
]
