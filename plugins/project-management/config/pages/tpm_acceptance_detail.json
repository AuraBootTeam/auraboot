{
  "pageKey": "tpm_acceptance_detail",
  "name:zh-CN": "验收详情",
  "name:en": "Acceptance detail",
  "modelCode": "tpm_acceptance",
  "kind": "detail",
  "schemaVersion": 4,
  "title": {
    "zh-CN": "交付验收",
    "en": "Delivery acceptance"
  },
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "actions",
      "blockType": "toolbar",
      "area": "header",
      "buttons": [
        {
          "code": "edit",
          "action": "edit",
          "permissionCode": "tpm.acceptance.manage",
          "label": {
            "zh-CN": "编辑补正",
            "en": "Edit draft"
          },
          "visibleWhen": "form.tpm_ac_status === 'draft' || form.tpm_ac_status === 'returned'"
        },
        {
          "code": "submit_acceptance",
          "commandCode": "tpm:submit_delivery_acceptance",
          "permissionCode": "tpm.acceptance.manage",
          "primary": true,
          "label": {
            "zh-CN": "提交验收",
            "en": "Submit acceptance"
          },
          "visibleWhen": "form.tpm_ac_status === 'draft' || form.tpm_ac_status === 'returned'"
        }
      ]
    },
    {
      "id": "approval",
      "blockType": "workflow-panel",
      "title": {
        "zh-CN": "当前审批",
        "en": "Current approval"
      },
      "bpmPanel": {
        "processKey": "tpm_delivery_acceptance",
        "sections": [
          "status",
          "operations"
        ],
        "businessView": true,
        "showTechnicalDetails": false
      },
      "area": "main",
      "permissionCode": "bpm.process.read",
      "detailPlacement": "header"
    },
    {
      "id": "acceptance-tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "overview",
          "label": {
            "zh-CN": "验收详情",
            "en": "Acceptance details"
          },
          "blocks": [
            {
              "id": "identity",
              "blockType": "detail-section",
              "title": {
                "zh-CN": "验收范围",
                "en": "Acceptance scope"
              },
              "fields": [
                {
                  "field": "tpm_ac_scope",
                  "colSpan": 12,
                  "props": {
                    "placeholder": {
                      "zh-CN": "列出本次交付内容和可验证的完成标准",
                      "en": "Describe deliverables and verifiable completion criteria"
                    }
                  }
                },
                {
                  "field": "tpm_ac_risk",
                  "colSpan": 6
                }
              ],
              "area": "main",
              "readOnly": true,
              "extension": {
                "displayVariant": "object"
              }
            },
            {
              "id": "materials",
              "blockType": "detail-section",
              "title": {
                "zh-CN": "交付材料",
                "en": "Delivery materials"
              },
              "fields": [
                {
                  "field": "tpm_ac_files",
                  "colSpan": 12,
                  "props": {
                    "helpText": {
                      "zh-CN": "草稿可暂不上传；提交验收前必须提供材料。",
                      "en": "Optional for drafts; required before submitting for approval."
                    }
                  }
                }
              ],
              "area": "main",
              "readOnly": true,
              "extension": {
                "displayVariant": "object"
              }
            },
            {
              "id": "outcome",
              "blockType": "detail-section",
              "title": {
                "zh-CN": "处理结果",
                "en": "Outcome"
              },
              "fields": [
                {
                  "field": "tpm_ac_result",
                  "colSpan": 12
                }
              ],
              "extension": {
                "displayVariant": "object"
              },
              "readOnly": true,
              "visibleWhen": "!!form.tpm_ac_result"
            }
          ]
        },
        {
          "key": "approvals",
          "label": {
            "zh-CN": "审批记录",
            "en": "Approval history"
          },
          "permissionCode": "bpm.process.read",
          "blocks": [
            {
              "id": "approval-history",
              "blockType": "workflow-panel",
              "permissionCode": "bpm.process.read",
              "bpmPanel": {
                "processKey": "tpm_delivery_acceptance",
                "sections": [
                  "approval-history"
                ],
                "businessView": true
              }
            }
          ]
        },
        {
          "key": "verification",
          "label": {
            "zh-CN": "核验结果",
            "en": "Verification results"
          },
          "permissionCode": "tdv.check.read",
          "blocks": [
            {
              "id": "verification",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "交付核验结果",
                "en": "Delivery verification results"
              },
              "permissionCode": "tdv.check.read",
              "subTable": {
                "childModel": "tdv_check",
                "parentField": "tdv_ck_acceptance",
                "readOnly": true,
                "columns": [
                  {
                    "field": "tdv_ck_name",
                    "label": {
                      "zh-CN": "核验名称",
                      "en": "Verification"
                    }
                  },
                  {
                    "field": "tdv_ck_status",
                    "label": {
                      "zh-CN": "状态",
                      "en": "Status"
                    },
                    "dictCode": "tdv_status",
                    "presentation": {
                      "kind": "badge"
                    }
                  },
                  {
                    "field": "tdv_ck_passed",
                    "label": {
                      "zh-CN": "通过项数",
                      "en": "Passed checks"
                    },
                    "dataType": "integer"
                  },
                  {
                    "field": "tdv_ck_checked_at",
                    "label": {
                      "zh-CN": "核验时间",
                      "en": "Verified at"
                    },
                    "dataType": "datetime"
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "execution",
          "label": {
            "zh-CN": "运行记录",
            "en": "Execution records"
          },
          "permissionCode": "system_management",
          "blocks": [
            {
              "id": "execution",
              "blockType": "workflow-panel",
              "permissionCode": "system_management",
              "bpmPanel": {
                "processKey": "tpm_delivery_acceptance",
                "sections": [
                  "status",
                  "rule-trace"
                ],
                "businessView": true
              }
            }
          ]
        }
      ]
    }
  ],
  "extension": {
    "presentation": "workspace",
    "workspaceLabel": {
      "zh-CN": "项目交付",
      "en": "Project delivery"
    },
    "headerTitleField": "tpm_ac_name",
    "headerSubtitleFields": [
      "tpm_ac_code",
      "tpm_ac_project"
    ],
    "headerStatusField": "tpm_ac_status",
    "showShare": false,
    "showReport": false,
    "showPrint": false,
    "showPdfExport": false,
    "detailAsideBlockIds": [
      "materials"
    ],
    "objectSummary": [
      {
        "field": "tpm_ac_project_display",
        "label": {
          "zh-CN": "所属项目",
          "en": "Project"
        },
        "presentation": {
          "kind": "object"
        }
      },
      {
        "field": "tpm_ac_reviewer",
        "label": {
          "zh-CN": "验收审批人",
          "en": "Reviewer"
        },
        "presentation": {
          "kind": "member"
        }
      },
      {
        "field": "tpm_ac_amount",
        "label": {
          "zh-CN": "交付金额",
          "en": "Amount"
        },
        "presentation": {
          "kind": "currency",
          "currencyCode": "CNY"
        }
      },
      {
        "field": "tpm_ac_code",
        "label": {
          "zh-CN": "验收编号",
          "en": "Reference"
        },
        "presentation": {
          "kind": "object"
        }
      }
    ]
  }
}
