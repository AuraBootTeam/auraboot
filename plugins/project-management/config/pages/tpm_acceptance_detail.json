{
  "pageKey": "tpm_acceptance_detail",
  "name:zh-CN": "验收详情",
  "name:en": "Acceptance detail",
  "modelCode": "tpm_acceptance",
  "kind": "detail",
  "schemaVersion": 4,
  "title": {
    "zh-CN": "交付验收",
    "en": "Delivery acceptance"
  },
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "actions",
      "blockType": "toolbar",
      "area": "header",
      "buttons": [
        {
          "code": "edit",
          "action": "edit",
          "permissionCode": "tpm.acceptance.manage",
          "label": {
            "zh-CN": "编辑补正",
            "en": "Edit draft"
          },
          "visibleWhen": "form.tpm_ac_status === 'draft' || form.tpm_ac_status === 'returned'"
        },
        {
          "code": "submit_acceptance",
          "commandCode": "tpm:submit_delivery_acceptance",
          "permissionCode": "tpm.acceptance.manage",
          "primary": true,
          "label": {
            "zh-CN": "提交验收",
            "en": "Submit acceptance"
          },
          "visibleWhen": "form.tpm_ac_status === 'draft' || form.tpm_ac_status === 'returned'"
        }
      ]
    },
    {
      "id": "approval",
      "blockType": "workflow-panel",
      "title": {
        "zh-CN": "审批进展与执行记录",
        "en": "Approval progress and execution history"
      },
      "bpmPanel": {
        "processKey": "tpm_delivery_acceptance",
        "sections": [
          "status",
          "operations",
          "history"
        ],
        "businessView": true
      },
      "area": "main",
      "permissionCode": "bpm.process.read"
    },
    {
      "id": "identity",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "验收范围",
        "en": "Acceptance scope"
      },
      "fields": [
        {
          "field": "tpm_ac_scope",
          "colSpan": 12,
          "props": {
            "placeholder": {
              "zh-CN": "列出本次交付内容和可验证的完成标准",
              "en": "Describe deliverables and verifiable completion criteria"
            }
          }
        },
        {
          "field": "tpm_ac_risk",
          "colSpan": 6
        }
      ],
      "area": "main",
      "readOnly": true,
      "extension": {
        "displayVariant": "object"
      }
    },
    {
      "id": "outcome",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "当前处理状态",
        "en": "Current outcome"
      },
      "fields": [
        {
          "field": "tpm_ac_status",
          "colSpan": 6
        },
        {
          "field": "tpm_ac_result",
          "colSpan": 12
        }
      ],
      "extension": {
        "displayVariant": "object"
      }
    },
    {
      "id": "materials",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "交付材料",
        "en": "Delivery materials"
      },
      "fields": [
        {
          "field": "tpm_ac_files",
          "colSpan": 12,
          "props": {
            "helpText": {
              "zh-CN": "草稿可暂不上传；提交验收前必须提供材料。",
              "en": "Optional for drafts; required before submitting for approval."
            }
          }
        }
      ],
      "area": "main",
      "readOnly": true,
      "extension": {
        "displayVariant": "object"
      }
    }
  ],
  "extension": {
    "presentation": "workspace",
    "workspaceLabel": {
      "zh-CN": "项目交付",
      "en": "Project delivery"
    },
    "headerTitleField": "tpm_ac_name",
    "headerSubtitleFields": [
      "tpm_ac_code",
      "tpm_ac_project"
    ],
    "headerStatusField": "tpm_ac_status",
    "showShare": false,
    "showReport": false,
    "showPrint": false,
    "showPdfExport": false,
    "detailAsideBlockIds": [
      "outcome",
      "materials"
    ],
    "objectSummary": [
      {
        "field": "tpm_ac_project_display",
        "label": {
          "zh-CN": "所属项目",
          "en": "Project"
        },
        "presentation": {
          "kind": "object"
        }
      },
      {
        "field": "tpm_ac_reviewer",
        "label": {
          "zh-CN": "验收审批人",
          "en": "Reviewer"
        },
        "presentation": {
          "kind": "member"
        }
      },
      {
        "field": "tpm_ac_amount",
        "label": {
          "zh-CN": "交付金额",
          "en": "Amount"
        },
        "presentation": {
          "kind": "currency",
          "currencyCode": "CNY"
        }
      },
      {
        "field": "tpm_ac_code",
        "label": {
          "zh-CN": "验收编号",
          "en": "Reference"
        },
        "presentation": {
          "kind": "object"
        }
      }
    ]
  }
}
