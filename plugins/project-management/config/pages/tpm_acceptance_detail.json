{
  "pageKey": "tpm_acceptance_detail",
  "name:zh-CN": "验收详情",
  "name:en": "Acceptance detail",
  "modelCode": "tpm_acceptance",
  "kind": "detail",
  "schemaVersion": 4,
  "title": {
    "zh-CN": "交付验收",
    "en": "Delivery acceptance"
  },
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "actions",
      "blockType": "toolbar",
      "area": "header",
      "buttons": [
        {
          "code": "edit",
          "action": "edit",
          "permissionCode": "tpm.acceptance.manage",
          "label": {
            "zh-CN": "编辑补正",
            "en": "Edit draft"
          },
          "visibleWhen": "form.tpm_ac_status === 'draft' || form.tpm_ac_status === 'returned'"
        },
        {
          "code": "submit_acceptance",
          "commandCode": "tpm:submit_delivery_acceptance",
          "permissionCode": "tpm.acceptance.manage",
          "primary": true,
          "label": {
            "zh-CN": "提交验收",
            "en": "Submit acceptance"
          },
          "visibleWhen": "form.tpm_ac_status === 'draft' || form.tpm_ac_status === 'returned'"
        }
      ]
    },
    {
      "id": "outcome",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "当前处理状态",
        "en": "Current outcome"
      },
      "fields": [
        {
          "field": "tpm_ac_code",
          "colSpan": 6
        },
        {
          "field": "tpm_ac_status",
          "colSpan": 6
        },
        {
          "field": "tpm_ac_result",
          "colSpan": 12
        }
      ]
    },
    {
      "id": "identity",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "验收范围",
        "en": "Acceptance scope"
      },
      "fields": [
        {
          "field": "tpm_ac_name",
          "colSpan": 12,
          "required": true,
          "props": {
            "placeholder": {
              "zh-CN": "例如：会员门户 · 第一阶段验收",
              "en": "e.g. Member portal · Phase one acceptance"
            }
          }
        },
        {
          "field": "tpm_ac_project",
          "colSpan": 6,
          "required": true,
          "props": {
            "placeholder": {
              "zh-CN": "选择本次验收所属项目",
              "en": "Select the delivery project"
            }
          }
        },
        {
          "field": "tpm_ac_scope",
          "colSpan": 12,
          "props": {
            "placeholder": {
              "zh-CN": "列出本次交付内容和可验证的完成标准",
              "en": "Describe deliverables and verifiable completion criteria"
            }
          }
        }
      ],
      "area": "main",
      "readOnly": true
    },
    {
      "id": "risk",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "风险与审批",
        "en": "Risk and approval"
      },
      "fields": [
        {
          "field": "tpm_ac_amount",
          "colSpan": 6,
          "required": true,
          "props": {
            "placeholder": {
              "zh-CN": "例如：68000",
              "en": "e.g. 68000"
            }
          }
        },
        {
          "field": "tpm_ac_risk",
          "colSpan": 6,
          "required": true,
          "props": {
            "helpText": {
              "zh-CN": "高风险或金额达到10万元进入加强审批；普通8小时，加强2小时。",
              "en": "High risk or at least CNY 100,000 requires enhanced review: 2 hours; standard review: 8 hours."
            }
          }
        },
        {
          "field": "tpm_ac_reviewer",
          "colSpan": 12,
          "required": true,
          "props": {
            "placeholder": {
              "zh-CN": "选择具有审批权限的空间成员",
              "en": "Select a space member with workflow permission"
            },
            "helpText": {
              "zh-CN": "审批任务仅分配给所选成员；提交人不能代替他人审批。",
              "en": "Only the selected member receives this review task."
            }
          }
        }
      ],
      "area": "main",
      "readOnly": true
    },
    {
      "id": "materials",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "交付材料",
        "en": "Delivery materials"
      },
      "fields": [
        {
          "field": "tpm_ac_files",
          "colSpan": 12,
          "props": {
            "helpText": {
              "zh-CN": "草稿可暂不上传；提交验收前必须提供材料。",
              "en": "Optional for drafts; required before submitting for approval."
            }
          }
        }
      ],
      "area": "main",
      "readOnly": true
    },
    {
      "id": "approval",
      "blockType": "workflow-panel",
      "title": {
        "zh-CN": "审批进展与执行记录",
        "en": "Approval progress and execution history"
      },
      "bpmPanel": {
        "processKey": "tpm_delivery_acceptance",
        "sections": [
          "status",
          "operations",
          "history"
        ]
      },
      "area": "main",
      "permissionCode": "bpm.process.read"
    }
  ]
}
