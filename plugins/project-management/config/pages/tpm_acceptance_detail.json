{
  "pageKey": "tpm_acceptance_detail",
  "name:zh-CN": "验收详情",
  "name:en": "Acceptance detail",
  "modelCode": "tpm_acceptance",
  "kind": "detail",
  "schemaVersion": 4,
  "title": {
    "zh-CN": "交付验收",
    "en": "Delivery acceptance"
  },
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "actions",
      "blockType": "toolbar",
      "area": "header",
      "buttons": [
        {
          "code": "edit",
          "action": "edit",
          "permissionCode": "tpm.acceptance.manage",
          "label": {
            "zh-CN": "编辑补正",
            "en": "Edit draft"
          },
          "visibleWhen": "form.tpm_ac_status === 'draft' || form.tpm_ac_status === 'returned'"
        },
        {
          "code": "submit_acceptance",
          "commandCode": "tpm:submit_delivery_acceptance",
          "permissionCode": "tpm.acceptance.manage",
          "primary": true,
          "label": {
            "zh-CN": "提交验收",
            "en": "Submit acceptance"
          },
          "visibleWhen": "form.tpm_ac_status === 'draft' || form.tpm_ac_status === 'returned'"
        }
      ]
    },
    {
      "id": "approval",
      "blockType": "workflow-panel",
      "title": {
        "zh-CN": "当前审批",
        "en": "Current approval"
      },
      "bpmPanel": {
        "processKey": "tpm_delivery_acceptance",
        "sections": [
          "status",
          "operations"
        ],
        "businessView": true,
        "showTechnicalDetails": false
      },
      "area": "main",
      "permissionCode": "bpm.process.read",
      "detailPlacement": "header",
      "visibleWhen": "form.tpm_ac_status === 'submitted'"
    },
    {
      "id": "acceptance-sla",
      "blockType": "workflow-panel",
      "bpmPanel": {
        "processKey": "tpm_delivery_acceptance",
        "sections": [
          "sla"
        ],
        "businessView": true,
        "showTechnicalDetails": false
      },
      "area": "main",
      "permissionCode": "bpm.process.read",
      "detailPlacement": "header",
      "visibleWhen": "form.tpm_ac_status !== 'draft'"
    },
    {
      "id": "acceptance-tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "overview",
          "label": {
            "zh-CN": "验收详情",
            "en": "Acceptance details"
          },
          "blocks": [
            {
              "id": "bound-form",
              "blockType": "workflow-panel",
              "bpmPanel": {
                "processKey": "tpm_delivery_acceptance",
                "sections": [
                  "form"
                ],
                "formBinding": {
                  "formRef": "tpm_acceptance_form",
                  "excludeFields": [
                    "tpm_ac_name",
                    "tpm_ac_project",
                    "tpm_ac_amount",
                    "tpm_ac_reviewer"
                  ],
                  "asideBlockIds": [
                    "materials"
                  ],
                  "currentWhen": {
                    "field": "tpm_ac_status",
                    "values": [
                      "draft",
                      "returned"
                    ]
                  }
                },
                "businessView": true
              }
            },
            {
              "id": "outcome",
              "blockType": "detail-section",
              "title": {
                "zh-CN": "处理结果",
                "en": "Outcome"
              },
              "fields": [
                {
                  "field": "tpm_ac_result",
                  "colSpan": 12
                }
              ],
              "extension": {
                "displayVariant": "object"
              },
              "readOnly": true,
              "visibleWhen": "!!form.tpm_ac_result"
            }
          ]
        },
        {
          "key": "approvals",
          "label": {
            "zh-CN": "审批记录",
            "en": "Approval history"
          },
          "permissionCode": "bpm.process.read",
          "blocks": [
            {
              "id": "approval-history",
              "blockType": "workflow-panel",
              "permissionCode": "bpm.process.read",
              "bpmPanel": {
                "processKey": "tpm_delivery_acceptance",
                "sections": [
                  "approval-history"
                ],
                "businessView": true
              }
            }
          ]
        },
        {
          "key": "verification",
          "label": {
            "zh-CN": "核验结果",
            "en": "Verification results"
          },
          "permissionCode": "tdv.check.read",
          "blocks": [
            {
              "id": "verification",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "核验记录与当前有效性",
                "en": "Verification history and current validity"
              },
              "permissionCode": "tdv.check.read",
              "subTable": {
                "childModel": "tdv_check",
                "parentField": "tdv_ck_acceptance",
                "readOnly": true,
                "columns": [
                  {
                    "field": "tdv_ck_name",
                    "label": {
                      "zh-CN": "核验名称",
                      "en": "Verification"
                    }
                  },
                  {
                    "field": "tdv_ck_status",
                    "label": {
                      "zh-CN": "当前有效性",
                      "en": "Current validity"
                    },
                    "dictCode": "tdv_status",
                    "presentation": {
                      "kind": "badge"
                    }
                  },
                  {
                    "field": "tdv_ck_passed",
                    "label": {
                      "zh-CN": "快照通过项数",
                      "en": "Passed checks at inspection"
                    },
                    "dataType": "integer"
                  },
                  {
                    "field": "tdv_ck_checked_at",
                    "label": {
                      "zh-CN": "核验时间",
                      "en": "Verified at"
                    },
                    "dataType": "datetime"
                  }
                ],
                "emptyState": {
                  "title": {
                    "zh-CN": "暂未核验",
                    "en": "No verification yet"
                  },
                  "description": {
                    "zh-CN": "执行交付核验后，这里将显示本验收单的核验结论与通过项数。",
                    "en": "Verification results and passed checks for this acceptance will appear here after verification."
                  }
                },
                "dataSource": {
                  "kind": "namedQuery",
                  "queryCode": "tdv_acceptance_verifications",
                  "params": {
                    "acceptancePid": "${recordPid}"
                  }
                }
              }
            }
          ]
        },
        {
          "key": "execution",
          "label": {
            "zh-CN": "运行记录",
            "en": "Execution records"
          },
          "permissionCode": "system_management",
          "blocks": [
            {
              "id": "execution",
              "blockType": "workflow-panel",
              "permissionCode": "system_management",
              "bpmPanel": {
                "processKey": "tpm_delivery_acceptance",
                "sections": [
                  "status",
                  "rule-trace",
                  "audit-report"
                ],
                "businessView": true
              }
            },
            {
              "id": "field-history",
              "blockType": "field-history",
              "title": {
                "zh-CN": "字段变更",
                "en": "Field changes"
              },
              "permissionCode": "audit.field_audit.read"
            }
          ]
        }
      ]
    }
  ],
  "extension": {
    "presentation": "workspace",
    "workspaceLabel": {
      "zh-CN": "项目交付",
      "en": "Project delivery"
    },
    "headerTitleField": "tpm_ac_name",
    "headerSubtitleFields": [
      "tpm_ac_code",
      "tpm_ac_project"
    ],
    "headerStatusField": "tpm_ac_status",
    "showShare": false,
    "showReport": false,
    "showPrint": false,
    "showPdfExport": false,
    "detailAsideBlockIds": [
      "materials"
    ],
    "objectSummary": [
      {
        "field": "tpm_ac_project_display",
        "label": {
          "zh-CN": "所属项目",
          "en": "Project"
        },
        "presentation": {
          "kind": "object"
        }
      },
      {
        "field": "tpm_ac_reviewer",
        "label": {
          "zh-CN": "验收审批人",
          "en": "Reviewer"
        },
        "presentation": {
          "kind": "member"
        }
      },
      {
        "field": "tpm_ac_amount",
        "label": {
          "zh-CN": "交付金额",
          "en": "Amount"
        },
        "presentation": {
          "kind": "currency",
          "currencyCode": "CNY"
        }
      },
      {
        "field": "tpm_ac_code",
        "label": {
          "zh-CN": "验收编号",
          "en": "Reference"
        },
        "presentation": {
          "kind": "object"
        }
      }
    ],
    "showInlineApprovalPanel": false,
    "hiddenSystemTabs": [
      "__field_history__"
    ]
  }
}
