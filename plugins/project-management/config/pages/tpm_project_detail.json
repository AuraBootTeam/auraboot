{
  "pageKey": "tpm_project_detail",
  "name:zh-CN": "项目详情",
  "name:en": "Project Detail",
  "modelCode": "tpm_project",
  "kind": "detail",
  "schemaVersion": 4,
  "title": {
    "zh-CN": "项目详情",
    "en": "Project Detail"
  },
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "action_bar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "edit",
          "action": "edit",
          "permissionCode": "tpm.project.manage",
          "label": {
            "zh-CN": "编辑",
            "en": "Edit"
          },
          "visibleWhen": "true"
        },
        {
          "code": "activate_project",
          "commandCode": "tpm:activate_project",
          "permissionCode": "tpm.project.manage",
          "label": {
            "zh-CN": "启动项目",
            "en": "Activate Project"
          },
          "visibleWhen": "form.tpm_pj_status === 'planning' || form.tpm_pj_status === 'on_hold'"
        },
        {
          "code": "hold_project",
          "commandCode": "tpm:hold_project",
          "permissionCode": "tpm.project.manage",
          "label": {
            "zh-CN": "暂停项目",
            "en": "Put On Hold"
          },
          "visibleWhen": "form.tpm_pj_status === 'active'"
        }
      ],
      "area": "header"
    },
    {
      "id": "progress",
      "blockType": "metric-strip",
      "dataSource": "deliveryProgress",
      "detailPlacement": "header",
      "variant": "cards",
      "metrics": [
        {
          "key": "progress",
          "label": {
            "zh-CN": "里程碑完成率",
            "en": "Milestone completion"
          },
          "valueField": "progress",
          "unit": "%",
          "tone": "blue",
          "subText": {
            "zh-CN": "按已达成里程碑计算",
            "en": "Based on reached milestones"
          }
        },
        {
          "key": "reached",
          "label": {
            "zh-CN": "已达成",
            "en": "Reached"
          },
          "valueField": "reached",
          "tone": "green"
        },
        {
          "key": "pending",
          "label": {
            "zh-CN": "待交付",
            "en": "Pending"
          },
          "valueField": "pending",
          "tone": "amber"
        }
      ],
      "columns": 3,
      "density": "compact"
    },
    {
      "id": "overview",
      "blockType": "detail-section",
      "readOnly": true,
      "title": {
        "zh-CN": "交付约定",
        "en": "Delivery agreement"
      },
      "fields": [
        {
          "field": "tpm_pj_status",
          "colSpan": 6
        },
        {
          "field": "tpm_pj_customer",
          "colSpan": 6
        },
        {
          "field": "tpm_pj_owner_user",
          "colSpan": 6
        },
        {
          "field": "tpm_pj_end_date",
          "colSpan": 6
        },
        {
          "field": "tpm_pj_budget",
          "colSpan": 6
        },
        {
          "field": "tpm_pj_description",
          "colSpan": 12
        }
      ]
    },
    {
      "id": "milestones",
      "blockType": "sub-table",
      "title": {
        "zh-CN": "交付里程碑",
        "en": "Delivery milestones"
      },
      "subTable": {
        "childModel": "tpm_milestone",
        "parentField": "tpm_ms_project_id",
        "readOnly": true,
        "columns": [
          {
            "field": "tpm_ms_name",
            "label": {
              "zh-CN": "交付内容",
              "en": "Deliverable"
            },
            "width": 200
          },
          {
            "field": "tpm_ms_target_date",
            "label": {
              "zh-CN": "计划日期",
              "en": "Target date"
            },
            "width": 115,
            "dataType": "date"
          },
          {
            "field": "tpm_ms_status",
            "label": {
              "zh-CN": "状态",
              "en": "Status"
            },
            "width": 85,
            "dictCode": "tpm_milestone_status",
            "renderType": "tag"
          },
          {
            "field": "tpm_ms_description",
            "label": {
              "zh-CN": "验收要点",
              "en": "Acceptance criteria"
            },
            "width": 250
          }
        ],
        "actions": [
          {
            "code": "reach",
            "label": {
              "zh-CN": "完成里程碑",
              "en": "Complete milestone"
            },
            "commandCode": "tpm:reach_milestone",
            "permissionCode": "tpm.milestone.manage",
            "visibleWhen": "row.tpm_ms_status === 'pending'",
            "confirm": {
              "zh-CN": "确认本项交付已达到约定的验收要求？完成后将更新项目交付进度。",
              "en": "Confirm the deliverable meets its acceptance criteria? Progress will update."
            }
          }
        ],
        "defaultSort": {
          "field": "tpm_ms_target_date",
          "order": "asc"
        }
      }
    },
    {
      "id": "activity",
      "blockType": "activity-timeline",
      "title": {
        "zh-CN": "最近动态",
        "en": "Recent activity"
      },
      "businessDataSource": {
        "queryCode": "tpm_delivery_activity",
        "params": {
          "projectPid": "${recordPid}"
        },
        "method": "get"
      },
      "businessRecordMapping": {
        "pid": "pid",
        "occurredAt": "occurred_at",
        "activityType": "activity_type",
        "subject": "subject",
        "content": "content",
        "actorName": "actor_name"
      },
      "extension": {
        "density": "compact"
      }
    }
  ],
  "extension": {
    "showShare": false,
    "showReport": false,
    "showPrint": false,
    "headerTitleField": "tpm_pj_name",
    "headerSubtitleFields": [
      "tpm_pj_customer",
      "tpm_pj_code"
    ],
    "detailAsideBlockIds": [
      "activity"
    ],
    "showPdfExport": false,
    "presentation": "workspace",
    "workspaceLabel": {
      "zh-CN": "项目协作",
      "en": "Project collaboration"
    }
  },
  "dataSources": {
    "deliveryProgress": {
      "type": "namedQuery",
      "queryCode": "tpm_delivery_progress",
      "params": {
        "projectPid": "${form.pid}"
      },
      "adaptor": "table",
      "format": "records",
      "dependOn": [
        "form.pid"
      ]
    }
  }
}
