{
  "pageKey": "tpm_project_list",
  "name:zh-CN": "项目列表",
  "name:en": "Projects",
  "modelCode": "tpm_project",
  "kind": "list",
  "schemaVersion": 4,
  "title": {
    "zh-CN": "项目交付",
    "en": "Project delivery"
  },
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "tpm_pj_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "action": "create",
          "primary": true,
          "permissionCode": "tpm.project.manage",
          "label": {
            "zh-CN": "新建项目",
            "en": "New project"
          }
        }
      ],
      "area": "toolbar"
    },
    {
      "id": "tpm_pj_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "all",
          "label": {
            "en": "All",
            "zh-CN": "全部"
          },
          "filter": null
        },
        {
          "key": "planning",
          "label": {
            "en": "Planning",
            "zh-CN": "规划中"
          },
          "filter": {
            "field": "tpm_pj_status",
            "value": "planning",
            "operator": "EQ"
          }
        },
        {
          "key": "active",
          "label": {
            "en": "Active",
            "zh-CN": "进行中"
          },
          "filter": {
            "field": "tpm_pj_status",
            "value": "active",
            "operator": "EQ"
          }
        },
        {
          "key": "completed",
          "label": {
            "en": "Completed",
            "zh-CN": "已完成"
          },
          "filter": {
            "field": "tpm_pj_status",
            "value": "completed",
            "operator": "EQ"
          }
        }
      ],
      "area": "list-tabs"
    },
    {
      "id": "tpm_pj_table",
      "blockType": "table",
      "columns": [
        {
          "field": "tpm_pj_name",
          "width": 290,
          "sortable": true
        },
        {
          "field": "tpm_pj_customer",
          "width": 180
        },
        {
          "field": "tpm_pj_status",
          "width": 110,
          "renderType": "tag",
          "dictCode": "tpm_project_status"
        },
        {
          "field": "tpm_pj_owner_user",
          "width": 130
        },
        {
          "field": "tpm_pj_end_date",
          "width": 145,
          "sortable": true
        },
        {
          "field": "tpm_pj_budget",
          "width": 140
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "buttons": [
            {
              "code": "view",
              "action": "detail",
              "navigateTo": "tpm_project_detail",
              "label": {
                "zh-CN": "查看",
                "en": "View"
              }
            },
            {
              "code": "edit",
              "action": "edit",
              "navigateTo": "tpm_project_form",
              "permissionCode": "tpm.project.manage",
              "label": {
                "zh-CN": "编辑",
                "en": "Edit"
              }
            }
          ],
          "label": {
            "zh-CN": "操作",
            "en": "Actions"
          }
        }
      ],
      "searchFields": [
        "tpm_pj_name",
        "tpm_pj_code",
        "tpm_pj_customer"
      ],
      "defaultSort": {
        "field": "created_at",
        "order": "desc"
      },
      "area": "main",
      "searchPlaceholder": {
        "zh-CN": "搜索项目或客户",
        "en": "Search projects or customers"
      },
      "empty": {
        "title": {
          "zh-CN": "还没有交付项目",
          "en": "No delivery projects yet"
        },
        "description": {
          "zh-CN": "新建项目，明确客户、交付目标和计划日期。",
          "en": "Create a project with a customer, outcome and target date."
        }
      }
    }
  ],
  "description": "Customer delivery projects with lifecycle, ownership and target dates."
}
