{
  "pageKey": "tpm_project_list",
  "name:zh-CN": "项目列表",
  "name:en": "Projects",
  "modelCode": "tpm_project",
  "kind": "list",
  "schemaVersion": 4,
  "title": {
    "zh-CN": "项目管理",
    "en": "Projects"
  },
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "tpm_pj_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "action": "create",
          "primary": true,
          "permissionCode": "tpm.project.manage",
          "label": {
            "zh-CN": "新建项目",
            "en": "New project"
          }
        }
      ],
      "area": "toolbar"
    },
    {
      "id": "tpm_pj_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "all",
          "label": {
            "zh-CN": "全部项目",
            "en": "All projects"
          },
          "filter": null
        },
        {
          "key": "mine",
          "label": {
            "zh-CN": "我负责的",
            "en": "Assigned to me"
          },
          "filter": {
            "field": "tpm_pj_owner_user",
            "operator": "EQ",
            "value": "$currentUser"
          }
        },
        {
          "key": "acceptance",
          "label": {
            "zh-CN": "待验收",
            "en": "Acceptance"
          },
          "filter": {
            "field": "tpm_pj_status",
            "operator": "EQ",
            "value": "acceptance"
          }
        },
        {
          "key": "completed",
          "label": {
            "zh-CN": "已交付",
            "en": "Delivered"
          },
          "filter": {
            "field": "tpm_pj_status",
            "operator": "EQ",
            "value": "completed"
          }
        }
      ],
      "area": "list-tabs",
      "showCounts": true
    },
    {
      "id": "tpm_pj_table",
      "blockType": "table",
      "columns": [
        {
          "field": "tpm_pj_name",
          "label": {
            "zh-CN": "项目名称 / 客户",
            "en": "Project / customer"
          },
          "width": 330,
          "presentation": {
            "kind": "object",
            "subtitleFields": [
              "tpm_pj_code",
              "tpm_pj_customer_id"
            ]
          }
        },
        {
          "field": "tpm_pj_status",
          "label": {
            "zh-CN": "阶段",
            "en": "Stage"
          },
          "width": 130,
          "dictCode": "tpm_project_status"
        },
        {
          "field": "tpm_pj_owner_user",
          "width": 120,
          "presentation": {
            "kind": "member"
          }
        },
        {
          "field": "tpm_pj_progress",
          "width": 125,
          "presentation": {
            "kind": "progress"
          }
        },
        {
          "field": "tpm_pj_end_date",
          "label": {
            "zh-CN": "计划交付",
            "en": "Target delivery"
          },
          "width": 130,
          "presentation": {
            "kind": "deadline",
            "completedField": "tpm_pj_status",
            "completedValues": [
              "completed"
            ]
          }
        },
        {
          "field": "tpm_pj_budget",
          "width": 150,
          "presentation": {
            "kind": "currency"
          }
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "buttons": [
            {
              "code": "view",
              "action": "detail",
              "navigateTo": "tpm_project_detail",
              "label": {
                "zh-CN": "查看",
                "en": "View"
              }
            },
            {
              "code": "edit",
              "action": "edit",
              "navigateTo": "tpm_project_form",
              "permissionCode": "tpm.project.manage",
              "label": {
                "zh-CN": "编辑",
                "en": "Edit"
              }
            }
          ],
          "label": {
            "zh-CN": "操作",
            "en": "Actions"
          }
        }
      ],
      "searchFields": [
        "tpm_pj_name",
        "tpm_pj_code",
        "tpm_pj_customer"
      ],
      "defaultSort": {
        "field": "tpm_pj_code",
        "order": "desc"
      },
      "area": "main",
      "searchPlaceholder": {
        "zh-CN": "搜索项目或客户",
        "en": "Search projects or customers"
      },
      "empty": {
        "title": {
          "zh-CN": "还没有交付项目",
          "en": "No delivery projects yet"
        },
        "description": {
          "zh-CN": "新建项目，明确客户、交付目标和计划日期。",
          "en": "Create a project with a customer, outcome and target date."
        }
      }
    }
  ],
  "description": "Customer delivery projects with lifecycle, ownership and target dates.",
  "extension": {
    "hideQuickFilters": true,
    "hideRowHeight": true,
    "presentation": "workspace",
    "workspaceLabel": {
      "zh-CN": "项目协作",
      "en": "Project collaboration"
    },
    "pageDescription": {
      "zh-CN": "跟进客户项目，从需求确认到交付验收。",
      "en": "Track customer projects from requirements to delivery."
    },
    "hideSavedViews": true,
    "hideViewAnalysis": true,
    "hideFilterChips": true,
    "rowHeight": "tall"
  }
}
