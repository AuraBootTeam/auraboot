                },
                "chartConfig": {
                  "table": {
                    "columns": [
                      {
                        "field": "eventName",
                        "label": {
                          "zh-CN": "事件",
                          "en": "Event"
                        },
                        "valueLabels": {
                          "analytics_requested": {
                            "zh-CN": "请求分析",
                            "en": "Analysis requested"
                          },
                          "analytics_query_succeeded": {
                            "zh-CN": "分析查询成功",
                            "en": "Analysis query succeeded"
                          },
                          "analytics_query_failed": {
