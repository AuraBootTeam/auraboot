                        }
                      },
                      {
                        "field": "retained",
                        "label": {
                          "zh-CN": "再次使用人数",
                          "en": "Returning users"
                        },
                        "nullLabel": {
                          "zh-CN": "尚未计算",
                          "en": "Not calculated"
                        }
                      },
                      {
                        "field": "retentionRate",
                        "label": {
                          "zh-CN": "留存率",
                          "en": "Retention"
                        },
                        "format": "percent",
                        "precision": 1,
                        "nullLabel": {
                          "zh-CN": "尚未计算",
                          "en": "Not calculated"
                        }
                      },
                      {
                        "field": "status",
                        "label": {
                          "zh-CN": "观察状态",
                          "en": "Observation status"
                        },
                        "valueLabels": {
                          "observed": {
                            "zh-CN": "已观测",
                            "en": "Observed"
                          },
                          "no_sample": {
                            "zh-CN": "无样本",
                            "en": "No sample"
                          },
                          "immature": {
                            "zh-CN": "观察中",
                            "en": "Observation pending"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "id": "artifact_retention",
                "blockType": "chart",
                "chartType": "table",
                "dataSource": "ds_artifact_retention",
                "title": {
                  "zh-CN": "看板再次使用",
                  "en": "Dashboard return use"
                },
                "chartConfig": {
                  "pageSize": 9,
                  "emptyMessage": {
                    "zh-CN": "当前范围内尚无首次使用记录。在 AuraBot 保存分析看板并打开查询后，可在这里观察再次使用情况。",
                    "en": "No first-use records in this range. Save an analysis dashboard in AuraBot and open it to query data, then track return use here."
                  },
                  "table": {
                    "columns": [
                      {
                        "field": "cohortDay",
                        "label": {
                          "zh-CN": "首次使用日（UTC）",
                          "en": "First-use day (UTC)"
                        }
                      },
                      {
                        "field": "dayOffset",
                        "label": {
                          "zh-CN": "观察日",
                          "en": "Observation day"
                        },
                        "valueLabels": {
                          "1": "D1",
                          "7": "D7",
