                        }
                      },
                      {
                        "field": "retained",
                        "label": {
                          "zh-CN": "再次使用看板数",
                          "en": "Returning dashboards"
                        },
                        "nullLabel": {
                          "zh-CN": "尚未计算",
                          "en": "Not calculated"
                        }
                      },
                      {
                        "field": "retentionRate",
                        "label": {
                          "zh-CN": "留存率",
                          "en": "Retention"
                        },
                        "format": "percent",
                        "precision": 1,
                        "nullLabel": {
                          "zh-CN": "尚未计算",
                          "en": "Not calculated"
                        }
                      },
                      {
                        "field": "status",
                        "label": {
                          "zh-CN": "观察状态",
                          "en": "Observation status"
                        },
                        "valueLabels": {
                          "observed": {
                            "zh-CN": "已观测",
                            "en": "Observed"
                          },
                          "no_sample": {
                            "zh-CN": "无样本",
                            "en": "No sample"
                          },
