[
  {
    "pageKey": "behavior_analytics",
    "name:zh-CN": "行为分析",
    "name:en": "Behavior Analytics",
    "description": "Behavior traffic, ordered analysis conversion, and first-use retention from observed events.",
    "kind": "detail",
    "schemaVersion": 4,
    "layout": {
      "type": "stack",
      "gap": 16
    },
    "extension": {
      "showShare": false,
      "showReport": false,
      "showPrint": false,
      "showEdit": false,
      "showPdfExport": false
    },
    "dataSources": {
      "ds_behavior_overview": {
        "type": "api",
        "endpoint": "/api/analytics/behavior/overview",
        "url": "/api/analytics/behavior/overview",
        "method": "get",
        "autoFetch": false
      },
      "ds_top_events": {
        "type": "api",
        "endpoint": "/api/analytics/behavior/top-events",
        "url": "/api/analytics/behavior/top-events",
        "method": "get",
        "autoFetch": false
      },
      "ds_funnel": {
        "type": "api",
        "url": "/api/analytics/behavior/analysis-funnel",
        "endpoint": "/api/analytics/behavior/analysis-funnel",
        "method": "get",
        "autoFetch": false
      },
      "ds_user_retention": {
        "type": "api",
        "url": "/api/analytics/behavior/retention",
        "endpoint": "/api/analytics/behavior/retention",
        "method": "get",
        "autoFetch": false,
        "params": {
          "unit": "user"
        }
      },
      "ds_artifact_retention": {
        "type": "api",
        "url": "/api/analytics/behavior/retention",
        "endpoint": "/api/analytics/behavior/retention",
        "method": "get",
        "autoFetch": false,
        "params": {
          "unit": "artifact"
        }
      }
    },
    "blocks": [
      {
        "id": "behavior_tabs",
        "blockType": "tabs",
        "tabs": [
          {
            "key": "analysis",
            "label": {
              "zh-CN": "使用与转化",
              "en": "Usage and conversion"
            },
            "layout": {
              "type": "grid",
              "cols": 12,
              "rowGap": 20
            },
            "blocks": [
              {
                "id": "behavior_scope",
                "blockType": "rich-text",
                "content": {
                  "zh-CN": "<h2>分析使用与转化</h2><p>默认查看最近 30 天。漏斗按发起人的分析任务有序计数；留存按首次成功使用分析看板的 UTC 自然日分组，观察第 1、7、30 天是否再次使用。</p><p>“观察中”表示该观察日尚未结束，不计为零留存。这里只反映已收到的事件，不能据此认定投递完整、用户理解结果或产生业务收益。</p>",
                  "en": "<h2>Analysis usage and conversion</h2><p>Defaults to the last 30 days. The funnel follows ordered tasks per initiator. Retention groups first successful analytics dashboard use by UTC calendar day and checks use on days 1, 7, and 30.</p><p>Pending observation days are not zero retention. Received events do not prove complete delivery, comprehension, or business outcomes.</p>"
                }
              },
              {
                "id": "kpi_pv",
                "blockType": "chart",
                "chartType": "number-card",
                "dataSource": "ds_behavior_overview",
                "title": {
                  "zh-CN": "页面浏览量 (PV)",
                  "en": "Page Views (PV)"
                },
                "chartConfig": {
                  "metricField": "pageViews"
                },
                "layout": {
                  "col": 0,
                  "colSpan": 3
                }
              },
              {
                "id": "kpi_uv",
                "blockType": "chart",
                "chartType": "number-card",
                "dataSource": "ds_behavior_overview",
                "title": {
                  "zh-CN": "独立访客 (UV)",
                  "en": "Unique Visitors (UV)"
                },
                "chartConfig": {
                  "metricField": "uniqueVisitors"
                },
                "layout": {
                  "col": 3,
                  "colSpan": 3
                }
              },
              {
                "id": "kpi_sessions",
                "blockType": "chart",
                "chartType": "number-card",
                "dataSource": "ds_behavior_overview",
                "title": {
                  "zh-CN": "会话数",
                  "en": "Sessions"
                },
                "chartConfig": {
                  "metricField": "sessions"
                },
                "layout": {
                  "col": 6,
                  "colSpan": 3
                }
              },
              {
                "id": "kpi_total",
                "blockType": "chart",
                "chartType": "number-card",
                "dataSource": "ds_behavior_overview",
                "title": {
                  "zh-CN": "事件总数",
                  "en": "Total Events"
                },
                "chartConfig": {
                  "metricField": "totalEvents"
                },
                "layout": {
                  "col": 9,
                  "colSpan": 3
                }
              },
              {
                "id": "analysis_funnel",
                "blockType": "chart",
                "chartType": "table",
                "dataSource": "ds_funnel",
                "title": {
                  "zh-CN": "分析任务转化",
                  "en": "Analysis task conversion"
                },
                "chartConfig": {
                  "sortable": false,
                  "showPagination": false,
                  "table": {
                    "columns": [
                      {
                        "field": "code",
                        "label": {
                          "zh-CN": "分析阶段",
                          "en": "Stage"
                        },
                        "valueLabels": {
                          "requested": {
                            "zh-CN": "请求分析",
                            "en": "Analysis requested"
                          },
                          "query_succeeded": {
                            "zh-CN": "查询成功",
                            "en": "Query succeeded"
                          },
                          "result_viewed": {
                            "zh-CN": "结果已呈现",
                            "en": "Result presented"
                          },
                          "dashboard_saved": {
                            "zh-CN": "保存看板",
                            "en": "Dashboard saved"
                          },
                          "dashboard_used": {
                            "zh-CN": "再次使用看板",
                            "en": "Dashboard used"
                          }
                        }
                      },
                      {
                        "field": "tasks",
                        "label": {
                          "zh-CN": "任务数",
                          "en": "Tasks"
                        }
                      },
                      {
                        "field": "firstStageDenominator",
                        "label": {
                          "zh-CN": "首步任务数",
                          "en": "First-stage tasks"
                        }
                      },
                      {
                        "field": "previousStageDenominator",
                        "label": {
                          "zh-CN": "上步任务数",
                          "en": "Previous-stage tasks"
                        }
                      },
                      {
                        "field": "overallRate",
                        "label": {
                          "zh-CN": "总体转化率",
                          "en": "Overall conversion"
                        },
                        "format": "percent",
                        "precision": 1,
                        "nullLabel": {
                          "zh-CN": "尚未计算",
                          "en": "Not calculated"
                        }
                      },
                      {
                        "field": "previousStageRate",
                        "label": {
                          "zh-CN": "上步转化率",
                          "en": "Previous-stage conversion"
                        },
                        "format": "percent",
                        "precision": 1,
                        "nullLabel": {
                          "zh-CN": "尚未计算",
                          "en": "Not calculated"
                        }
                      },
                      {
                        "field": "status",
                        "label": {
                          "zh-CN": "样本状态",
                          "en": "Sample status"
                        },
                        "valueLabels": {
                          "observed": {
                            "zh-CN": "已观测",
                            "en": "Observed"
                          },
                          "no_sample": {
                            "zh-CN": "无样本",
                            "en": "No sample"
                          },
                          "immature": {
                            "zh-CN": "观察中",
                            "en": "Observation pending"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "id": "user_retention",
                "blockType": "chart",
                "chartType": "table",
                "dataSource": "ds_user_retention",
                "title": {
                  "zh-CN": "用户再次使用",
                  "en": "User return use"
                },
                "chartConfig": {
                  "pageSize": 9,
                  "emptyMessage": {
                    "zh-CN": "当前范围内尚无首次使用记录。在 AuraBot 保存分析看板并打开查询后，可在这里观察再次使用情况。",
                    "en": "No first-use records in this range. Save an analysis dashboard in AuraBot and open it to query data, then track return use here."
                  },
                  "table": {
                    "columns": [
                      {
                        "field": "cohortDay",
                        "label": {
