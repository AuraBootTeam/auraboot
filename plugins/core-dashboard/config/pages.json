                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "id": "tbl_top_events",
                "blockType": "chart",
                "chartType": "table",
                "dataSource": "ds_top_events",
                "title": {
                  "zh-CN": "热门事件",
