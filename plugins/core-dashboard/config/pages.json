                            "zh-CN": "使用分析看板",
                            "en": "Analysis dashboard used"
                          },
                          "page_view": {
                            "zh-CN": "页面浏览",
                            "en": "Page view"
                          },
                          "element_click": {
                            "zh-CN": "界面点击",
                            "en": "Element click"
                          },
                          "page_leave": {
