[
  {
    "pageKey": "ab_announcement_list",
    "name:zh-CN": "系统公告",
    "name:en": "Announcements",
    "modelCode": "ab_announcement",
    "kind": "list",
    "schemaVersion": 4,
    "layout": {
      "type": "stack"
    },
    "blocks": [
      {
        "id": "toolbar",
        "blockType": "toolbar",
        "buttons": [
          {
            "code": "create",
            "variant": "primary",
            "label": {
              "zh-CN": "新建公告",
              "en-US": "Create Announcement"
            },
            "action": {
              "type": "navigate",
              "to": "ab_announcement_form",
              "command": "announcement:create_announcement"
            },
            "permissionCode": "announcement.announcement.edit"
          }
        ]
      },
      {
        "id": "filters",
        "blockType": "filters",
        "fields": [
          {
            "field": "title",
            "props": {
              "placeholder": {
                "zh-CN": "例如：周末系统维护",
                "en-US": "e.g. Scheduled weekend maintenance"
              }
            },
            "helpText": {
              "zh-CN": "按公告标题关键词查找；清除关键词可查看全部公告。",
              "en-US": "Search by announcement title keywords. Clear the keywords to show all announcements."
            }
          },
          {
            "field": "status"
          },
          {
            "field": "announcement_priority"
          }
        ]
      },
      {
        "id": "table",
        "blockType": "table",
        "empty": {
          "title": {
            "zh-CN": "没有匹配的公告",
            "en-US": "No matching announcements"
          },
          "description": {
            "zh-CN": "选择“新建公告”创建草稿，或清除筛选条件查看已有公告。",
            "en-US": "Choose Create Announcement to draft a notice, or clear the filters to view existing announcements."
          }
        },
        "columns": [
          {
            "field": "title",
            "width": 280,
            "sortable": true
          },
          {
            "field": "announcement_priority",
            "width": 100,
            "dictCode": "announcement_priority",
            "renderType": "tag"
          },
          {
            "field": "status",
            "width": 100,
            "dictCode": "announcement_status",
            "renderType": "tag"
          },
          {
            "field": "pinned",
            "width": 80
          },
          {
            "field": "published_at",
            "width": 160,
            "format": "YYYY-MM-DD HH:mm",
            "label": {
              "zh-CN": "上次发布时间",
              "en-US": "Last published at"
            }
          },
          {
            "field": "expires_at",
            "width": 160,
            "format": "YYYY-MM-DD HH:mm"
          }
        ],
        "rowActions": [
          {
            "code": "view",
            "label": {
              "zh-CN": "查看",
              "en-US": "View"
            },
            "action": {
              "type": "navigate",
              "to": "ab_announcement_detail"
            },
            "permissionCode": "announcement.announcement.read"
          },
          {
            "code": "notification_settings",
            "label": {
              "zh-CN": "通知设置",
              "en-US": "Notification settings"
            },
            "action": {
              "type": "command",
              "command": "announcement:update_announcement",
              "operationType": "UPDATE",
              "inputFields": [
                {
                  "field": "audience_kind",
                  "label": {
                    "zh-CN": "通知范围",
                    "en-US": "Audience kind"
                  },
                  "type": "select",
                  "group": {
                    "zh-CN": "通知对象",
                    "en-US": "Audience"
                  },
                  "defaultValue": "${record.audience_kind}",
                  "dataSource": {
                    "type": "api",
                    "endpoint": "/api/announcements/audience-options?kind=kind"
                  },
                  "required": true
                },
                {
                  "field": "audience_users",
                  "label": {
                    "zh-CN": "人员",
                    "en-US": "People"
                  },
                  "type": "multiselect",
                  "group": {
                    "zh-CN": "通知对象",
                    "en-US": "Audience"
                  },
                  "defaultValue": "${record.audience_users}",
                  "dataSource": {
                    "type": "api",
                    "endpoint": "/api/announcements/audience-options?kind=person"
                  },
                  "helpText": {
                    "zh-CN": "仅可选择当前发布管理范围内的有效成员。",
                    "en-US": "Choose active members within your current publication scope."
                  },
                  "visibleWhen": {
                    "field": "audience_kind",
                    "value": "selected"
                  }
                },
                {
                  "field": "audience_departments",
                  "label": {
                    "zh-CN": "部门及下级",
                    "en-US": "Departments and descendants"
                  },
                  "type": "multiselect",
                  "group": {
                    "zh-CN": "通知对象",
                    "en-US": "Audience"
                  },
                  "defaultValue": "${record.audience_departments}",
                  "dataSource": {
                    "type": "api",
                    "endpoint": "/api/announcements/audience-options?kind=department"
                  },
                  "helpText": {
                    "zh-CN": "包含下级；仅列出整个子树均已授权的部门。",
                    "en-US": "Includes descendants. Only fully authorized department subtrees are selectable."
                  },
                  "visibleWhen": {
                    "field": "audience_kind",
                    "value": "selected"
                  }
                },
                {
                  "field": "audience_roles",
                  "label": {
                    "zh-CN": "管理范围内角色成员",
                    "en-US": "Role members within management scope"
                  },
                  "type": "multiselect",
                  "group": {
                    "zh-CN": "通知对象",
                    "en-US": "Audience"
                  },
                  "defaultValue": "${record.audience_roles}",
                  "dataSource": {
                    "type": "api",
                    "endpoint": "/api/announcements/audience-options?kind=role"
                  },
                  "helpText": {
                    "zh-CN": "仅通知当前管理范围内的该角色成员，发布时重新解析。",
                    "en-US": "Only role members within your current management scope; resolved again at publication."
                  },
                  "visibleWhen": {
                    "field": "audience_kind",
                    "value": "selected"
                  }
                },
                {
                  "field": "approval_mode",
                  "label": {
                    "zh-CN": "发布方式",
                    "en-US": "Approval mode"
                  },
                  "type": "select",
                  "group": {
                    "zh-CN": "发布与审批",
                    "en-US": "Publication and approval"
                  },
                  "defaultValue": "${record.approval_mode}",
                  "dataSource": {
                    "type": "static",
                    "data": [
                      {
                        "value": "exempt",
                        "label": {
                          "zh-CN": "免审发布",
                          "en-US": "Exempt publication"
                        }
                      },
                      {
                        "value": "approval",
                        "label": {
                          "zh-CN": "审批后发布",
                          "en-US": "Publish after approval"
                        }
                      }
                    ]
                  },
                  "required": true
                },
                {
                  "field": "approval_definition",
                  "label": {
                    "zh-CN": "审批流程",
                    "en-US": "Approval process"
                  },
                  "type": "select",
                  "group": {
                    "zh-CN": "发布与审批",
                    "en-US": "Publication and approval"
                  },
                  "defaultValue": "${record.approval_definition}",
                  "dataSource": {
                    "type": "api",
                    "endpoint": "/api/announcements/approval-options"
                  },
                  "helpText": {
                    "zh-CN": "流程由租户流程管理员维护；能力未安装时不可送审。",
                    "en-US": "Tenant workflow administrators maintain processes. Submission requires the installed approval capability."
                  },
                  "visibleWhen": {
                    "field": "approval_mode",
                    "value": "approval"
                  }
                },
                {
                  "field": "scheduled_at",
                  "label": {
                    "zh-CN": "预约发布时间",
                    "en-US": "Scheduled publication"
                  },
                  "type": "datetime",
                  "group": {
                    "zh-CN": "发布与审批",
                    "en-US": "Publication and approval"
                  },
                  "defaultValue": "${record.scheduled_at}",
                  "helpText": {
                    "zh-CN": "留空为立即发布；审批未在预约时间前就绪时不会补发。",
                    "en-US": "Leave empty for immediate publication. Late approval does not trigger a missed schedule."
                  }
                },
                {
                  "field": "exemption_reason",
                  "label": {
                    "zh-CN": "免审原因",
                    "en-US": "Exemption reason"
                  },
                  "type": "textarea",
                  "group": {
                    "zh-CN": "发布与审批",
                    "en-US": "Publication and approval"
                  },
                  "defaultValue": "${record.exemption_reason}",
                  "placeholder": {
                    "zh-CN": "例如：已批准的例行维护通知",
                    "en-US": "e.g. Authorized routine maintenance notice"
                  },
                  "helpText": {
                    "zh-CN": "免审提交必须有独立免审权限并说明原因。",
                    "en-US": "Exempt submission requires separate exemption permission and a reason."
                  },
                  "visibleWhen": {
                    "field": "approval_mode",
                    "value": "exempt"
                  }
                },
                {
                  "field": "ack_required",
                  "label": {
                    "zh-CN": "要求确认已知悉",
                    "en-US": "Require acknowledgement"
                  },
                  "type": "checkbox",
                  "group": {
                    "zh-CN": "知悉政策",
                    "en-US": "Acknowledgement"
                  },
                  "defaultValue": "${record.ack_required_effective}",
                  "helpText": {
                    "zh-CN": "重要公告默认开启；阅读与确认是两个独立动作。",
                    "en-US": "Enabled by default for important notices. Reading and acknowledgement are separate."
                  }
                },
                {
                  "field": "ack_days",
                  "label": {
                    "zh-CN": "知悉期限（天）",
                    "en-US": "Acknowledgement period (days)"
                  },
                  "type": "number",
                  "group": {
                    "zh-CN": "知悉政策",
                    "en-US": "Acknowledgement"
                  },
                  "defaultValue": "${record.ack_days}",
                  "helpText": {
                    "zh-CN": "发布后 1–30 天，默认 7 天；到期后仍可确认。",
                    "en-US": "1–30 days from publication, default 7. Late acknowledgement remains available."
                  },
                  "placeholder": {
                    "zh-CN": "例如：7",
                    "en-US": "e.g. 7"
                  }
                }
              ],
              "inputFieldsTitle": {
                "zh-CN": "通知设置",
                "en-US": "Notification settings"
              },
              "inputFieldsSubmitLabel": {
                "zh-CN": "保存设置",
                "en-US": "Save settings"
              }
            },
            "permissionCode": "announcement.announcement.edit",
            "visibleWhen": "record.status === 'draft'"
          },
          {
            "code": "edit",
            "label": {
              "zh-CN": "编辑",
              "en-US": "Edit"
            },
            "action": {
              "type": "navigate",
              "to": "ab_announcement_form",
              "command": "announcement:update_announcement"
            },
            "visibleWhen": "record.status === 'draft'",
            "permissionCode": "announcement.announcement.edit"
          },
          {
            "code": "publish",
            "label": {
              "zh-CN": "免审发布",
              "en-US": "Publish without approval"
            },
            "variant": "primary",
            "confirm": "announcement.publish.confirm",
            "action": {
              "type": "command",
              "command": "announcement:publish",
              "operationType": "UPDATE"
            },
            "visibleWhen": "record.status === 'draft' && record.approval_mode !== 'approval'",
            "permissionCode": "announcement.announcement.publish"
          },
          {
            "code": "archive",
            "label": {
              "zh-CN": "撤回",
              "en": "Archive"
            },
            "confirm": "announcement.archive.confirm",
            "action": {
              "type": "command",
              "command": "announcement:archive",
              "operationType": "UPDATE"
            },
            "visibleWhen": "record.status === 'published'",
            "permissionCode": "announcement.announcement.withdraw"
          },
          {
            "code": "republish",
            "label": {
              "zh-CN": "建立修订草稿",
              "en-US": "Create revision draft"
            },
            "variant": "primary",
            "confirm": "announcement.republish.confirm",
            "action": {
              "type": "command",
              "command": "announcement:republish",
              "operationType": "UPDATE"
            },
            "visibleWhen": "record.status === 'withdrawn' || record.status === 'expired' || record.status === 'missed'",
            "permissionCode": "announcement.announcement.edit"
          },
          {
            "code": "delete",
            "variant": "danger",
            "label": {
              "zh-CN": "删除",
              "en-US": "Delete"
            },
            "confirm": "delete.confirm",
            "action": {
              "type": "command",
              "command": "announcement:delete_announcement",
              "operationType": "DELETE"
            },
            "visibleWhen": "record.status === 'draft' && !record.current_version_pid",
            "permissionCode": "announcement.announcement.delete"
          },
          {
            "code": "cancel_schedule",
            "label": {
              "zh-CN": "取消发布安排",
              "en-US": "Cancel release"
            },
            "action": {
              "type": "command",
              "command": "announcement:cancel_schedule",
              "operationType": "UPDATE"
            },
            "visibleWhen": "record.status === 'scheduled' || record.status === 'unpublished'",
            "permissionCode": "announcement.announcement.publish",
            "confirm": "announcement.cancel_schedule.confirm"
          }
        ],
        "defaultSort": {
          "field": "created_at",
          "order": "desc"
        }
      }
    ],
    "extension": {
      "commandRequest": {
        "idempotent": true,
        "versionField": "row_version",
        "payloadFields": []
      },
      "commandRequestByCommand": {
        "announcement:update_announcement": {
          "idempotent": true,
          "versionField": "row_version",
          "payloadFields": [
            "audience_kind",
            "audience_users",
            "audience_departments",
            "audience_roles",
            "ack_required",
            "ack_days",
            "approval_mode",
            "approval_definition",
            "scheduled_at",
            "exemption_reason"
          ],
          "inputFieldsOnly": true
        }
      }
    }
  },
  {
    "pageKey": "ab_announcement_form",
    "name:zh-CN": "公告表单",
    "name:en": "Announcement Form",
    "modelCode": "ab_announcement",
    "kind": "form",
    "schemaVersion": 4,
    "layout": {
      "type": "grid",
      "cols": 12
    },
    "blocks": [
      {
        "id": "basic",
        "blockType": "form-section",
        "title": {
          "zh-CN": "公告内容",
          "en-US": "Announcement Content"
        },
        "fields": [
          {
            "field": "title",
            "colSpan": 12,
            "required": false,
            "props": {
              "placeholder": {
                "zh-CN": "例如：10 月 12 日系统维护通知",
                "en-US": "e.g. System maintenance on October 12"
              }
            },
            "helpText": {
              "zh-CN": "可先保存未完成的草稿，再从公告列表的“通知设置”选择受众、发布方式和知悉要求。",
              "en-US": "Save an incomplete draft, then use Notification settings from the announcement list to choose the audience, approval mode and acknowledgement policy."
            }
          },
          {
            "field": "announcement_priority",
            "colSpan": 6,
            "defaultValue": "normal"
          },
          {
            "field": "pinned",
            "colSpan": 6,
            "defaultValue": false
          },
          {
            "field": "expires_at",
            "colSpan": 6
          },
          {
            "field": "content",
            "colSpan": 12,
            "props": {
              "placeholder": {
                "zh-CN": "说明适用对象、具体事项和生效时间",
                "en-US": "Describe the audience, details and effective time"
              }
            },
            "helpText": {
              "zh-CN": "补充影响范围、时间安排和需要读者采取的行动。",
              "en-US": "Explain the impact, schedule and any action readers should take."
            }
          },
          {
            "field": "attachments",
            "colSpan": 12,
            "defaultValue": [],
            "props": {
              "renderComponent": "fileattachment",
              "multiple": true,
              "maxCount": 10,
              "limitsEndpoint": "/api/file/limits"
            },
            "helpText": {
              "zh-CN": "最多 10 个附件；单文件限制以服务器当前上传配置为准。",
              "en-US": "Up to 10 attachments. The current server upload configuration determines the file-size limit."
            }
          }
        ]
      },
      {
        "id": "buttons",
        "blockType": "form-buttons",
        "buttons": [
          {
            "code": "submit",
            "primary": true,
            "label": {
              "zh-CN": "保存",
              "en-US": "Save"
            },
            "action": {
              "type": "command",
              "command": "announcement:update_announcement"
            },
            "permissionCode": "announcement.announcement.edit"
          },
          {
            "code": "cancel",
            "label": {
              "zh-CN": "取消",
              "en-US": "Cancel"
            }
          }
        ]
      }
    ],
    "extension": {
      "commandRequest": {
        "idempotent": true,
        "versionField": "row_version",
        "payloadFields": [
          "title",
          "content",
          "announcement_priority",
          "pinned",
          "expires_at",
          "attachments"
        ]
      }
    }
  },
  {
    "pageKey": "ab_announcement_detail",
    "name:zh-CN": "公告详情",
    "name:en": "Announcement Detail",
    "modelCode": "ab_announcement",
    "kind": "detail",
    "schemaVersion": 4,
    "layout": {
      "type": "grid",
      "cols": 12
    },
    "blocks": [
      {
        "id": "basic",
        "blockType": "form-section",
        "title": {
          "zh-CN": "基本信息",
          "en-US": "Basic Information"
        },
        "readOnly": true,
        "fields": [
          {
            "field": "title",
            "colSpan": 12
          },
          {
            "field": "announcement_priority",
            "colSpan": 4
          },
          {
            "field": "status",
            "colSpan": 4
          },
          {
            "field": "pinned",
            "colSpan": 4
          },
          {
            "field": "published_by",
            "colSpan": 6,
            "label": {
              "zh-CN": "上次发布人",
              "en-US": "Last publisher"
            }
          },
          {
            "field": "published_at",
            "colSpan": 6,
            "label": {
              "zh-CN": "上次发布时间",
              "en-US": "Last published at"
            }
          },
          {
            "field": "expires_at",
            "colSpan": 6
          },
          {
            "field": "content",
            "colSpan": 12
          }
        ]
      }
    ],
    "extension": {
      "commandRequest": {
        "idempotent": true,
        "versionField": "row_version",
        "payloadFields": []
      },
      "commandRequestByCommand": {
        "announcement:update_announcement": {
          "idempotent": true,
          "versionField": "row_version",
          "payloadFields": [
            "audience_kind",
            "audience_users",
            "audience_departments",
            "audience_roles",
            "ack_required",
            "ack_days",
            "approval_mode",
            "approval_definition",
            "scheduled_at",
            "exemption_reason"
          ],
          "inputFieldsOnly": true
        }
      }
    }
  }
]
