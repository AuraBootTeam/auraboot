[
  {
    "pageKey": "ab_announcement_list",
    "name:zh-CN": "系统公告",
    "name:en": "Announcements",
    "modelCode": "ab_announcement",
    "kind": "list",
    "schemaVersion": 4,
    "layout": {
      "type": "stack"
    },
    "blocks": [
      {
        "id": "toolbar",
        "blockType": "toolbar",
        "buttons": [
          {
            "code": "create",
            "variant": "primary",
            "label": { "zh-CN": "新建公告", "en-US": "Create Announcement" },
            "action": {
              "type": "navigate",
              "to": "ab_announcement_form",
              "command": "announcement:create_announcement"
            }
          }
        ]
      },
      {
        "id": "filters",
        "blockType": "filters",
        "fields": [
          {"field": "title", "props": {"placeholder": {"zh-CN": "例如：周末系统维护", "en-US": "e.g. Scheduled weekend maintenance"}}, "helpText": {"zh-CN": "按公告标题关键词查找；清除关键词可查看全部公告。", "en-US": "Search by announcement title keywords. Clear the keywords to show all announcements."}},
          { "field": "status" },
          { "field": "announcement_priority" }
        ]
      },
      {
        "id": "table",
        "blockType": "table",
        "empty": {
          "title": { "zh-CN": "没有匹配的公告", "en-US": "No matching announcements" },
          "description": { "zh-CN": "选择“新建公告”创建草稿，或清除筛选条件查看已有公告。", "en-US": "Choose Create Announcement to draft a notice, or clear the filters to view existing announcements." }
        },
        "columns": [
          {
            "field": "title",
            "width": 280,
            "sortable": true
          },
          {
            "field": "announcement_priority",
            "width": 100,
            "dictCode": "announcement_priority",
            "renderType": "tag"
          },
          {
            "field": "status",
            "width": 100,
            "dictCode": "announcement_status",
            "renderType": "tag"
          },
          {
            "field": "pinned",
            "width": 80
          },
          {
            "field": "published_at",
            "width": 160,
            "format": "YYYY-MM-DD HH:mm"
          },
          {
            "field": "expires_at",
            "width": 160,
            "format": "YYYY-MM-DD HH:mm"
          }
        ],
        "rowActions": [
          {
            "code": "view",
            "label": { "zh-CN": "查看", "en-US": "View" },
            "action": {
              "type": "navigate",
              "to": "ab_announcement_detail"
            }
          },
          {
            "code": "edit",
            "label": { "zh-CN": "编辑", "en-US": "Edit" },
            "action": {
              "type": "navigate",
              "to": "ab_announcement_form",
              "command": "announcement:update_announcement"
            },
            "visibleWhen": "record.status === 'draft'"
          },
          {
            "code": "publish",
            "label": { "zh-CN": "发布", "en": "Publish" },
            "variant": "primary",
            "confirm": "announcement.publish.confirm",
            "action": {
              "type": "command",
              "command": "announcement:publish"
            },
            "visibleWhen": "record.status === 'draft'"
          },
          {
            "code": "archive",
            "label": { "zh-CN": "撤回", "en": "Archive" },
            "confirm": "announcement.archive.confirm",
            "action": {
              "type": "command",
              "command": "announcement:archive"
            },
            "visibleWhen": "record.status === 'published'"
          },
          {
            "code": "republish",
            "label": { "zh-CN": "重新发布", "en": "Republish" },
            "variant": "primary",
            "confirm": "announcement.republish.confirm",
            "action": {
              "type": "command",
              "command": "announcement:republish"
            },
            "visibleWhen": "record.status === 'archived'"
          },
          {
            "code": "delete",
            "variant": "danger",
            "label": { "zh-CN": "删除", "en-US": "Delete" },
            "confirm": "delete.confirm",
            "action": {
              "type": "command",
              "command": "announcement:delete_announcement"
            },
            "visibleWhen": "record.status === 'draft' || record.status === 'archived'"
          }
        ],
        "defaultSort": {
          "field": "created_at",
          "order": "desc"
        }
      }
    ]
  },
  {
    "pageKey": "ab_announcement_form",
    "name:zh-CN": "公告表单",
    "name:en": "Announcement Form",
    "modelCode": "ab_announcement",
    "kind": "form",
    "schemaVersion": 4,
    "layout": {
      "type": "grid",
      "cols": 12
    },
    "blocks": [
      {
        "id": "basic",
        "blockType": "form-section",
        "title": {
          "zh-CN": "公告内容",
          "en-US": "Announcement Content"
        },
        "fields": [
          {"field": "title", "colSpan": 12, "required": true, "props": {"placeholder": {"zh-CN": "例如：10 月 12 日系统维护通知", "en-US": "e.g. System maintenance on October 12"}}, "helpText": {"zh-CN": "用简明标题说明事项，最多 256 个字符；保存后为草稿，发布后读者才可见。", "en-US": "Summarize the subject in up to 256 characters. Saving creates a draft; readers see it after publication."}},
          { "field": "announcement_priority", "colSpan": 6 },
          { "field": "pinned", "colSpan": 6 },
          { "field": "expires_at", "colSpan": 6 },
          {"field": "content", "colSpan": 12, "props": {"placeholder": {"zh-CN": "说明适用对象、具体事项和生效时间", "en-US": "Describe the audience, details and effective time"}}, "helpText": {"zh-CN": "补充影响范围、时间安排和需要读者采取的行动。", "en-US": "Explain the impact, schedule and any action readers should take."}}
        ]
      },
      {
        "id": "buttons",
        "blockType": "form-buttons",
        "buttons": [
          {
            "code": "submit",
            "primary": true,
            "label": { "zh-CN": "保存", "en-US": "Save" },
            "action": {
              "type": "command",
              "command": "announcement:update_announcement"
            }
          },
          {
            "code": "cancel",
            "label": { "zh-CN": "取消", "en-US": "Cancel" }
          }
        ]
      }
    ]
  },
  {
    "pageKey": "ab_announcement_detail",
    "name:zh-CN": "公告详情",
    "name:en": "Announcement Detail",
    "modelCode": "ab_announcement",
    "kind": "detail",
    "schemaVersion": 4,
    "layout": {
      "type": "grid",
      "cols": 12
    },
    "blocks": [
      {
        "id": "basic",
        "blockType": "form-section",
        "title": {
          "zh-CN": "基本信息",
          "en-US": "Basic Information"
        },
        "readOnly": true,
        "fields": [
          { "field": "title", "colSpan": 12 },
          { "field": "announcement_priority", "colSpan": 4 },
          { "field": "status", "colSpan": 4 },
          { "field": "pinned", "colSpan": 4 },
          { "field": "published_by", "colSpan": 6 },
          { "field": "published_at", "colSpan": 6 },
          { "field": "expires_at", "colSpan": 6 },
          { "field": "content", "colSpan": 12 }
        ]
      }
    ]
  }
]
