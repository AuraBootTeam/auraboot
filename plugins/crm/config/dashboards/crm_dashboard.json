        "title": { "zh-CN": "我的计划", "en": "My Plans" },
        "dataSource": {
          "type": "api",
          "url": "/api/datasource/list",
          "params": { "datasourceId": "nq:crm_my_tasks", "format": "records", "maxItems": "8" },
          "dimensionDicts": { "crm_act_status": "crm_task_status", "crm_act_priority": "crm_task_priority" }
        },
        "table": {
          "columns": [
            { "field": "crm_act_subject", "width": 280, "label": { "zh-CN": "计划", "en": "Plan" } },
