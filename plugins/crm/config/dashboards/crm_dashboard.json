            { "field": "crm_act_priority", "width": 120, "renderType": "tag", "dictCode": "crm_task_priority", "label": { "zh-CN": "优先级", "en": "Priority" } },
            { "field": "crm_act_due_date", "width": 150, "format": "date", "label": { "zh-CN": "截止日期", "en": "Due Date" } },
            { "field": "crm_act_date", "width": 170, "format": "datetime", "label": { "zh-CN": "计划时间", "en": "Planned At" } }
