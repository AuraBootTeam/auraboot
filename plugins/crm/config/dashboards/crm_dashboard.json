      "type": "smart-table-chart",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 2,
      "title": { "zh-CN": "销售节奏总览", "en": "Sales Rhythm Overview" },
      "config": {
        "title": { "zh-CN": "销售节奏总览", "en": "Sales Rhythm Overview" },
        "dataSource": {
          "type": "api",
          "url": "/api/datasource/list",
          "params": { "datasourceId": "nq:crm_sales_period_overview", "format": "records", "maxItems": "10" },
          "dimensionDicts": { "metric_group": "crm_sales_period_metric_group" }
        },
        "table": {
          "columns": [
            { "field": "metric_group", "width": 150, "renderType": "tag", "dictCode": "crm_sales_period_metric_group", "label": { "zh-CN": "类别", "en": "Category" } },
            { "field": "today_count", "width": 92, "align": "right", "label": { "zh-CN": "今日数量", "en": "Today Count" } },
            { "field": "today_amount", "width": 122, "align": "right", "format": "currency", "label": { "zh-CN": "今日金额", "en": "Today Amount" } },
            { "field": "week_count", "width": 92, "align": "right", "label": { "zh-CN": "本周数量", "en": "Week Count" } },
            { "field": "week_amount", "width": 122, "align": "right", "format": "currency", "label": { "zh-CN": "本周金额", "en": "Week Amount" } },
            { "field": "month_count", "width": 92, "align": "right", "label": { "zh-CN": "本月数量", "en": "Month Count" } },
            { "field": "month_amount", "width": 122, "align": "right", "format": "currency", "label": { "zh-CN": "本月金额", "en": "Month Amount" } },
            { "field": "year_count", "width": 92, "align": "right", "label": { "zh-CN": "本年数量", "en": "Year Count" } },
            { "field": "year_amount", "width": 122, "align": "right", "format": "currency", "label": { "zh-CN": "本年金额", "en": "Year Amount" } }
          ]
        }
      }
    },
    {
