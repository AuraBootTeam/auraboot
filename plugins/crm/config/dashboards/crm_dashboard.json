    {
      "id": "chart_opp_pipeline",
      "type": "smart-bar-chart",
      "x": 0,
      "y": 8,
      "w": 6,
      "h": 2,
      "title": {
        "zh-CN": "商机管道分布",
        "en": "Opportunity Pipeline Distribution"
