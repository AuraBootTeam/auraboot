          ]
        }
      }
    },
    {
      "id": "block_kpi_cards",
      "type": "smart-number-card",
      "x": 0,
      "y": 7,
      "w": 12,
      "h": 1,
      "title": {
        "zh-CN": "关键指标",
        "en": "Key Metrics"
      },
      "config": {
        "title": {
          "zh-CN": "关键指标",
          "en": "Key Metrics"
        },
        "dataSource": {
          "type": "api",
          "url": "/api/datasource/list",
          "params": {
            "datasourceId": "nq:crm_dashboard_kpi",
            "format": "records",
            "maxItems": "1"
          }
        },
        "cards": [
          {
            "field": "new_leads",
            "label": {
              "zh-CN": "新线索",
              "en": "New Leads"
            },
            "icon": "IconRadar",
            "color": "#3b82f6",
            "drillDown": {
              "enabled": true,
              "action": "navigate",
              "targetPage": "/p/crm_lead_common",
              "filters": [
                { "targetField": "crm_lead_status", "value": "new" }
              ]
            }
          },
          {
            "field": "open_opportunities",
            "label": {
              "zh-CN": "进行中商机",
              "en": "Open Opportunities"
            },
            "icon": "IconTrendingUp",
            "color": "#f59e0b",
            "drillDown": {
              "enabled": true,
              "action": "navigate",
              "targetPage": "/p/crm_opportunity_common",
              "filters": [
                { "targetField": "crm_opp_stage", "operator": "ne", "value": "closed_won" },
                { "targetField": "crm_opp_stage", "operator": "ne", "value": "closed_lost" }
              ]
            }
          },
          {
            "field": "pipeline_value",
            "label": {
              "zh-CN": "管道总额",
              "en": "Pipeline Value"
            },
            "icon": "IconCurrencyDollar",
            "color": "#10b981",
            "format": "currency",
            "drillDown": {
              "enabled": true,
              "action": "navigate",
              "targetPage": "/p/crm_opportunity_common",
              "filters": [
                { "targetField": "crm_opp_stage", "operator": "ne", "value": "closed_won" },
                { "targetField": "crm_opp_stage", "operator": "ne", "value": "closed_lost" }
              ]
            }
          },
          {
            "field": "won_revenue",
            "label": {
              "zh-CN": "赢单金额",
              "en": "Won Revenue"
            },
            "icon": "IconTrophy",
            "color": "#8b5cf6",
            "format": "currency",
            "drillDown": {
              "enabled": true,
              "action": "navigate",
              "targetPage": "/p/crm_opportunity_common",
              "filters": [
                { "targetField": "crm_opp_stage", "value": "closed_won" }
              ]
            }
          },
          {
            "field": "active_accounts",
            "label": {
              "zh-CN": "活跃客户",
              "en": "Active Accounts"
            },
            "icon": "IconBuilding",
            "color": "#06b6d4",
            "drillDown": {
              "enabled": true,
              "action": "navigate",
              "targetPage": "/p/crm_account_common",
              "filters": [
                { "targetField": "crm_acc_status", "value": "active" }
              ]
            }
          },
          {
            "field": "pending_complaints",
            "label": {
              "zh-CN": "待处理投诉",
              "en": "Pending Complaints"
            },
            "icon": "IconAlertTriangle",
            "color": "#ef4444",
            "drillDown": {
              "enabled": true,
              "action": "navigate",
              "targetPage": "/p/crm_complaint",
              "filters": [
                {
                  "targetField": "crm_cmp_status",
                  "operator": "in",
                  "value": ["open", "investigating"]
                }
              ]
            }
          }
        ]
      }
