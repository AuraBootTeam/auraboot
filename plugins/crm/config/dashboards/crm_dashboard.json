            "stage": "crm_opp_stage"
          },
          "dimensions": [
            "stage"
          ],
          "metrics": [
            {
              "field": "count",
              "aggregation": "sum",
              "alias": "count"
            }
          ]
        },
        "title": {
          "zh-CN": "商机管道分布",
          "en": "Opportunity Pipeline Distribution"
