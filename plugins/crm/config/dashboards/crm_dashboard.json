          { "label": { "zh-CN": "新建客户", "en": "New Account" }, "icon": "IconBuilding", "path": "/p/crm_account_common/new" },
          { "label": { "zh-CN": "新建商机", "en": "New Opportunity" }, "icon": "IconTrendingUp", "path": "/p/crm_opportunity_common/new" },
          { "label": { "zh-CN": "新建计划", "en": "New Plan" }, "icon": "IconCalendarPlus", "path": "/p/crm_activity_common/new" },
          { "label": { "zh-CN": "我的任务", "en": "My Tasks" }, "icon": "IconChecklist", "path": "/p/crm_my_tasks" },
          { "label": { "zh-CN": "活动与服务", "en": "Activity and Service" }, "icon": "IconActivity", "path": "/p/c/crm_activity_service_desk" }
