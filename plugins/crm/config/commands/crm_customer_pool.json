  {
    "code": "crm:precheck_customer_pool_import",
    "displayName:zh-CN": "预检客户公海导入",
    "displayName:en": "Pre-check Customer Pool Import",
    "type": "custom",
    "modelCode": "crm_customer_pool_common",
    "handler": "crm:precheck_customer_pool_import",
    "handlerParams": {
      "dslPersistence": false,
      "async": true,
      "taskPresentation": {
        "title": { "zh-CN": "客户公海导入预检", "en": "Customer Pool Import Pre-check" },
        "completedMessage": { "zh-CN": "预检完成，未写入客户数据", "en": "Pre-check completed without customer writes" },
        "metrics": [
          { "field": "totalRows", "label": { "zh-CN": "总行数", "en": "Total rows" } },
          { "field": "validRows", "label": { "zh-CN": "可导入", "en": "Valid rows" }, "tone": "success" },
          { "field": "failedRows", "label": { "zh-CN": "失败", "en": "Failed rows" }, "tone": "danger" }
        ]
      }
