[
  {
    "code": "crm:create_account",
    "displayName:zh-CN": "新建客户",
    "displayName:en": "Create Account",
    "type": "create",
    "modelCode": "crm_account_common",
    "inputFields": [
      "crm_acc_name",
      "crm_acc_industry",
      "crm_acc_website",
      "crm_acc_phone",
      "crm_acc_address",
      "crm_acc_rating",
      "crm_acc_status",
      "crm_acc_remark"
    ],
    "autoSetFields": {
      "crm_acc_code": {
        "strategy": "auto_generate",
        "pattern": "ACC-{yyyyMMdd}-{seq}"
      },
      "crm_acc_owner": {
        "strategy": "current_user_pid",
        "preserveInput": true
      },
    "crm_acc_status": {
      "strategy": "default_value",
      "value": "active"
    },
    "crm_acc_pool_state": {
      "strategy": "fixed_value",
      "value": "owned"
    }
    },
    "permissions": [
      "crm.account.manage"
    ],
    "agent_hint": "Create a new crm account record. Key inputs: name, industry, website, phone, address, rating, status. Auto-generated: code, owner. Defaulted when omitted: status=active.",
    "cmd_risk_level": "L1"
  },
  {
    "code": "crm:update_account",
    "displayName:zh-CN": "编辑客户",
    "displayName:en": "Update Account",
    "type": "update",
    "modelCode": "crm_account_common",
    "inputFields": [
      "crm_acc_name",
      "crm_acc_industry",
      "crm_acc_website",
      "crm_acc_phone",
      "crm_acc_address",
      "crm_acc_owner",
      "crm_acc_rating",
      "crm_acc_status",
      "crm_acc_remark"
    ],
    "permissions": [
      "crm.account.manage"
    ],
    "agent_hint": "Update an existing crm account record. Editable fields: name, industry, website, phone, address.",
    "cmd_risk_level": "L1"
  },
  {
    "code": "crm:merge_account",
    "displayName:zh-CN": "合并客户",
    "displayName:en": "Merge Account",
    "type": "custom",
    "modelCode": "crm_account_common",
    "handler": "crm:merge_account",
    "permissions": [
      "crm.account.manage"
    ],
    "agent_hint": "Merge the source account into a distinct owned target account, move all open-core child records and remove the source account.",
    "cmd_risk_level": "L3"
  },
  {
    "code": "crm:delete_account",
    "displayName:zh-CN": "删除客户",
    "displayName:en": "Delete Account",
    "type": "delete",
    "modelCode": "crm_account_common",
    "extension": {
      "confirmMessage:zh-CN": "确认删除此客户？",
      "confirmMessage:en": "Confirm delete this account?"
    },
    "permissions": [
      "crm.account.manage"
    ],
    "agent_hint": "Delete crm account record(s). This is irreversible.",
    "cmd_risk_level": "L4"
  },
  {
    "code": "crm:detail_account",
    "displayName:zh-CN": "查看客户",
    "displayName:en": "View Account",
    "type": "query",
    "modelCode": "crm_account_common",
    "permissions": [
      "crm.account.read"
    ],
    "agent_hint": "Query crm account records.",
    "cmd_risk_level": "L0"
  },
  {
    "code": "crm:list_accounts",
    "displayName:zh-CN": "客户列表",
    "displayName:en": "List Accounts",
    "type": "query",
    "modelCode": "crm_account_common",
    "permissions": [
      "crm.account.read"
    ],
    "agent_hint": "Query crm account records.",
    "cmd_risk_level": "L0"
  },
  {
    "code": "crm:recompute_health",
    "displayName:zh-CN": "重算健康分",
    "displayName:en": "Recompute Health",
    "type": "custom",
    "handler": "crm:recompute_health",
    "modelCode": "crm_account_common",
    "permissions": [
      "crm.account.manage"
    ],
    "agent_hint": "Recompute an account's health score from its complaints and opportunities. Pass the account record id as target.",
