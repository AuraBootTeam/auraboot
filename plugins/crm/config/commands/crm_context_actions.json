[
  {
    "code": "crm:log_opp_activity",
    "displayName:zh-CN": "记录商机活动",
    "displayName:en": "Log Opportunity Activity",
    "description": "Create activity from opportunity detail and auto-link via activity_relation",
    "type": "create",
    "modelCode": "crm_activity_common",
    "inputFields": [
      "crm_act_type",
      "crm_act_subject",
      "crm_act_content",
      "crm_act_date",
      "crm_act_source",
      "crm_act_files",
      "crm_act_status",
      "crm_act_priority",
      "crm_act_due_date",
      "crm_act_assignee",
      "crm_act_duration",
      "crm_act_direction",
      "crm_act_location",
      "crm_act_start_time",
      "crm_act_end_time"
    ],
    "autoSetFields": {
      "crm_act_owner": {
        "strategy": "current_username"
      },
      "crm_act_date": {
        "strategy": "current_datetime"
      }
    },
    "sideEffects": [
      {
        "condition": "#sourceRecordId != null",
        "actions": [
          {
            "type": "create_record",
            "modelCode": "crm_activity_relation_common",
            "fields": {
              "crm_ar_activity_id": "${recordId}",
              "crm_ar_object_type": "opportunity",
              "crm_ar_object_id": "${sourceRecordId}",
              "crm_ar_role": "primary"
            }
          }
        ]
      }
    ],
    "permissions": [
      "crm.activity.manage"
    ],
    "agent_hint": "Create a new crm activity record. Key inputs: type, subject, content, date, source. Auto-generated: owner, date. Side effects: creates crm activity relation record.",
    "cmd_risk_level": "L2"
  },
