[
  {
    "code": "crm:create_activity",
    "displayName:zh-CN": "新建活动",
    "displayName:en": "Create Activity",
    "type": "create",
    "modelCode": "crm_activity_common",
    "inputFields": [
      "crm_act_type",
      "crm_act_subject",
      "crm_act_content",
      "crm_act_date",
      "crm_act_source",
      "crm_act_parent_id",
      "crm_act_files",
      "crm_act_status",
      "crm_act_priority",
      "crm_act_due_date",
      "crm_act_assignee",
      "crm_act_duration",
      "crm_act_direction",
      "crm_act_location",
      "crm_act_start_time",
      "crm_act_end_time",
      "crm_act_related_model",
      "crm_act_related_id"
    ],
    "autoSetFields": {
      "crm_act_owner": {
        "strategy": "current_user_pid"
      },
      "crm_act_date": {
        "strategy": "current_datetime",
        "preserveInput": true
      }
    },
    "permissions": [
      "crm.activity.manage"
    ],
    "agent_hint": "Create a new crm activity record. Key inputs: type, subject, content, date, source. Auto-generated: owner, date.",
    "cmd_risk_level": "L1"
  },
  {
    "code": "crm:update_activity",
    "displayName:zh-CN": "编辑活动",
    "displayName:en": "Update Activity",
    "type": "update",
    "modelCode": "crm_activity_common",
    "inputFields": [
      "crm_act_subject",
      "crm_act_content",
      "crm_act_date",
      "crm_act_source",
      "crm_act_parent_id",
      "crm_act_files",
      "crm_act_status",
      "crm_act_priority",
      "crm_act_due_date",
      "crm_act_assignee",
      "crm_act_duration",
      "crm_act_direction",
      "crm_act_location",
      "crm_act_start_time",
      "crm_act_end_time",
      "crm_act_related_model",
      "crm_act_related_id"
    ],
    "permissions": [
      "crm.activity.manage"
    ],
    "agent_hint": "Update an existing crm activity record. Editable fields: type, subject, content, date, source.",
    "cmd_risk_level": "L1"
  },
  {
    "code": "crm:start_task",
    "displayName:zh-CN": "开始任务",
    "displayName:en": "Start Task",
    "type": "state_transition",
    "modelCode": "crm_activity_common",
    "stateField": "crm_act_status",
    "fromStates": [
      "open"
    ],
    "toState": "in_progress",
    "preconditions": [
      {
        "field": "crm_act_type",
        "operator": "EQ",
        "value": "task"
      }
    ],
    "permissions": [
      "crm.activity.manage"
    ],
    "agent_hint": "Transition crm activity status from open to in_progress.",
    "cmd_risk_level": "L1"
  },
  {
    "code": "crm:complete_task",
    "displayName:zh-CN": "完成任务",
    "displayName:en": "Complete Task",
    "type": "state_transition",
    "modelCode": "crm_activity_common",
    "stateField": "crm_act_status",
    "fromStates": [
      "open",
      "in_progress"
    ],
    "toState": "done",
    "preconditions": [
      {
        "field": "crm_act_type",
        "operator": "EQ",
        "value": "task",
        "message:zh-CN": "只有跟进计划可以完成",
        "message:en": "Only follow-up plans can be completed"
      }
    ],
    "permissions": [
      "crm.activity.manage"
    ],
    "agent_hint": "Transition crm activity status from open/in_progress to DONE.",
    "cmd_risk_level": "L1"
  },
  {
    "code": "crm:cancel_task",
    "displayName:zh-CN": "取消任务",
    "displayName:en": "Cancel Task",
    "type": "state_transition",
    "modelCode": "crm_activity_common",
    "stateField": "crm_act_status",
    "fromStates": [
      "open",
      "in_progress"
    ],
    "toState": "cancelled",
    "preconditions": [
      {
        "field": "crm_act_type",
        "operator": "EQ",
        "value": "task",
        "message:zh-CN": "只有跟进计划可以取消",
        "message:en": "Only follow-up plans can be cancelled"
      }
    ],
    "permissions": [
      "crm.activity.manage"
    ],
    "agent_hint": "Transition crm activity status from open/in_progress to cancelled.",
    "cmd_risk_level": "L1"
  },
  {
    "code": "crm:delete_follow_plan",
    "displayName:zh-CN": "删除跟进计划",
    "displayName:en": "Delete Follow-up Plan",
    "type": "delete",
    "modelCode": "crm_activity_common",
    "preconditions": [
      {
        "field": "crm_act_type",
        "operator": "EQ",
        "value": "task",
        "message:zh-CN": "只能通过此动作删除跟进计划",
        "message:en": "This action only deletes follow-up plans"
      }
    ],
    "extension": {
      "confirmMessage:zh-CN": "确认删除此跟进计划？删除后无法恢复，关联评论也将不可见。",
      "confirmMessage:en": "Delete this follow-up plan? It cannot be restored and related comments will no longer be visible."
    },
    "permissions": [
      "crm.activity.manage"
    ],
    "agent_hint": "Delete a task-type follow-up plan. This is irreversible.",
    "cmd_risk_level": "L4"
  },
  {
    "code": "crm:delete_follow_record",
    "displayName:zh-CN": "删除跟进记录",
    "displayName:en": "Delete Follow-up Record",
    "type": "delete",
    "modelCode": "crm_activity_common",
    "preconditions": [
      {
        "field": "crm_act_type",
        "operator": "IN",
        "value": ["call", "email", "meeting", "note", "visit"],
        "message:zh-CN": "只能通过此动作删除跟进记录",
        "message:en": "This action only deletes follow-up records"
      }
    ],
    "extension": {
      "confirmMessage:zh-CN": "确认删除此跟进记录？删除后无法恢复，关联评论也将不可见。",
      "confirmMessage:en": "Delete this follow-up record? It cannot be restored and related comments will no longer be visible."
    },
    "permissions": [
      "crm.activity.manage"
    ],
    "agent_hint": "Delete a non-task follow-up record. This is irreversible.",
    "cmd_risk_level": "L4"
  },
  {
    "code": "crm:detail_activity",
    "displayName:zh-CN": "查看活动",
    "displayName:en": "View Activity",
    "type": "query",
    "modelCode": "crm_activity_common",
    "permissions": [
      "crm.activity.read"
    ],
    "agent_hint": "Query crm activity records.",
    "cmd_risk_level": "L0"
  },
  {
    "code": "crm:list_activities",
    "displayName:zh-CN": "活动列表",
    "displayName:en": "List Activities",
    "type": "query",
    "modelCode": "crm_activity_common",
    "permissions": [
      "crm.activity.read"
    ],
    "agent_hint": "Query crm activity records.",
    "cmd_risk_level": "L0"
  }
]
