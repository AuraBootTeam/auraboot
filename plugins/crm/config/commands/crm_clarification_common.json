      "crm_cl_raised_at",
      "crm_cl_resolved_at",
      "crm_cl_source_model",
      "crm_cl_source_id",
      "crm_cl_common_payload"
    ],
    "autoSetFields": {
      "crm_cl_code": {
        "strategy": "auto_generate",
        "pattern": "CL-{yyyyMMdd}-{seq}"
      }
    },
    "permissions": [
      "crm.clarification.manage"
    ],
    "agent_hint": "Create a generic Clarification fact. Industry packages keep industry-specific fields in their own 1:1 sidecar model.",
