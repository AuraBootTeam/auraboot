[
  {
    "code": "crm:create_clarification",
    "displayName:zh-CN": "新建澄清项",
    "displayName:en": "Create Clarification",
    "type": "create",
    "modelCode": "crm_clarification_common",
    "inputFields": [
      "crm_cl_title",
      "crm_cl_clarification_type",
