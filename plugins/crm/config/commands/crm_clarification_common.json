  {
    "code": "crm:send_clarification",
    "displayName:zh-CN": "发给客户",
    "displayName:en": "Send to Customer",
    "description": "Mark a clarification as awaiting customer response.",
    "type": "state_transition",
    "modelCode": "crm_clarification_common",
    "stateField": "crm_cl_status",
    "fromStates": [
      "pending"
    ],
    "toState": "awaiting_customer",
    "permissions": [
      "crm.clarification.manage"
    ],
    "extension": {
      "confirmMessage:zh-CN": "确认已将澄清发给客户？",
      "confirmMessage:en": "Mark this clarification as awaiting customer?"
    }
  },
  {
    "code": "crm:mark_clarification_replied",
    "displayName:zh-CN": "客户已回复",
    "displayName:en": "Customer Replied",
    "description": "Record that the customer has replied (answer required).",
    "type": "state_transition",
    "modelCode": "crm_clarification_common",
    "stateField": "crm_cl_status",
    "fromStates": [
      "pending",
      "awaiting_customer"
    ],
    "toState": "customer_replied",
    "preconditions": [
      {
        "field": "crm_cl_answer",
        "operator": "is_not_null",
        "message:zh-CN": "请先填写客户回复内容",
        "message:en": "The customer answer must be recorded first"
      }
    ],
    "permissions": [
      "crm.clarification.manage"
    ],
    "extension": {
      "confirmMessage:zh-CN": "确认客户已回复？",
      "confirmMessage:en": "Mark this clarification as customer-replied?"
    }
  },
  {
    "code": "crm:resolve_clarification",
    "displayName:zh-CN": "标记已解决",
    "displayName:en": "Resolve Clarification",
    "description": "Resolve a clarification after the customer reply has been processed.",
    "type": "state_transition",
    "modelCode": "crm_clarification_common",
    "stateField": "crm_cl_status",
    "fromStates": [
      "customer_replied"
    ],
    "toState": "resolved",
    "permissions": [
      "crm.clarification.manage"
    ],
    "extension": {
      "confirmMessage:zh-CN": "确认此澄清已解决？",
      "confirmMessage:en": "Resolve this clarification?"
    }
  },
  {
    "code": "crm:cancel_clarification",
    "displayName:zh-CN": "取消澄清",
    "displayName:en": "Cancel Clarification",
    "description": "Cancel a clarification that is no longer needed.",
    "type": "state_transition",
    "modelCode": "crm_clarification_common",
    "stateField": "crm_cl_status",
    "fromStates": [
      "pending",
      "awaiting_customer"
    ],
    "toState": "cancelled",
    "permissions": [
      "crm.clarification.manage"
    ],
    "extension": {
      "confirmMessage:zh-CN": "确认取消此澄清？",
      "confirmMessage:en": "Cancel this clarification?"
    }
  }
]
