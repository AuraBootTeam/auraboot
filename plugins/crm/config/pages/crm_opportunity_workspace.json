{
  "pageKey": "crm_opportunity_workspace",
  "name:zh-CN": "商机工作台",
  "name:en": "Opportunity Workspace",
  "modelCode": "crm_opportunity_common",
  "description": "Opportunity decision workspace that combines stage, account, value, risk, activity and quote readiness.",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": { "type": "stack" },
  "extension": { "showShare": false, "showReport": false, "showPrint": false, "showEdit": false },
  "dataSources": {
    "opportunityStats": {
      "type": "namedQuery",
      "queryCode": "crm_opportunity_workspace_stats",
      "params": {},
      "adaptor": "table",
      "format": "records"
    },
    "opportunityQueue": {
      "type": "namedQuery",
      "queryCode": "crm_opportunity_workspace_queue",
      "params": {
        "oppKeyword": "${state.searchKeyword}",
        "viewFilter": "${state.viewFilter}"
      },
      "dependOn": ["state.searchKeyword", "state.viewFilter"],
      "adaptor": "table",
      "format": "records"
    }
  },
  "blocks": [
    {
      "id": "crm_opportunity_metrics",
      "blockType": "metric-strip",
      "dataSource": "opportunityStats",
      "variant": "cards",
      "columns": 4,
      "metrics": [
        {
          "key": "open_deals",
          "label": { "zh-CN": "在途商机", "en": "Open Deals" },
          "valueField": "open_deals",
          "subText": { "zh-CN": "当前可推进分母", "en": "Current actionable denominator" },
          "tone": "blue",
          "icon": "BriefcaseBusiness",
          "activeWhen": "state.viewFilter == null || state.viewFilter == '' || state.viewFilter == 'all'",
          "onClick": { "action": "state.set", "args": { "viewFilter": "all" } }
        },
        {
          "key": "at_risk",
          "label": { "zh-CN": "风险商机", "en": "At-risk Deals" },
          "valueField": "at_risk_count",
          "subText": { "zh-CN": "逾期、停滞或有风险项", "en": "Overdue, stale or risk-blocked" },
          "tone": "red",
          "icon": "ShieldAlert",
          "activeWhen": "state.viewFilter == 'at_risk'",
          "onClick": { "action": "state.set", "args": { "viewFilter": "at_risk" } }
        },
        {
          "key": "closing_30",
          "label": { "zh-CN": "30 天内预计关闭", "en": "Closing in 30 Days" },
          "valueField": "closing_30_count",
          "subText": { "zh-CN": "需要明确承诺和下一活动", "en": "Needs commitment and next activity" },
          "tone": "amber",
          "icon": "CalendarClock",
          "activeWhen": "state.viewFilter == 'closing_30'",
          "onClick": { "action": "state.set", "args": { "viewFilter": "closing_30" } }
        },
        {
          "key": "weighted_amount",
          "label": { "zh-CN": "加权预测", "en": "Weighted Forecast" },
          "valueField": "weighted_amount",
          "valueType": "currency",
          "precision": 0,
          "subText": { "zh-CN": "按商机概率加权", "en": "Probability-weighted value" },
          "tone": "green",
          "icon": "ChartNoAxesCombined",
          "activeWhen": "state.viewFilter == 'proposal'",
          "onClick": { "action": "state.set", "args": { "viewFilter": "proposal" } }
        }
      ]
    },
    {
      "id": "crm_opportunity_search",
      "blockType": "filters",
      "onSearch": { "action": "dataSource.reload", "args": { "dataSourceId": "opportunityQueue" } },
      "onReset": { "action": "state.set", "args": { "searchKeyword": "" } },
      "fields": [
        {
          "field": "crm_opp_name",
          "component": "SmartInput",
          "bindState": "searchKeyword",
          "label": { "zh-CN": "搜索商机队列", "en": "Search opportunity queue" },
          "placeholder": { "zh-CN": "输入商机、客户或编号", "en": "Search opportunity, customer or code" },
          "helpText": { "zh-CN": "搜索会保留当前风险或关闭时间筛选。", "en": "Search keeps the current risk or closing-window filter." }
        }
      ]
    },
    {
      "id": "crm_opportunity_header_actions",
      "blockType": "workbench-action-bar",
      "surface": "bare",
      "density": "compact",
      "align": "end",
      "actions": [
        {
          "code": "open_opportunity_record",
          "permissionCode": "crm.opportunity.read",
          "label": { "zh-CN": "打开商机档案", "en": "Open Opportunity Record" },
          "variant": "secondary",
          "visibleWhen": "state.selectedOpportunity != null",
          "onClick": {
            "action": "navigate",
            "args": {
              "to": "/p/crm_opportunity_common/view/${state.selectedOpportunity.pid}",
              "context": {
                "returnTo": "/p/c/crm_opportunity_workspace",
                "state": {
                  "searchKeyword": "${state.searchKeyword}",
                  "viewFilter": "${state.viewFilter}"
                }
              }
            }
          }
        },
        {
          "code": "create_opportunity",
          "permissionCode": "crm.opportunity.manage",
          "label": { "zh-CN": "新建商机", "en": "Create Opportunity" },
          "variant": "primary",
          "onClick": { "action": "navigate", "args": { "to": "/p/crm_opportunity_common/new" } }
        }
      ]
    },
    {
      "id": "crm_opportunity_queue",
      "blockType": "table",
      "title": { "zh-CN": "商机决策队列", "en": "Opportunity Decision Queue" },
      "dataSource": "opportunityQueue",
      "density": "compact",
      "maxHeight": 430,
      "selection": { "mode": "single", "bind": "selectedOpportunity", "defaultFirst": true },
      "columns": [
        { "field": "crm_opp_name", "width": 210, "label": { "zh-CN": "商机", "en": "Opportunity" } },
        { "field": "account_name", "width": 165, "label": { "zh-CN": "客户", "en": "Customer" } },
        { "field": "owner_name", "width": 145, "label": { "zh-CN": "负责人", "en": "Owner" } },
        { "field": "crm_opp_stage", "width": 115, "dictCode": "crm_opp_stage", "label": { "zh-CN": "阶段", "en": "Stage" } },
        { "field": "crm_opp_expected_amount", "width": 130, "align": "right", "valueType": "currency", "label": { "zh-CN": "预计金额", "en": "Amount" } },
        { "field": "crm_opp_probability", "width": 95, "align": "right", "label": { "zh-CN": "概率", "en": "Probability" } },
        { "field": "crm_opp_expected_close_date", "width": 135, "valueType": "date", "label": { "zh-CN": "预计关闭", "en": "Close Date" } },
        { "field": "open_risks", "width": 90, "align": "right", "label": { "zh-CN": "风险项", "en": "Risks" } },
        { "field": "quote_count", "width": 90, "align": "right", "label": { "zh-CN": "报价", "en": "Quotes" } },
        { "field": "next_action", "width": 140, "dictCode": "crm_opportunity_next_action", "label": { "zh-CN": "建议动作", "en": "Next Action" } }
      ],
      "rowActions": [
        {
          "code": "view_opportunity",
          "label": { "zh-CN": "查看商机", "en": "View Opportunity" },
          "permissionCode": "crm.opportunity.read",
          "action": { "type": "navigate", "to": "crm_opportunity_common_detail" }
        }
      ],
      "empty": {
        "title": { "zh-CN": "当前没有符合条件的在途商机", "en": "No open opportunities match the current criteria" },
        "description": { "zh-CN": "可清除搜索或风险筛选；有新销售机会时也可从上方新建商机。", "en": "Clear the search or risk filter, or create an opportunity above when a new deal appears." }
      }
    },
    {
      "id": "crm_opportunity_attention",
      "blockType": "status-banner",
      "context": "${state.selectedOpportunity}",
      "statusField": "next_action",
      "toneMap": {
        "close_date_overdue": "red",
        "mitigate_risk": "red",
        "follow_up": "amber",
        "prepare_quote": "amber",
        "advance_stage": "blue"
      },
      "titleMap": {
        "close_date_overdue": { "zh-CN": "预计关闭日期已逾期", "en": "Expected close date is overdue" },
        "mitigate_risk": { "zh-CN": "先关闭关键风险", "en": "Mitigate critical risks first" },
        "follow_up": { "zh-CN": "商机跟进已停滞", "en": "Opportunity follow-up is stale" },
        "prepare_quote": { "zh-CN": "报价准备度不足", "en": "Quote readiness is incomplete" },
        "advance_stage": { "zh-CN": "推进下一销售阶段", "en": "Advance the sales stage" }
      },
      "descriptionMap": {
        "close_date_overdue": { "zh-CN": "先更新真实关闭预期和下一活动，避免预测虚高。", "en": "Update the real close expectation and next activity to avoid forecast inflation." },
        "mitigate_risk": { "zh-CN": "在推进阶段前明确风险责任人和缓解动作。", "en": "Assign risk ownership and mitigation before advancing." },
        "follow_up": { "zh-CN": "记录一次真实客户互动，再决定阶段和概率。", "en": "Record a real customer interaction before changing stage or probability." },
        "prepare_quote": { "zh-CN": "核对需求、行项、风险和报价摘要后再进入承诺。", "en": "Review requirements, line items, risks and quote summary before commitment." }
      },
      "summaryFields": [
        {
          "field": "crm_opp_stage",
          "label": { "zh-CN": "当前阶段", "en": "Stage" },
          "valueMap": {
            "discovery": { "zh-CN": "发现", "en": "Discovery" },
            "qualification": { "zh-CN": "资格确认", "en": "Qualification" },
            "proposal": { "zh-CN": "方案报价", "en": "Proposal" },
            "negotiation": { "zh-CN": "商务谈判", "en": "Negotiation" },
            "closed_won": { "zh-CN": "赢单", "en": "Closed Won" },
            "closed_lost": { "zh-CN": "丢单", "en": "Closed Lost" }
          }
        },
        { "field": "crm_opp_expected_amount", "label": { "zh-CN": "预计金额", "en": "Amount" } },
        { "field": "crm_opp_probability", "label": { "zh-CN": "概率", "en": "Probability" }, "unit": "%" },
        { "field": "owner_name", "label": { "zh-CN": "负责人", "en": "Owner" } }
      ]
    },
    {
      "id": "crm_opportunity_stage_actions",
      "blockType": "workbench-action-bar",
      "title": { "zh-CN": "安全推进", "en": "Safe Progression" },
      "surface": "card",
      "density": "compact",
      "actions": [
        {
          "code": "qualify_opportunity",
          "permissionCode": "crm.opportunity.manage",
          "label": { "zh-CN": "进入资格确认", "en": "Move to Qualification" },
          "variant": "primary",
          "visibleWhen": "state.selectedOpportunity != null && state.selectedOpportunity.crm_opp_stage == 'discovery'",
          "onClick": { "action": "command.execute", "args": { "command": "crm:qualify_opportunity", "operationType": "update", "targetRecordPid": "${state.selectedOpportunity.pid}", "reload": ["opportunityStats", "opportunityQueue"] } }
        },
        {
          "code": "advance_to_proposal",
          "permissionCode": "crm.opportunity.manage",
          "label": { "zh-CN": "进入方案报价", "en": "Move to Proposal" },
          "variant": "primary",
          "visibleWhen": "state.selectedOpportunity != null && state.selectedOpportunity.crm_opp_stage == 'qualification'",
          "onClick": { "action": "command.execute", "args": { "command": "crm:advance_opp_to_proposal", "operationType": "update", "targetRecordPid": "${state.selectedOpportunity.pid}", "reload": ["opportunityStats", "opportunityQueue"] } }
        },
        {
          "code": "advance_to_negotiation",
          "permissionCode": "crm.opportunity.manage",
          "label": { "zh-CN": "进入商务谈判", "en": "Move to Negotiation" },
          "variant": "primary",
          "visibleWhen": "state.selectedOpportunity != null && state.selectedOpportunity.crm_opp_stage == 'proposal'",
          "onClick": { "action": "command.execute", "args": { "command": "crm:advance_opp_to_negotiation", "operationType": "update", "targetRecordPid": "${state.selectedOpportunity.pid}", "reload": ["opportunityStats", "opportunityQueue"] } }
        },
        {
          "code": "win_opportunity",
          "permissionCode": "crm.opportunity.manage",
          "label": { "zh-CN": "标记赢单", "en": "Mark Won" },
          "variant": "primary",
          "visibleWhen": "state.selectedOpportunity != null && state.selectedOpportunity.crm_opp_stage == 'negotiation'",
          "confirm": { "zh-CN": "确认客户已经作出真实购买承诺吗？", "en": "Confirm that the customer made a real buying commitment?" },
          "onClick": { "action": "command.execute", "args": { "command": "crm:win_opportunity", "operationType": "update", "targetRecordPid": "${state.selectedOpportunity.pid}", "reload": ["opportunityStats", "opportunityQueue"] } }
        },
        {
          "code": "lose_opportunity",
          "permissionCode": "crm.opportunity.manage",
          "label": { "zh-CN": "标记丢单", "en": "Mark Lost" },
          "variant": "danger",
          "visibleWhen": "state.selectedOpportunity != null",
          "confirm": { "zh-CN": "丢单后将退出在途队列，失败原因会保留用于复盘。确认继续吗？", "en": "The opportunity will leave the open queue and the loss reason will be retained for review. Continue?" },
          "onClick": {
            "action": "command.execute",
            "args": {
              "command": "crm:lose_opportunity",
              "operationType": "update",
              "targetRecordPid": "${state.selectedOpportunity.pid}",
              "inputFieldsTitle": { "zh-CN": "关闭商机并记录失败原因", "en": "Close Opportunity and Record Loss Reason" },
              "inputFieldsSubmitLabel": { "zh-CN": "确认丢单", "en": "Confirm Loss" },
              "inputFields": [
                {
                  "field": "crm_opp_lost_reason_code",
                  "label": { "zh-CN": "失败原因", "en": "Loss Reason" },
                  "type": "enum",
                  "dictCode": "crm_opp_lost_reason",
                  "required": true,
                  "placeholder": { "zh-CN": "选择最主要的失败原因", "en": "Select the primary loss reason" },
                  "helpText": { "zh-CN": "该原因会进入丢单分析；选择“输给对手”时请同时填写竞争对手。", "en": "This reason feeds loss analysis; identify the competitor when choosing Lost to Competitor." }
                },
                {
                  "field": "crm_opp_competitor",
                  "label": { "zh-CN": "竞争对手", "en": "Competitor" },
                  "type": "text",
                  "placeholder": { "zh-CN": "例如：华东智造云", "en": "For example: East China Manufacturing Cloud" },
                  "helpText": { "zh-CN": "仅在输给明确竞争对手时填写，便于后续竞品复盘。", "en": "Complete this only when a known competitor won the deal." }
                },
                {
                  "field": "crm_opp_lost_reason",
                  "label": { "zh-CN": "补充说明", "en": "Details" },
                  "type": "text",
                  "placeholder": { "zh-CN": "记录客户反馈、决策背景或后续重启条件", "en": "Record customer feedback, decision context, or restart conditions" },
                  "helpText": { "zh-CN": "请写可复盘的客户反馈与决策事实。", "en": "Capture reviewable customer feedback and decision facts." }
                }
              ],
              "reload": ["opportunityStats", "opportunityQueue"],
              "feedback": {
                "successMessage": { "zh-CN": "商机已关闭为丢单，失败原因已保存", "en": "Opportunity closed as lost and the reason was saved" },
                "errorMessage": { "zh-CN": "关闭失败。请检查商机状态和失败原因后重试", "en": "Close failed. Check the opportunity stage and loss reason, then retry" }
              }
            }
          }
        }
      ]
    },
    {
      "id": "crm_opportunity_context",
      "blockType": "evidence-panel",
      "context": "${state.selectedOpportunity}",
      "title": { "zh-CN": "商机决策上下文", "en": "Opportunity Decision Context" },
      "sections": [
        { "key": "code", "label": { "zh-CN": "商机编号", "en": "Opportunity Code" }, "field": "crm_opp_code" },
        { "key": "customer", "label": { "zh-CN": "客户", "en": "Customer" }, "field": "account_name" },
        { "key": "forecast", "label": { "zh-CN": "预测分类", "en": "Forecast Category" }, "field": "crm_opp_forecast_category" },
        { "key": "activity", "label": { "zh-CN": "最近互动", "en": "Last Activity" }, "field": "last_activity_at" },
        { "key": "risks", "label": { "zh-CN": "未结风险", "en": "Open Risks" }, "field": "open_risks" },
        { "key": "quotes", "label": { "zh-CN": "报价摘要", "en": "Quote Summaries" }, "field": "quote_count" }
      ],
      "empty": { "title": { "zh-CN": "选择一条商机，查看风险、活动、报价和下一步", "en": "Select an opportunity to review risks, activity, quotes and next action" } }
    },
    {
      "id": "crm_opportunity_daily_shortcuts",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "open_my_tasks",
          "permissionCode": "crm.activity.read",
          "label": { "zh-CN": "我的待办", "en": "My Tasks" },
          "action": { "type": "navigate", "to": "crm_my_tasks_list" }
        },
        {
          "code": "create_next_step",
          "permissionCode": "crm.activity.manage",
          "label": { "zh-CN": "创建下一步任务", "en": "Create Next-step Task" },
          "visibleWhen": "state.selectedOpportunity != null",
          "action": {
            "type": "navigate",
            "to": "/p/crm_activity_common/new?command=crm:create_opp_task&sourceRecordPid=${state.selectedOpportunity.pid}"
          }
        }
      ]
    }
  ]
}
