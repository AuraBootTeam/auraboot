{
  "pageKey": "crm_account_common_detail",
  "name:zh-CN": "客户详情",
  "name:en": "Account Detail",
  "modelCode": "crm_account_common",
  "description": "Account 360-degree view with contacts, opportunities, activities, complaints",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "extension": {
    "contributionSlots": [
      {
        "id": "commercial.blocks",
        "kind": "block",
        "anchor": {
          "target": "tab-blocks",
          "blockId": "crm_account_tabs",
          "tabKey": "quote_summaries"
        }
      }
    ]
  },
  "blocks": [
    {
      "id": "crm_account_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "overview",
          "label": {
            "zh-CN": "概览",
            "en-US": "Overview"
          },
          "blocks": [
            {
              "id": "section_basic",
              "blockType": "form-section",
              "title": {
                "zh-CN": "基本信息",
                "en-US": "Basic Information"
              },
              "columns": 2,
              "fields": [
                {
                  "field": "crm_acc_code",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_name",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_industry",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_website",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_phone",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_rating",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_status",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_owner",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_pool_state",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_last_pool_id",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_address",
                  "span": 2,
                  "readOnly": true
                },
                {
                  "field": "crm_acc_remark",
                  "span": 2,
                  "readOnly": true
                }
              ]
            }
          ]
        },
        {
          "key": "contacts",
          "label": {
            "zh-CN": "联系人",
            "en-US": "Contacts"
          },
          "blocks": [
            {
              "id": "block_contacts",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "联系人",
                "en-US": "Contacts"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_contact_common",
                "parentField": "crm_ct_account_id",
                "readOnly": false,
                "columns": [
                  {
                    "field": "crm_ct_name",
                    "width": 120
                  },
                  {
                    "field": "crm_ct_title",
                    "width": 120
                  },
                  {
                    "field": "crm_ct_owner",
                    "width": 150
                  },
                  {
                    "field": "crm_ct_email",
                    "width": 180
                  },
                  {
                    "field": "crm_ct_phone",
                    "width": 130
                  },
                  {
                    "field": "crm_ct_mobile",
                    "width": 130
                  },
                  {
                    "field": "crm_ct_is_primary",
                    "width": 100
                  },
                  {
                    "field": "crm_ct_status",
                    "width": 100,
                    "renderType": "tag",
                    "dictCode": "crm_contact_status"
                  }
                ],
                "actions": [
                  {
                    "code": "add",
                    "permissionCode": "crm.contact.manage",
                    "label": "$i18n:common.button.create",
                    "action": {
                      "type": "navigate",
                      "to": "crm_contact_common_form",
                      "command": "crm:create_contact"
                    }
                  },
                  {
                    "code": "edit",
                    "permissionCode": "crm.contact.manage",
                    "label": "$i18n:common.button.edit",
                    "action": {
                      "type": "navigate",
                      "to": "crm_contact_common_form",
                      "command": "crm:update_contact"
                    }
                  },
                  {
                    "code": "delete",
                    "danger": true,
                    "permissionCode": "crm.contact.manage",
                    "label": "$i18n:common.button.delete",
                    "action": {
                      "type": "command",
                      "command": "crm:delete_contact"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "relationships",
          "label": {
            "zh-CN": "客户关系",
            "en-US": "Relationships"
          },
          "blocks": [
            {
              "id": "crm_account_relationship_actions",
              "blockType": "toolbar",
              "buttons": [
                {
                  "code": "add",
                  "primary": true,
                  "permissionCode": "crm.account.manage",
                  "label": { "zh-CN": "新增关系", "en-US": "Add Relationship" },
                  "action": { "type": "navigate", "to": "crm_account_relation_common_form", "command": "crm:create_account_relation" }
                }
              ]
            },
            {
              "id": "block_outgoing_relationships",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "我方定义的关系",
                "en-US": "Relationships Defined Here"
              },
              "description": {
                "zh-CN": "从当前客户指向其他客户，可新增、编辑或删除；同一事实会自动出现在对方客户的反向关系中。",
                "en-US": "Relationships from this account to another account. The same fact appears automatically on the related account."
              },
              "layout": { "colSpan": 12 },
              "subTable": {
                "childModel": "crm_account_relation_common",
                "parentField": "crm_acr_source_account_id",
                "readOnly": false,
                "columns": [
                  { "field": "crm_acr_target_account_id", "width": 220 },
                  { "field": "crm_acr_relation_type", "width": 130, "renderType": "tag", "dictCode": "crm_account_relation_type" },
                  { "field": "crm_acr_strength", "width": 110, "renderType": "tag", "dictCode": "crm_account_relation_strength" },
                  { "field": "crm_acr_status", "width": 100, "renderType": "tag", "dictCode": "crm_account_relation_status" },
                  { "field": "crm_acr_effective_to", "width": 120, "label": { "zh-CN": "有效至", "en-US": "Valid Until" } }
                ],
                "actions": [
                  {
                    "code": "view",
                    "label": "$i18n:common.button.view",
                    "action": { "type": "navigate", "to": "crm_account_relation_common_detail" }
                  },
                  {
                    "code": "edit",
                    "label": "$i18n:common.button.edit",
                    "action": { "type": "navigate", "to": "crm_account_relation_common_form", "command": "crm:update_account_relation" }
                  },
                  {
                    "code": "delete",
                    "danger": true,
                    "label": "$i18n:common.button.delete",
                    "confirm": { "zh-CN": "确认删除此客户关系？", "en-US": "Delete this account relationship?" },
                    "action": { "type": "command", "command": "crm:delete_account_relation" }
                  }
                ]
              }
            },
            {
              "id": "block_incoming_relationships",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "其他客户指向我方",
                "en-US": "Relationships Pointing Here"
              },
              "description": {
                "zh-CN": "由其他客户维护的反向关系，在当前客户侧只读展示，避免复制和双向漂移。",
                "en-US": "Reverse relationships maintained from the other account, shown read-only to avoid duplicate facts."
              },
              "layout": { "colSpan": 12 },
              "subTable": {
                "childModel": "crm_account_relation_common",
                "parentField": "crm_acr_target_account_id",
                "readOnly": true,
                "columns": [
                  { "field": "crm_acr_source_account_id", "width": 220 },
                  { "field": "crm_acr_relation_type", "width": 130, "renderType": "tag", "dictCode": "crm_account_relation_type" },
                  { "field": "crm_acr_strength", "width": 110, "renderType": "tag", "dictCode": "crm_account_relation_strength" },
                  { "field": "crm_acr_status", "width": 100, "renderType": "tag", "dictCode": "crm_account_relation_status" },
                  { "field": "crm_acr_effective_to", "width": 120, "label": { "zh-CN": "有效至", "en-US": "Valid Until" } }
                ],
                "actions": [
                  {
                    "code": "view",
                    "label": "$i18n:common.button.view",
                    "action": { "type": "navigate", "to": "crm_account_relation_common_detail" }
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "opportunities",
          "label": {
            "zh-CN": "商机",
            "en-US": "Opportunities"
          },
          "blocks": [
            {
              "id": "block_opportunities",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "商机",
                "en-US": "Opportunities"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_opportunity_common",
                "parentField": "crm_opp_account_id",
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_opp_code",
                    "width": 140
                  },
                  {
                    "field": "crm_opp_name",
                    "width": 200
                  },
                  {
                    "field": "crm_opp_stage",
                    "width": 120,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_opp_expected_amount",
                    "width": 140
                  },
                  {
                    "field": "crm_opp_expected_close_date",
                    "width": 140
                  },
                  {
                    "field": "crm_opp_owner",
                    "width": 120
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "complaints",
          "label": {
            "zh-CN": "投诉",
            "en-US": "Complaints"
          },
          "blocks": [
            {
              "id": "block_complaints",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "投诉",
                "en-US": "Complaints"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_complaint",
                "parentField": "crm_cmp_account_id",
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_cmp_code",
                    "width": 140
                  },
                  {
                    "field": "crm_cmp_type",
                    "width": 120,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_cmp_severity",
                    "width": 100,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_cmp_status",
                    "width": 100,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_cmp_date",
                    "width": 160
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "customer_requests",
          "label": {
            "zh-CN": "客户需求",
            "en-US": "Requests"
          },
          "blocks": [
            {
              "id": "block_customer_requests",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "客户需求",
                "en-US": "Customer Requests"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_customer_request_common",
                "parentField": "crm_cr_account_id",
                "readOnly": false,
                "columns": [
                  {
                    "field": "crm_cr_code",
                    "width": 150
                  },
                  {
                    "field": "crm_cr_title",
                    "width": 240
                  },
                  {
                    "field": "crm_cr_type",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_customer_request_type"
                  },
                  {
                    "field": "crm_cr_status",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_customer_request_status"
                  },
                  {
                    "field": "crm_cr_route_status",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_customer_request_route_status"
                  },
                  {
                    "field": "crm_cr_expected_date",
                    "width": 140
                  },
                  {
                    "field": "crm_cr_owner",
                    "width": 120
                  }
                ],
                "actions": [
                  {
                    "code": "add",
                    "label": "$i18n:common.button.create",
                    "action": {
                      "type": "navigate",
                      "to": "crm_customer_request_common_form",
                      "command": "crm:create_customer_request"
                    }
                  },
                  {
                    "code": "view",
                    "label": "$i18n:common.button.view",
                    "action": {
                      "type": "navigate",
                      "to": "crm_customer_request_common_detail"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "quote_summaries",
          "label": {
            "zh-CN": "报价与商业",
            "en-US": "Quotes & Commercial"
          },
          "blocks": [
            {
              "id": "block_quote_summaries",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "报价摘要",
                "en-US": "Quote Summaries"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_quote_summary_common",
                "parentField": "crm_qs_account_id",
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_qs_code",
                    "width": 150
                  },
                  {
                    "field": "crm_qs_customer_request_id",
                    "width": 180
                  },
                  {
                    "field": "crm_qs_source_quote_type",
                    "width": 140,
                    "renderType": "tag",
                    "dictCode": "crm_quote_summary_source_type"
                  },
                  {
                    "field": "crm_qs_status",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_quote_summary_status"
                  },
                  {
                    "field": "crm_qs_quote_amount",
                    "width": 140,
                    "align": "right"
                  },
                  {
                    "field": "crm_qs_currency",
                    "width": 100,
                    "renderType": "tag",
                    "dictCode": "crm_currency_code"
                  },
                  {
                    "field": "crm_qs_valid_until",
                    "width": 120
                  },
                  {
                    "field": "crm_qs_won_lost_result",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_quote_summary_result"
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "follow_plans",
          "label": {
            "zh-CN": "客户计划",
            "en-US": "Customer Plans"
          },
          "blocks": [
            {
              "id": "crm_account_plan_actions",
              "blockType": "toolbar",
              "buttons": [
                {
                  "code": "create_plan",
                  "primary": true,
                  "permissionCode": "crm.activity.manage",
                  "label": { "zh-CN": "新建客户计划", "en-US": "New Customer Plan" },
                  "action": {
                    "type": "navigate",
                    "to": "crm_activity_common_form",
                    "command": "crm:create_account_task"
                  }
                }
              ]
            },
            {
              "id": "block_account_follow_plans",
              "blockType": "sub-table",
              "title": { "zh-CN": "计划与执行状态", "en-US": "Plans and Execution" },
              "description": {
                "zh-CN": "集中查看与当前客户直接关联的计划；跨联系人、商机的互动仍保留在活动时间线。",
                "en-US": "Plans directly related to this account. Cross-contact and opportunity interactions remain in the activity timeline."
              },
              "layout": { "colSpan": 12 },
              "subTable": {
                "dataSource": {
                  "type": "api",
                  "url": "/api/datasource/list",
                  "params": {
                    "datasourceId": "nq:crm_activities_by_object",
                    "objectType": "account",
                    "objectId": "${recordPid}",
                    "format": "records"
                  }
                },
                "readOnly": true,
                "maxHeight": 320,
                "columns": [
                  { "field": "crm_act_subject", "width": 280 },
                  { "field": "crm_act_status", "width": 110, "renderType": "tag", "dictCode": "crm_task_status" },
                  { "field": "crm_act_priority", "width": 105, "renderType": "tag", "dictCode": "crm_task_priority" },
                  { "field": "crm_act_due_date", "width": 125, "valueType": "date" },
                  { "field": "owner_name", "width": 140, "label": { "zh-CN": "负责人", "en-US": "Owner" } }
                ],
                "actions": [
                  { "code": "view_task", "permissionCode": "crm.activity.read", "label": { "zh-CN": "查看", "en-US": "View" }, "action": { "type": "navigate", "to": "crm_activity_common_detail" } },
                  { "code": "start_task", "permissionCode": "crm.activity.manage", "visibleWhen": "row.crm_act_type === 'task' && row.crm_act_status === 'open'", "label": { "zh-CN": "开始", "en-US": "Start" }, "action": { "type": "state_transition", "command": "crm:start_task" } },
                  { "code": "complete_task", "permissionCode": "crm.activity.manage", "visibleWhen": "row.crm_act_type === 'task' && (row.crm_act_status === 'open' || row.crm_act_status === 'in_progress')", "label": { "zh-CN": "完成", "en-US": "Complete" }, "action": { "type": "state_transition", "command": "crm:complete_task" } },
                  { "code": "cancel_task", "permissionCode": "crm.activity.manage", "danger": true, "visibleWhen": "row.crm_act_type === 'task' && (row.crm_act_status === 'open' || row.crm_act_status === 'in_progress')", "label": { "zh-CN": "取消", "en-US": "Cancel" }, "confirm": { "zh-CN": "确定取消该客户计划？取消后不可再开始或完成。", "en-US": "Cancel this customer plan? It cannot be started or completed afterwards." }, "action": { "type": "state_transition", "command": "crm:cancel_task" } }
                ]
              }
            }
          ]
        },
        {
          "key": "activities",
          "label": {
            "zh-CN": "活动",
            "en-US": "Activities"
          },
          "blocks": [
            {
              "id": "block_activities",
              "blockType": "activity-timeline",
              "title": {
                "zh-CN": "活动",
                "en-US": "Activities"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "dataSource": {
                  "type": "api",
                  "url": "/api/datasource/list",
                  "params": {
                    "datasourceId": "nq:crm_account_timeline",
                    "objectId": "${recordPid}",
                    "format": "records"
                  }
                },
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_act_type",
                    "width": 100,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_act_subject",
                    "width": 200
                  },
                  {
                    "field": "crm_act_date",
                    "width": 160,
                    "format": "YYYY-MM-DD HH:mm"
                  },
                  {
                    "field": "crm_act_owner",
                    "width": 120
                  },
                  {
                    "field": "crm_ar_object_type",
                    "width": 100,
                    "renderType": "tag"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "crm_account_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "edit",
          "icon": "Edit",
          "permissionCode": "crm.account.manage",
          "label": "$i18n:common.button.edit",
          "action": {
            "type": "navigate",
            "to": "crm_account_common_form"
          }
        },
        {
          "code": "log_activity",
          "icon": "MessageSquare",
          "label": {
            "zh-CN": "记录跟进",
            "en-US": "Log Follow-up"
          },
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:log_account_activity"
          }
        },
        {
          "code": "create_task",
          "icon": "CheckSquare",
          "label": {
            "zh-CN": "新建计划",
            "en-US": "New Follow-up Plan"
          },
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:create_account_task"
          }
        },
        {
          "code": "view_360",
          "label": "$i18n:common.button.view",
          "icon": "BarChart2",
          "variant": "default",
          "action": {
            "type": "navigate",
            "to": "/dashboards/view/crm_account_360?recordPid={pid}"
          }
        },
        {
          "code": "merge",
          "icon": "Combine",
          "permissionCode": "crm.account.manage",
          "label": { "zh-CN": "合并客户", "en-US": "Merge Account" },
          "action": {
            "type": "command",
            "command": "crm:merge_account",
            "operationType": "update",
            "inputFieldsTitle": { "zh-CN": "合并到目标客户", "en-US": "Merge into Account" },
            "inputFieldsSubmitLabel": { "zh-CN": "确认合并", "en-US": "Confirm Merge" },
            "inputFields": [
              {
                "field": "targetAccountId",
                "label": { "zh-CN": "保留的目标客户", "en-US": "Surviving Account" },
                "type": "select",
                "searchable": true,
                "dataSource": {
                  "type": "api",
                  "endpoint": "/api/dynamic/crm_account_common/list",
                  "params": { "pageNum": 1, "pageSize": 200 },
                  "valueField": "pid",
                  "labelField": "crm_acc_name"
                },
                "required": true,
                "helpText": {
                  "zh-CN": "当前客户会被删除，所有关联业务记录迁移到目标客户。",
                  "en-US": "The current account is removed after all related records move to the target."
                }
              }
            ]
          }
        },
        {
          "code": "recompute_health",
          "icon": "Activity",
          "permissionCode": "crm.account.manage",
          "label": "$i18n:crm.account.recompute",
          "action": {
            "type": "command",
            "command": "crm:recompute_health"
          }
        },
        {
          "code": "move_to_customer_pool",
          "icon": "Waves",
          "permissionCode": "crm.customer_pool.move",
          "label": { "zh-CN": "移入客户公海", "en": "Move to Public Pool" },
          "visibleWhen": "record.crm_acc_pool_state != 'in_pool' && record.crm_acc_status == 'active'",
          "action": {
            "type": "command",
            "command": "crm:move_customer_to_pool"
          }
        }
      ]
    }
  ]
}
