{
  "pageKey": "crm_account_common_detail",
  "name:zh-CN": "客户详情",
  "name:en": "Account Detail",
  "modelCode": "crm_account_common",
  "description": "Account 360-degree view with contacts, opportunities, activities, complaints",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "crm_account_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "overview",
          "label": {
            "zh-CN": "概览",
            "en-US": "Overview"
          },
          "blocks": [
            {
              "id": "section_basic",
              "blockType": "form-section",
              "title": {
                "zh-CN": "基本信息",
                "en-US": "Basic Information"
              },
              "columns": 2,
              "fields": [
                {
                  "field": "crm_acc_code",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_name",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_industry",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_website",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_phone",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_rating",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_status",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_owner",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_pool_state",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_last_pool_id",
                  "readOnly": true
                },
                {
                  "field": "crm_acc_address",
                  "span": 2,
                  "readOnly": true
                },
                {
                  "field": "crm_acc_remark",
                  "span": 2,
                  "readOnly": true
                }
              ]
            }
          ]
        },
        {
          "key": "contacts",
          "label": {
            "zh-CN": "联系人",
            "en-US": "Contacts"
          },
          "blocks": [
            {
              "id": "block_contacts",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "联系人",
                "en-US": "Contacts"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_contact_common",
                "parentField": "crm_ct_account_id",
                "readOnly": false,
                "columns": [
                  {
                    "field": "crm_ct_name",
                    "width": 120
                  },
                  {
                    "field": "crm_ct_title",
                    "width": 120
                  },
                  {
                    "field": "crm_ct_email",
                    "width": 180
                  },
                  {
                    "field": "crm_ct_phone",
                    "width": 130
                  },
                  {
                    "field": "crm_ct_mobile",
                    "width": 130
                  },
                  {
                    "field": "crm_ct_is_primary",
                    "width": 100
                  }
                ],
                "actions": [
                  {
                    "code": "add",
                    "label": "$i18n:common.button.create",
                    "action": {
                      "type": "navigate",
                      "to": "crm_contact_common_form",
                      "command": "crm:create_contact"
                    }
                  },
                  {
                    "code": "edit",
                    "label": "$i18n:common.button.edit",
                    "action": {
                      "type": "navigate",
                      "to": "crm_contact_common_form",
                      "command": "crm:update_contact"
                    }
                  },
                  {
                    "code": "delete",
                    "danger": true,
                    "label": "$i18n:common.button.delete",
                    "action": {
                      "type": "command",
                      "command": "crm:delete_contact"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "opportunities",
          "label": {
            "zh-CN": "商机",
            "en-US": "Opportunities"
          },
          "blocks": [
            {
              "id": "block_opportunities",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "商机",
                "en-US": "Opportunities"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_opportunity_common",
                "parentField": "crm_opp_account_id",
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_opp_code",
                    "width": 140
                  },
                  {
                    "field": "crm_opp_name",
                    "width": 200
                  },
                  {
                    "field": "crm_opp_stage",
                    "width": 120,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_opp_expected_amount",
                    "width": 140
                  },
                  {
                    "field": "crm_opp_expected_close_date",
                    "width": 140
                  },
                  {
                    "field": "crm_opp_owner",
                    "width": 120
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "complaints",
          "label": {
            "zh-CN": "投诉",
            "en-US": "Complaints"
          },
          "blocks": [
            {
              "id": "block_complaints",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "投诉",
                "en-US": "Complaints"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_complaint",
                "parentField": "crm_cmp_account_id",
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_cmp_code",
                    "width": 140
                  },
                  {
                    "field": "crm_cmp_type",
                    "width": 120,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_cmp_severity",
                    "width": 100,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_cmp_status",
                    "width": 100,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_cmp_date",
                    "width": 160
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "customer_requests",
          "label": {
            "zh-CN": "客户需求",
            "en-US": "Requests"
          },
          "blocks": [
            {
              "id": "block_customer_requests",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "客户需求",
                "en-US": "Customer Requests"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_customer_request_common",
                "parentField": "crm_cr_account_id",
                "readOnly": false,
                "columns": [
                  {
                    "field": "crm_cr_code",
                    "width": 150
                  },
                  {
                    "field": "crm_cr_title",
                    "width": 240
                  },
                  {
                    "field": "crm_cr_type",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_customer_request_type"
                  },
                  {
                    "field": "crm_cr_status",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_customer_request_status"
                  },
                  {
                    "field": "crm_cr_route_status",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_customer_request_route_status"
                  },
                  {
                    "field": "crm_cr_expected_date",
                    "width": 140
                  },
                  {
                    "field": "crm_cr_owner",
                    "width": 120
                  }
                ],
                "actions": [
                  {
                    "code": "add",
                    "label": "$i18n:common.button.create",
                    "action": {
                      "type": "navigate",
                      "to": "crm_customer_request_common_form",
                      "command": "crm:create_customer_request"
                    }
                  },
                  {
                    "code": "view",
                    "label": "$i18n:common.button.view",
                    "action": {
                      "type": "navigate",
                      "to": "crm_customer_request_common_detail"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "quote_summaries",
          "label": {
            "zh-CN": "报价摘要",
            "en-US": "Quote Summaries"
          },
          "blocks": [
            {
              "id": "block_quote_summaries",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "报价摘要",
                "en-US": "Quote Summaries"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_quote_summary_common",
                "parentField": "crm_qs_account_id",
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_qs_code",
                    "width": 150
                  },
                  {
                    "field": "crm_qs_customer_request_id",
                    "width": 180
                  },
                  {
                    "field": "crm_qs_source_quote_type",
                    "width": 140,
                    "renderType": "tag",
                    "dictCode": "crm_quote_summary_source_type"
                  },
                  {
                    "field": "crm_qs_status",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_quote_summary_status"
                  },
                  {
                    "field": "crm_qs_quote_amount",
                    "width": 140,
                    "align": "right"
                  },
                  {
                    "field": "crm_qs_currency",
                    "width": 100,
                    "renderType": "tag",
                    "dictCode": "crm_currency_code"
                  },
                  {
                    "field": "crm_qs_valid_until",
                    "width": 120
                  },
                  {
                    "field": "crm_qs_won_lost_result",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_quote_summary_result"
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "activities",
          "label": {
            "zh-CN": "活动",
            "en-US": "Activities"
          },
          "blocks": [
            {
              "id": "block_activities",
              "blockType": "activity-timeline",
              "title": {
                "zh-CN": "活动",
                "en-US": "Activities"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "dataSource": {
                  "type": "api",
                  "url": "/api/datasource/list",
                  "params": {
                    "datasourceId": "nq:crm_account_timeline",
                    "objectId": "${recordPid}",
                    "format": "records"
                  }
                },
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_act_type",
                    "width": 100,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_act_subject",
                    "width": 200
                  },
                  {
                    "field": "crm_act_date",
                    "width": 160,
                    "format": "YYYY-MM-DD HH:mm"
                  },
                  {
                    "field": "crm_act_owner",
                    "width": 120
                  },
                  {
                    "field": "crm_ar_object_type",
                    "width": 100,
                    "renderType": "tag"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "crm_account_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "edit",
          "icon": "Edit",
          "permissionCode": "crm.account.manage",
          "label": "$i18n:common.button.edit",
          "action": {
            "type": "navigate",
            "to": "crm_account_common_form"
          }
        },
        {
          "code": "log_activity",
          "icon": "MessageSquare",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:log_account_activity"
          }
        },
        {
          "code": "create_task",
          "icon": "CheckSquare",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:create_account_task"
          }
        },
        {
          "code": "view_360",
          "label": "$i18n:common.button.view",
          "icon": "BarChart2",
          "variant": "default",
          "action": {
            "type": "navigate",
            "to": "/dashboards/view/crm_account_360?recordPid={pid}"
          }
        },
        {
          "code": "recompute_health",
          "icon": "Activity",
          "permissionCode": "crm.account.manage",
          "label": "$i18n:crm.account.recompute",
          "action": {
            "type": "command",
            "command": "crm:recompute_health"
          }
        },
        {
          "code": "move_to_customer_pool",
          "icon": "Waves",
          "permissionCode": "crm.customer_pool.move",
          "label": { "zh-CN": "移入客户公海", "en": "Move to Public Pool" },
          "visibleWhen": "record.crm_acc_pool_state != 'in_pool' && record.crm_acc_status == 'active'",
          "action": {
            "type": "command",
            "command": "crm:move_customer_to_pool"
          }
        }
      ]
    }
  ]
}
