{
  "pageKey": "crm_customer_pool_batch_list",
  "name:zh-CN": "客户公海批量处理",
  "name:en": "Customer Pool Batch Operations",
  "modelCode": "crm_customer_pool_item_common",
  "kind": "list",
  "schemaVersion": 4,
  "layout": { "type": "grid", "cols": 12 },
  "blocks": [
    {
      "id": "batch_guidance",
      "blockType": "description",
      "content": {
        "zh-CN": "<h3>批量治理公海客户</h3><p>可领取、分配、更新、导出或永久删除所选客户。系统逐条校验成员资格、冷却、容量、并发和业务引用，并明确报告每条结果。</p>",
        "en": "<h3>Govern pooled customers in bulk</h3><p>Claim, assign, update, export, or permanently delete selected customers. Membership, cooldown, capacity, concurrency, and business references are validated per record with explicit results.</p>"
      }
    },
    {
      "id": "pool_tabs",
      "blockType": "tabs",
      "tabs": [
        { "key": "available", "label": { "zh-CN": "待领取", "en": "Available" }, "filter": { "field": "crm_cpi_status", "value": "available", "operator": "EQ" } },
        { "key": "claimed", "label": { "zh-CN": "已领取", "en": "Claimed" }, "filter": { "field": "crm_cpi_status", "value": "claimed", "operator": "EQ" } },
        { "key": "assigned", "label": { "zh-CN": "已分配", "en": "Assigned" }, "filter": { "field": "crm_cpi_status", "value": "assigned", "operator": "EQ" } }
      ]
    },
    {
      "id": "pool_queue",
      "blockType": "table",
      "table": {
        "selection": { "mode": "multiple", "bind": "{{state.selectedIds}}" },
        "bulkCapabilities": { "edit": false, "delete": false, "export": { "permissionCode": "crm.customer_pool.read" } },
        "empty": {
          "title": { "zh-CN": "没有可批量处理的公海客户", "en": "No pooled customers are available for batch processing" },
          "description": { "zh-CN": "调整状态筛选，或从客户列表将活跃客户移入已启用的公海池。", "en": "Adjust the status filter or move active customers from the customer list into an enabled pool." }
        },
        "bulkActions": [
          { "code": "batch_claim", "permissionCode": "crm.customer_pool.pick", "label": { "zh-CN": "批量领取", "en": "Claim Selected" }, "confirm": { "zh-CN": "容量、每日上限与冷却规则将逐条校验。确认领取？", "en": "Capacity, daily limit and cooldown rules will be enforced. Continue?" }, "action": { "type": "bulk_state_transition", "command": "crm:claim_pool_customer" } },
          { "code": "batch_assign", "permissionCode": "crm.customer_pool.assign", "label": { "zh-CN": "批量分配", "en": "Assign Selected" }, "action": { "type": "bulk_field_command", "command": "crm:assign_pool_customer", "input": { "field": "crm_cpi_claimed_by", "label": { "zh-CN": "分配给", "en": "Assign To" }, "type": "reference", "component": "MemberPicker", "required": true, "placeholder": { "zh-CN": "选择该公海池内的销售成员", "en": "Select a sales member in this pool" }, "helpText": { "zh-CN": "系统逐条校验成员资格、客户库容和并发状态，并返回每条结果。", "en": "Membership, customer capacity, and concurrency are validated per customer with explicit results." }, "props": { "multiple": false } } } },
          { "code": "batch_update_name", "permissionCode": "crm.customer_pool.manage", "label": { "zh-CN": "批量修改客户名称", "en": "Update Customer Names" }, "action": { "type": "bulk_field_command", "command": "crm:update_pool_customer", "input": { "field": "crm_acc_name", "label": { "zh-CN": "客户名称", "en": "Customer Name" }, "type": "string", "component": "SmartInput", "required": true } } },
          { "code": "batch_update_industry", "permissionCode": "crm.customer_pool.manage", "label": { "zh-CN": "批量修改行业", "en": "Update Industries" }, "action": { "type": "bulk_field_command", "command": "crm:update_pool_customer", "input": { "field": "crm_acc_industry", "label": { "zh-CN": "行业", "en": "Industry" }, "type": "enum", "dictCode": "crm_account_industry", "required": true } } },
          { "code": "batch_update_rating", "permissionCode": "crm.customer_pool.manage", "label": { "zh-CN": "批量修改评级", "en": "Update Ratings" }, "action": { "type": "bulk_field_command", "command": "crm:update_pool_customer", "input": { "field": "crm_acc_rating", "label": { "zh-CN": "评级", "en": "Rating" }, "type": "enum", "dictCode": "crm_account_rating", "required": true } } },
          { "code": "batch_delete", "permissionCode": "crm.customer_pool.manage", "variant": "danger", "label": { "zh-CN": "永久删除", "en": "Permanently Delete" }, "confirm": { "zh-CN": "将永久删除所选客户及其公海记录；存在联系人或商机引用的客户会被拒绝。确认继续？", "en": "Permanently delete the selected customers and pool records? Customers referenced by contacts or opportunities will be rejected." }, "action": { "type": "bulk_record_command", "command": "crm:delete_pool_customer", "operationType": "DELETE" } }
        ]
      },
      "columns": [
        { "field": "crm_cpi_pool_id", "width": 180 },
        { "field": "crm_cpi_account_name", "width": 220, "sortable": true },
        { "field": "crm_cpi_rating", "width": 130 },
        { "field": "crm_cpi_industry", "width": 120, "renderType": "tag", "dictCode": "crm_account_industry" },
        { "field": "crm_cpi_health_score", "width": 90, "align": "right", "sortable": true },
        { "field": "crm_cpi_previous_owner", "width": 140 },
        { "field": "crm_cpi_entered_at", "width": 170, "sortable": true },
        { "field": "crm_cpi_claim_release_at", "width": 170 },
        {
          "field": "actions",
          "isActionColumn": true,
          "label": "$i18n:common.actions",
          "buttons": [
            { "code": "view_pool_evidence", "label": { "zh-CN": "池内详情", "en": "Pool Detail" }, "action": { "type": "navigate", "to": "crm_customer_pool_item_detail" } },
            { "code": "open_customer", "label": { "zh-CN": "查看客户", "en": "View Customer" }, "action": { "type": "navigate", "to": "/p/crm_account_common/view/${row.crm_cpi_account_id}" } },
            { "code": "claim", "permissionCode": "crm.customer_pool.pick", "label": { "zh-CN": "领取", "en": "Claim" }, "visibleWhen": "row.crm_cpi_status == 'available'", "action": { "type": "command", "command": "crm:claim_pool_customer" } },
            { "code": "assign", "permissionCode": "crm.customer_pool.assign", "label": { "zh-CN": "分配", "en": "Assign" }, "visibleWhen": "row.crm_cpi_status == 'available'", "action": { "type": "command", "command": "crm:assign_pool_customer", "operationType": "update", "inputFieldsTitle": { "zh-CN": "分配客户", "en": "Assign Customer" }, "inputFields": [ { "field": "crm_cpi_claimed_by", "label": { "zh-CN": "分配给", "en": "Assign To" }, "type": "reference", "component": "MemberPicker", "required": true, "placeholder": { "zh-CN": "选择该公海池内的销售成员", "en": "Select a sales member in this pool" }, "helpText": { "zh-CN": "分配会校验成员资格与客户库容，并立即更新责任归属。", "en": "Assignment validates membership and capacity, then updates ownership immediately." }, "props": { "multiple": false } } ] } },
            { "code": "quick_update", "permissionCode": "crm.customer_pool.manage", "label": { "zh-CN": "快速编辑", "en": "Quick Edit" }, "action": { "type": "command", "command": "crm:update_pool_customer", "operationType": "update", "inputFieldsTitle": { "zh-CN": "快速编辑公海客户", "en": "Quickly Edit Pooled Customer" }, "inputFieldsSubmitLabel": { "zh-CN": "保存客户", "en": "Save Customer" }, "inputFields": [
              { "field": "crm_cpi_account_name", "label": { "zh-CN": "客户名称", "en": "Customer Name" }, "type": "string", "required": true, "defaultValue": "${row.crm_cpi_account_name}", "placeholder": { "zh-CN": "输入客户工商或常用名称", "en": "Enter the legal or commonly used customer name" }, "helpText": { "zh-CN": "保存后会同步更新客户主档与公海列表快照。", "en": "Saving updates both the customer record and the pool-list snapshot." } },
              { "field": "crm_cpi_industry", "label": { "zh-CN": "行业", "en": "Industry" }, "type": "enum", "dictCode": "crm_account_industry", "defaultValue": "${row.crm_cpi_industry}", "placeholder": { "zh-CN": "选择客户所属行业", "en": "Select the customer industry" }, "helpText": { "zh-CN": "行业用于筛选、分配和客户结构分析。", "en": "Industry drives filtering, assignment, and portfolio analysis." } },
              { "field": "crm_cpi_phone", "label": { "zh-CN": "电话", "en": "Phone" }, "type": "string", "defaultValue": "${row.crm_cpi_phone}", "placeholder": { "zh-CN": "例如：0755-12345678", "en": "For example: 0755-12345678" }, "helpText": { "zh-CN": "填写客户公司的主要联系电话。", "en": "Enter the primary company telephone number." } },
              { "field": "crm_cpi_rating", "label": { "zh-CN": "评级", "en": "Rating" }, "type": "enum", "dictCode": "crm_account_rating", "defaultValue": "${row.crm_cpi_rating}", "placeholder": { "zh-CN": "按合作价值选择 A、B、C 或 D 级", "en": "Choose A, B, C, or D based on account value" }, "helpText": { "zh-CN": "评级会同步到客户主档并用于公海优先级判断。", "en": "The rating is synchronized to the customer record and used for pool prioritization." } }
            ] } },
            { "code": "delete", "permissionCode": "crm.customer_pool.manage", "danger": true, "label": { "zh-CN": "永久删除", "en": "Permanently Delete" }, "confirm": { "zh-CN": "将永久删除客户及其公海记录；存在联系人或商机引用时会阻止删除。确认继续？", "en": "Permanently delete this customer and its pool record? Related contacts or opportunities block deletion." }, "action": { "type": "command", "command": "crm:delete_pool_customer", "operationType": "DELETE" } }
          ]
        }
      ],
      "searchFields": ["crm_cpi_account_name", "crm_cpi_rating", "crm_cpi_account_code"],
      "searchPlaceholder": { "zh-CN": "搜索客户名称、编号或评级", "en": "Search customer name, code, or rating" },
      "empty": {
        "title": { "zh-CN": "没有可批量处理的公海客户", "en": "No pooled customers are available for batch processing" },
        "description": { "zh-CN": "调整状态筛选，或从客户列表将活跃客户移入已启用的公海池。", "en": "Adjust the status filter or move active customers from the customer list into an enabled pool." }
      },
      "defaultSort": { "field": "crm_cpi_entered_at", "order": "desc" }
    }
  ]
}
