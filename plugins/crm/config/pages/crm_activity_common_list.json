{
  "pageKey": "crm_activity_common_list",
  "name:zh-CN": "活动列表",
  "name:en": "Activities",
  "modelCode": "crm_activity_common",
  "kind": "list",
  "schemaVersion": 4,
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "crm_act_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "all",
          "label": {
            "en": "All",
            "zh-CN": "全部"
          },
          "filter": null
        },
        {
          "key": "follow_plans",
          "label": {
            "en-US": "Follow-up Plans",
            "zh-CN": "跟进计划"
          },
          "filter": {
            "field": "crm_act_type",
            "value": "task",
            "operator": "EQ"
          }
        },
        {
          "key": "follow_records",
          "label": {
            "en-US": "Follow-up Records",
            "zh-CN": "跟进记录"
          },
          "filter": {
            "field": "crm_act_type",
            "value": [
              "call",
              "email",
              "meeting",
              "note",
              "visit"
            ],
            "operator": "IN"
          }
        },
        {
          "key": "task",
          "label": {
            "en": "Tasks",
            "zh-CN": "任务"
          },
          "filter": {
            "field": "crm_act_type",
            "value": "task",
            "operator": "EQ"
          }
        },
        {
          "key": "call",
          "label": {
            "en": "Calls",
            "zh-CN": "电话"
          },
          "filter": {
            "field": "crm_act_type",
            "value": "call",
            "operator": "EQ"
          }
        },
        {
          "key": "email",
          "label": {
            "en": "Emails",
            "zh-CN": "邮件"
          },
          "filter": {
            "field": "crm_act_type",
            "value": "email",
            "operator": "EQ"
          }
        },
        {
          "key": "meeting",
          "label": {
            "en": "Meetings",
            "zh-CN": "会议"
          },
          "filter": {
            "field": "crm_act_type",
            "value": "meeting",
            "operator": "EQ"
          }
        },
        {
          "key": "note",
          "label": {
            "en": "Notes",
            "zh-CN": "笔记"
          },
          "filter": {
            "field": "crm_act_type",
            "value": "note",
            "operator": "EQ"
          }
        },
        {
          "key": "visit",
          "label": {
            "en": "Visits",
            "zh-CN": "拜访"
          },
          "filter": {
            "field": "crm_act_type",
            "value": "visit",
            "operator": "EQ"
          }
        }
      ]
    },
    {
      "id": "crm_act_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "permissionCode": "crm.activity.manage",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:create_activity"
          }
        }
      ]
    },
    {
      "id": "crm_act_table",
      "blockType": "table",
      "table": {
        "selection": {
          "mode": "multiple",
          "bind": "{{state.selectedIds}}"
        },
        "bulkCapabilities": {
          "edit": {
            "permissionCode": "crm.activity.manage"
          },
          "export": {
            "permissionCode": "crm.activity.read"
          }
        },
        "bulkActions": [
          {
            "code": "bulk_start",
            "permissionCode": "crm.activity.manage",
            "label": {
              "zh-CN": "批量开始任务",
              "en-US": "Start Selected Tasks"
            },
            "action": {
              "type": "bulk_state_transition",
              "command": "crm:start_task"
            }
          },
          {
            "code": "bulk_complete",
            "permissionCode": "crm.activity.manage",
            "label": {
              "zh-CN": "批量完成任务",
              "en-US": "Complete Selected Tasks"
            },
            "action": {
              "type": "bulk_state_transition",
              "command": "crm:complete_task"
            }
          },
          {
            "code": "bulk_cancel",
            "permissionCode": "crm.activity.manage",
            "variant": "danger",
            "label": {
              "zh-CN": "批量取消任务",
              "en-US": "Cancel Selected Tasks"
            },
            "confirm": {
              "zh-CN": "确定取消选中的任务吗？非任务活动和不符合状态的记录会被拒绝。",
              "en-US": "Cancel selected tasks? Non-task activities and invalid states will be rejected."
            },
            "action": {
              "type": "bulk_state_transition",
              "command": "crm:cancel_task"
            }
          }
        ]
      },
      "columns": [
        {
          "field": "crm_act_type",
          "width": 100,
          "renderType": "tag",
          "dictCode": "crm_activity_type"
        },
        {
          "field": "crm_act_subject",
          "width": 250,
          "sortable": true
        },
        {
          "field": "crm_act_date",
          "width": 160,
          "sortable": true,
          "format": "YYYY-MM-DD HH:mm"
        },
        {
          "field": "crm_act_owner",
          "width": 120
        },
        {
          "field": "crm_act_status",
          "width": 100,
          "renderType": "tag",
          "dictCode": "crm_task_status"
        },
        {
          "field": "crm_act_priority",
          "width": 100,
          "renderType": "tag",
          "dictCode": "crm_task_priority"
        },
        {
          "field": "crm_act_source",
          "width": 100,
          "renderType": "tag",
          "dictCode": "crm_activity_source"
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "buttons": [
            {
              "code": "view",
              "label": "$i18n:common.button.view",
              "action": {
                "type": "navigate",
                "to": "crm_activity_common_detail"
              }
            },
            {
              "code": "edit",
              "permissionCode": "crm.activity.manage",
              "label": "$i18n:common.button.edit",
              "action": {
                "type": "navigate",
                "to": "crm_activity_common_form"
              }
            },
            {
              "code": "delete_follow_plan",
              "danger": true,
              "permissionCode": "crm.activity.manage",
              "visibleWhen": "record.crm_act_type === 'task'",
              "label": {
                "zh-CN": "删除计划",
                "en-US": "Delete Plan"
              },
              "confirm": {
                "zh-CN": "确认删除此跟进计划？删除后无法恢复，关联评论也将不可见。",
                "en-US": "Delete this follow-up plan? It cannot be restored and related comments will no longer be visible."
              },
              "action": {
                "type": "command",
                "command": "crm:delete_follow_plan"
              }
            },
            {
              "code": "delete_follow_record",
              "danger": true,
              "permissionCode": "crm.activity.manage",
              "visibleWhen": "record.crm_act_type !== 'task'",
              "label": {
                "zh-CN": "删除记录",
                "en-US": "Delete Record"
              },
              "confirm": {
                "zh-CN": "确认删除此跟进记录？删除后无法恢复，关联评论也将不可见。",
                "en-US": "Delete this follow-up record? It cannot be restored and related comments will no longer be visible."
              },
              "action": {
                "type": "command",
                "command": "crm:delete_follow_record"
              }
            }
          ],
          "label": "$i18n:common.actions"
        }
      ],
      "searchFields": [
        "crm_act_subject"
      ],
      "searchPlaceholder": {
        "zh-CN": "搜索跟进主题",
        "en": "Search follow-up subject"
      },
      "empty": {
        "title": {
          "zh-CN": "暂无符合条件的跟进",
          "en": "No matching follow-ups"
        },
        "description": {
          "zh-CN": "调整标签或搜索条件，或新建一条跟进计划/记录。",
          "en": "Adjust the tab or search, or create a follow-up plan or record."
        }
      },
      "defaultSort": {
        "field": "crm_act_date",
        "order": "desc"
      }
    }
  ]
}
