{
  "pageKey": "crm_qdp_revision_common_list",
  "name:zh-CN": "QDP 版本清单",
  "name:en": "QDP Revision List",
  "modelCode": "crm_qdp_revision_common",
  "description": "Compact searchable QDP revision history; the sidebar entry uses the task-oriented release workbench.",
  "kind": "list",
  "schemaVersion": 4,
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "crm_qdp_history_table",
      "blockType": "table",
      "columns": [
        {
          "field": "crm_qdp_code",
          "width": 190,
          "sortable": true
        },
        {
          "field": "crm_qdp_requirement_version",
          "width": 160
        },
        {
          "field": "crm_qdp_primary_filename",
          "width": 220,
          "ellipsis": true
        },
        {
          "field": "crm_qdp_status",
          "width": 140,
          "sortable": true,
          "renderType": "tag",
          "dictCode": "crm_qdp_lifecycle"
        },
        {
          "field": "crm_qdp_gate_verdict",
          "width": 150,
          "renderType": "tag",
          "dictCode": "crm_qdp_gate_verdict"
        },
        {
          "field": "crm_qdp_compilation_progress",
          "width": 120,
          "renderType": "progress"
        },
        {
          "field": "crm_qdp_compilation_summary",
          "width": 260,
          "ellipsis": true
        },
        {
          "field": "crm_qdp_prepared_at",
          "width": 180,
          "sortable": true
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "label": "$i18n:common.actions",
          "buttons": [
            {
              "code": "view",
              "icon": "Eye",
              "permissionCode": "crm.qdp.read",
              "label": "$i18n:common.button.view",
              "action": {
                "type": "navigate",
                "to": "crm_qdp_revision_common_detail"
              }
            }
          ]
        }
      ],
      "searchFields": [
        "crm_qdp_code",
        "crm_qdp_requirement_version",
        "crm_qdp_primary_filename",
        "crm_qdp_status"
      ],
      "defaultSort": {
        "field": "crm_qdp_prepared_at",
        "order": "desc"
      }
    }
  ]
}
