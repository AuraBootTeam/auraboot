{
  "pageKey": "crm_quote_summary_common_detail",
  "name:zh-CN": "报价摘要详情",
  "name:en": "Quote Summary Detail",
  "modelCode": "crm_quote_summary_common",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "crm_qs_info",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "报价摘要",
        "en": "Quote Summary"
      },
      "fields": [
        {
          "field": "crm_qs_code",
          "colSpan": 6
        },
        {
          "field": "crm_qs_status",
          "colSpan": 6
        },
        {
          "field": "crm_qs_account_id",
          "colSpan": 6
        },
        {
          "field": "crm_qs_opportunity_id",
          "colSpan": 6
        },
        {
          "field": "crm_qs_customer_request_id",
          "colSpan": 6
        },
        {
          "field": "crm_qs_source_quote_type",
          "colSpan": 6
        },
        {
          "field": "crm_qs_source_quote_id",
          "colSpan": 6
        },
        {
          "field": "crm_qs_quote_amount",
          "colSpan": 6
        },
        {
          "field": "crm_qs_currency",
          "colSpan": 6
        },
        {
          "field": "crm_qs_valid_until",
          "colSpan": 6
        },
        {
          "field": "crm_qs_approval_status",
          "colSpan": 6
        },
        {
          "field": "crm_qs_customer_feedback_status",
          "colSpan": 6
        },
        {
          "field": "crm_qs_won_lost_result",
          "colSpan": 6
        },
        {
          "field": "crm_qs_sent_at",
          "colSpan": 6
        },
        {
          "field": "crm_qs_source_updated_at",
          "colSpan": 6
        },
        {
          "field": "crm_qs_owner",
          "colSpan": 6
        },
        {
          "field": "crm_qs_summary",
          "colSpan": 12
        }
      ]
    },
    {
      "id": "crm_qs_order_commitment",
      "blockType": "detail-section",
      "visibleWhen": "record.crm_qs_committed_qdp_revision_id != null || record.crm_qs_status === 'ordered'",
      "title": {
        "zh-CN": "订单承诺与发布证据",
        "en": "Order Commitment and Release Evidence"
      },
      "fields": [
        {
          "field": "crm_qs_committed_qdp_revision_id",
          "colSpan": 6
        },
        {
          "field": "crm_qs_customer_confirmation_id",
          "colSpan": 6
        },
        {
          "field": "crm_qs_order_committed_at",
          "colSpan": 6
        },
        {
          "field": "crm_qs_order_committed_by",
          "colSpan": 6
        }
      ]
    },
    {
      "id": "crm_qs_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "record_order_commitment",
          "primary": true,
          "icon": "PackageCheck",
          "permissionCode": "crm.order_commitment.manage",
          "visibleWhen": "record.crm_qs_status === 'accepted' && record.crm_qs_committed_qdp_revision_id == null",
          "label": {
            "zh-CN": "登记订单承诺",
            "en-US": "Record Order Commitment"
          },
          "action": {
            "type": "command",
            "command": "crm:record_order_commitment",
            "operationType": "update",
            "targetRecordPid": "${record.pid}",
            "payload": {
              "crm_quote_summary_id": "${record.pid}"
            },
            "inputFieldsTitle": {
              "zh-CN": "选择正式发布的 QDP",
              "en-US": "Select Released QDP"
            },
            "inputFieldsSubmitLabel": {
              "zh-CN": "确认订单承诺",
              "en-US": "Confirm Order Commitment"
            },
            "inputFields": [
              {
                "field": "crm_qdp_revision_id",
                "label": {
                  "zh-CN": "已发布 QDP",
                  "en-US": "Released QDP"
                },
                "type": "select",
                "required": true,
                "searchable": true,
                "dataSource": {
                  "type": "api",
                  "endpoint": "/api/dynamic/crm_qdp_revision_common/list",
                  "params": {
                    "pageNum": 1,
                    "pageSize": 100,
                    "filters": [
                      {
                        "fieldName": "crm_qdp_status",
                        "operator": "EQ",
                        "value": "released"
                      }
                    ]
                  },
                  "valueField": "pid",
                  "labelField": "crm_qdp_code",
                  "descriptionField": "crm_qdp_requirement_version"
                }
              }
            ]
          }
        },
        {
          "code": "open_committed_qdp",
          "icon": "ExternalLink",
          "permissionCode": "crm.qdp.read",
          "visibleWhen": "record.crm_qs_committed_qdp_revision_id != null",
          "label": {
            "zh-CN": "打开承诺 QDP",
            "en-US": "Open Committed QDP"
          },
          "action": {
            "type": "navigate",
            "to": "/p/crm_qdp_revision_common/view/{crm_qs_committed_qdp_revision_id}"
          }
        },
        {
          "code": "edit",
          "icon": "Edit",
          "permissionCode": "crm.quote_summary.manage",
          "label": "$i18n:common.button.edit",
          "action": {
            "type": "navigate",
            "to": "crm_quote_summary_common_form"
          }
        },
        {
          "code": "delete",
          "icon": "Trash2",
          "danger": true,
          "permissionCode": "crm.quote_summary.manage",
          "label": "$i18n:common.button.delete",
          "confirm": "delete.confirm",
          "action": {
            "type": "command"
          }
        }
      ]
    },
    {
      "id": "block_qs_related_contracts",
      "blockType": "sub-table",
      "title": {
        "zh-CN": "转化合同",
        "en": "Converted Contracts"
      },
      "layout": {
        "colSpan": 12,
        "rowSpan": 1
      },
      "subTable": {
        "childModel": "sl_sales_contract_common",
        "parentField": "sl_ctr_source_qo_quote_id",
        "readOnly": true,
        "columns": [
          {
            "field": "sl_ctr_code",
            "width": 160,
            "label": {
              "zh-CN": "合同编号",
              "en": "Contract Code"
            }
          },
          {
            "field": "sl_ctr_name",
            "width": 240,
            "label": {
              "zh-CN": "合同名称",
              "en": "Contract Name"
            }
          },
          {
            "field": "sl_ctr_amount",
            "width": 140,
            "align": "right",
            "label": {
              "zh-CN": "合同金额",
              "en": "Contract Amount"
            }
          },
          {
            "field": "sl_ctr_status",
            "width": 120,
            "renderType": "tag",
            "dictCode": "sl_contract_status",
            "label": {
              "zh-CN": "合同状态",
              "en": "Contract Status"
            }
          },
          {
            "field": "sl_ctr_start_date",
            "width": 130,
            "valueType": "date",
            "label": {
              "zh-CN": "开始日期",
              "en": "Start Date"
            }
          },
          {
            "field": "sl_ctr_end_date",
            "width": 130,
            "valueType": "date",
            "label": {
              "zh-CN": "结束日期",
              "en": "End Date"
            }
          }
        ],
        "toolbarActions": [
          {
            "code": "convert",
            "label": {
              "zh-CN": "转化为合同",
              "en": "Convert to Contract"
            },
            "action": {
              "type": "command",
              "command": "sl:convert_quote_to_contract",
              "payload": {
                "sl_ctr_source_qo_quote_id": "${record.pid}",
                "sl_ctr_account_id": "${record.crm_qs_account_id}",
                "sl_ctr_amount": "${record.crm_qs_quote_amount}",
                "sl_ctr_currency_code": "${record.crm_qs_currency}",
                "sl_ctr_name": "${record.crm_qs_code} 转化合同",
                "sl_ctr_owner": "${record.crm_qs_owner}"
              }
            }
          }
        ]
      }
    }
  ]
}