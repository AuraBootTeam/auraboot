{
  "pageKey": "crm_forecast_cockpit",
  "name:zh-CN": "预测驾驶舱",
  "name:en": "Forecast Cockpit",
  "modelCode": "crm_forecast_submission",
  "description": "Manager and seller forecast cockpit that keeps pipeline facts, owner rollups and submission review in one workspace.",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": { "type": "stack" },
  "extension": { "showShare": false, "showReport": false, "showPrint": false, "showEdit": false },
  "dataSources": {
    "forecastStats": {
      "type": "namedQuery",
      "queryCode": "crm_forecast_cockpit_stats",
      "params": {},
      "adaptor": "table",
      "format": "records"
    },
    "forecastOwners": {
      "type": "namedQuery",
      "queryCode": "crm_sales_forecast_by_owner",
      "params": {},
      "adaptor": "table",
      "format": "records"
    },
    "forecastSubmissions": {
      "type": "api",
      "method": "get",
      "endpoint": "/api/dynamic/crm_forecast_submission/list",
      "adaptor": "table",
      "params": {
        "pageNum": 1,
        "pageSize": 50,
        "filters": [
          { "fieldName": "crm_fcst_status", "operator": "IN", "value": "${state.statusFilter}" }
        ],
        "keyword": "${state.searchKeyword}",
        "sortField": "crm_fcst_period",
        "sortOrder": "desc"
      },
      "dependOn": ["state.statusFilter", "state.searchKeyword"]
    }
  },
  "blocks": [
    {
      "id": "crm_forecast_metrics",
      "blockType": "metric-strip",
      "dataSource": "forecastStats",
      "variant": "cards",
      "columns": 4,
      "metrics": [
        {
          "key": "pipeline",
          "label": { "zh-CN": "总管道", "en": "Total Pipeline" },
          "valueField": "total_pipeline",
          "precision": 0,
          "subText": { "zh-CN": "所有在途商机", "en": "All open opportunities" },
          "tone": "blue",
          "icon": "ChartSpline",
          "activeWhen": "state.statusFilter == null || state.statusFilter.length == 0",
          "onClick": { "action": "state.set", "args": { "statusFilter": [] } }
        },
        {
          "key": "weighted",
          "label": { "zh-CN": "加权预测", "en": "Weighted Forecast" },
          "valueField": "weighted_forecast",
          "precision": 0,
          "subText": { "zh-CN": "概率加权后的经营事实", "en": "Probability-weighted operating fact" },
          "tone": "green",
          "icon": "ChartNoAxesCombined",
          "activeWhen": "state.statusFilter == null || state.statusFilter.length == 0",
          "onClick": { "action": "state.set", "args": { "statusFilter": [] } }
        },
        {
          "key": "drafts",
          "label": { "zh-CN": "待提交预测", "en": "Draft Submissions" },
          "valueField": "draft_submissions",
          "subText": { "zh-CN": "销售仍可修订", "en": "Seller can still revise" },
          "tone": "amber",
          "icon": "FileClock",
          "activeWhen": "state.statusFilter != null && state.statusFilter.includes('draft')",
          "onClick": { "action": "state.set", "args": { "statusFilter": ["draft"] } }
        },
        {
          "key": "submitted",
          "label": { "zh-CN": "已提交预测", "en": "Submitted Forecasts" },
          "valueField": "submitted_count",
          "subText": { "zh-CN": "进入经理复核", "en": "Ready for manager review" },
          "tone": "blue",
          "icon": "Send",
          "activeWhen": "state.statusFilter != null && state.statusFilter.includes('submitted')",
          "onClick": { "action": "state.set", "args": { "statusFilter": ["submitted"] } }
        }
      ]
    },
    {
      "id": "crm_forecast_search",
      "blockType": "filters",
      "onSearch": { "action": "dataSource.reload", "args": { "dataSourceId": "forecastSubmissions" } },
      "onReset": { "action": "state.set", "args": { "searchKeyword": "" } },
      "fields": [
        {
          "field": "crm_fcst_period",
          "component": "SmartInput",
          "bindState": "searchKeyword",
          "label": { "zh-CN": "搜索预测提交", "en": "Search forecast submissions" },
          "placeholder": { "zh-CN": "输入期间、编号或负责人", "en": "Search period, code or owner" }
        }
      ]
    },
    {
      "id": "crm_forecast_header_actions",
      "blockType": "workbench-action-bar",
      "surface": "bare",
      "density": "compact",
      "align": "end",
      "actions": [
        {
          "code": "open_forecast_record",
          "permissionCode": "crm.forecast.read",
          "label": { "zh-CN": "打开预测档案", "en": "Open Forecast Record" },
          "variant": "secondary",
          "permissionCode": "crm.forecast.read",
          "visibleWhen": "state.selectedForecast != null",
          "onClick": { "action": "navigate", "args": { "to": "/p/crm_forecast_submission/view/${state.selectedForecast.pid}" } }
        },
        {
          "code": "create_forecast",
          "permissionCode": "crm.forecast.manage",
          "label": { "zh-CN": "新建预测", "en": "Create Forecast" },
          "variant": "primary",
          "permissionCode": "crm.forecast.manage",
          "onClick": { "action": "navigate", "args": { "to": "/p/crm_forecast_submission/new" } }
        }
      ]
    },
    {
      "id": "crm_forecast_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "submissions",
          "label": { "zh-CN": "预测提交", "en": "Submissions" },
          "blocks": [
            {
              "id": "crm_forecast_submission_queue",
              "blockType": "table",
              "title": { "zh-CN": "预测复核队列", "en": "Forecast Review Queue" },
              "dataSource": "forecastSubmissions",
              "density": "compact",
              "maxHeight": 420,
              "selection": { "mode": "single", "bind": "selectedForecast", "defaultFirst": true },
              "columns": [
                { "field": "crm_fcst_period", "width": 120, "label": { "zh-CN": "期间", "en": "Period" } },
                { "field": "crm_fcst_owner", "width": 145, "label": { "zh-CN": "提交人", "en": "Owner" } },
                { "field": "crm_fcst_status", "width": 105, "dictCode": "crm_forecast_status", "label": { "zh-CN": "状态", "en": "Status" } },
                { "field": "crm_fcst_commit_amount", "width": 130, "align": "right", "valueType": "currency", "label": { "zh-CN": "承诺", "en": "Commit" } },
                { "field": "crm_fcst_best_case_amount", "width": 130, "align": "right", "valueType": "currency", "label": { "zh-CN": "最佳情况", "en": "Best Case" } },
                { "field": "crm_fcst_pipeline_amount", "width": 130, "align": "right", "valueType": "currency", "label": { "zh-CN": "管道", "en": "Pipeline" } },
                { "field": "crm_fcst_submitted_at", "width": 150, "valueType": "datetime", "label": { "zh-CN": "提交时间", "en": "Submitted At" } }
              ],
              "rowActions": [
                {
                  "code": "view_forecast",
                  "label": { "zh-CN": "查看预测", "en": "View Forecast" },
                  "permissionCode": "crm.forecast.read",
                  "action": { "type": "navigate", "to": "crm_forecast_submission_detail" }
                }
              ]
            }
          ]
        },
        {
          "key": "owners",
          "label": { "zh-CN": "团队偏差", "en": "Team Rollup" },
          "blocks": [
            {
              "id": "crm_forecast_owner_queue",
              "blockType": "table",
              "title": { "zh-CN": "按负责人汇总", "en": "Forecast by Owner" },
              "dataSource": "forecastOwners",
              "density": "compact",
              "maxHeight": 420,
              "selection": { "mode": "single", "bind": "selectedOwner", "defaultFirst": true },
              "columns": [
                { "field": "owner_name", "width": 180, "label": { "zh-CN": "负责人", "en": "Owner" } },
                { "field": "opportunity_count", "width": 120, "align": "right", "label": { "zh-CN": "商机数", "en": "Deals" } },
                { "field": "total_amount", "width": 150, "align": "right", "valueType": "currency", "label": { "zh-CN": "管道金额", "en": "Pipeline" } },
                { "field": "weighted_forecast", "width": 150, "align": "right", "valueType": "currency", "label": { "zh-CN": "加权预测", "en": "Weighted" } }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "crm_forecast_status",
      "blockType": "status-banner",
      "context": "${state.selectedForecast}",
      "statusField": "crm_fcst_status",
      "toneMap": { "draft": "amber", "submitted": "blue" },
      "titleMap": {
        "draft": { "zh-CN": "预测尚未提交", "en": "Forecast is still a draft" },
        "submitted": { "zh-CN": "预测已进入经理复核", "en": "Forecast is ready for manager review" }
      },
      "descriptionMap": {
        "draft": { "zh-CN": "提交前核对承诺、最佳情况和管道金额与当前商机事实一致。", "en": "Reconcile commit, best case and pipeline with current opportunity facts before submission." },
        "submitted": { "zh-CN": "经理应对照团队汇总和商机工作台解释偏差。", "en": "The manager should explain variance against the team rollup and opportunity workspace." }
      },
      "summaryFields": [
        { "field": "crm_fcst_owner_display", "label": { "zh-CN": "负责人", "en": "Owner" } },
        { "field": "crm_fcst_commit_amount", "label": { "zh-CN": "承诺", "en": "Commit" } },
        { "field": "crm_fcst_best_case_amount", "label": { "zh-CN": "最佳情况", "en": "Best Case" } },
        { "field": "crm_fcst_pipeline_amount", "label": { "zh-CN": "管道", "en": "Pipeline" } }
      ]
    },
    {
      "id": "crm_forecast_actions",
      "blockType": "workbench-action-bar",
      "title": { "zh-CN": "预测动作", "en": "Forecast Action" },
      "surface": "card",
      "density": "compact",
      "actions": [
        {
          "code": "submit_forecast",
          "permissionCode": "crm.forecast.manage",
          "label": { "zh-CN": "提交预测", "en": "Submit Forecast" },
          "variant": "primary",
          "permissionCode": "crm.forecast.manage",
          "visibleWhen": "state.selectedForecast != null && state.selectedForecast.crm_fcst_status == 'draft'",
          "confirm": { "zh-CN": "提交后该版本进入经理复核。确认继续吗？", "en": "The submission will enter manager review. Continue?" },
          "onClick": { "action": "command.execute", "args": { "command": "crm:submit_forecast", "operationType": "update", "targetRecordPid": "${state.selectedForecast.pid}", "reload": ["forecastStats", "forecastSubmissions", "forecastOwners"] } }
        }
      ]
    },
    {
      "id": "crm_forecast_context",
      "blockType": "evidence-panel",
      "context": "${state.selectedForecast}",
      "title": { "zh-CN": "预测解释上下文", "en": "Forecast Explanation Context" },
      "sections": [
        { "key": "code", "label": { "zh-CN": "预测编号", "en": "Forecast Code" }, "field": "crm_fcst_code" },
        { "key": "period", "label": { "zh-CN": "期间", "en": "Period" }, "field": "crm_fcst_period" },
        { "key": "owner", "label": { "zh-CN": "负责人", "en": "Owner" }, "field": "crm_fcst_owner_display" },
        { "key": "commit", "label": { "zh-CN": "承诺金额", "en": "Commit" }, "field": "crm_fcst_commit_amount" },
        { "key": "best", "label": { "zh-CN": "最佳情况", "en": "Best Case" }, "field": "crm_fcst_best_case_amount" },
        { "key": "notes", "label": { "zh-CN": "偏差说明", "en": "Variance Notes" }, "field": "crm_fcst_notes" }
      ],
      "empty": { "title": { "zh-CN": "选择一个预测提交，查看金额和偏差说明", "en": "Select a forecast submission to review amounts and variance notes" } }
    }
  ]
}
