{
  "pageKey": "crm_lead_common_detail",
  "name:zh-CN": "线索详情",
  "name:en": "Lead Detail",
  "modelCode": "crm_lead_common",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "crm_lead_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "overview",
          "label": {
            "zh-CN": "概览",
            "en-US": "Overview"
          },
          "blocks": [
            {
              "id": "section_basic",
              "blockType": "form-section",
              "title": {
                "zh-CN": "线索信息",
                "en-US": "Lead Information"
              },
              "columns": 2,
              "fields": [
                {
                  "field": "crm_lead_code",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_company",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_contact_name",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_contact_phone",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_contact_email",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_source",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_industry",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_score",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_status",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_assigned_to",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_campaign",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_requirement",
                  "span": 2,
                  "readOnly": true
                },
                {
                  "field": "crm_lead_lost_reason",
                  "span": 2,
                  "readOnly": true
                }
              ]
            }
          ]
        },
        {
          "key": "activities",
          "label": {
            "zh-CN": "活动记录",
            "en-US": "Activities"
          },
          "blocks": [
            {
              "id": "block_activities",
              "blockType": "activity-timeline",
              "subTable": {
                "dataSource": {
                  "type": "api",
                  "url": "/api/datasource/list",
                  "method": "get",
                  "params": {
                    "datasourceId": "nq:crm_activities_by_object",
                    "objectType": "lead",
                    "objectId": "${recordPid}",
                    "format": "records"
                  }
                },
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_act_type",
                    "width": 100,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_act_subject",
                    "width": 250
                  },
                  {
                    "field": "crm_act_date",
                    "width": 150
                  },
                  {
                    "field": "crm_act_owner",
                    "width": 120
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "conversion",
          "label": {
            "zh-CN": "转化结果",
            "en-US": "Conversion"
          },
          "blocks": [
            {
              "id": "block_conversion",
              "blockType": "form-section",
              "title": {
                "zh-CN": "转化回链",
                "en-US": "Conversion Back Links"
              },
              "columns": 2,
              "fields": [
                {
                  "field": "crm_lead_converted_account_id",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_converted_contact_id",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_converted_opportunity_id",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_converted_request_id",
                  "readOnly": true
                },
                {
                  "field": "crm_lead_converted_at",
                  "readOnly": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "crm_lead_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "edit",
          "icon": "Edit",
          "permissionCode": "crm.lead.manage",
          "label": "$i18n:common.button.edit",
          "action": {
            "type": "navigate",
            "to": "crm_lead_common_form"
          }
        },
        {
          "code": "log_activity",
          "icon": "MessageSquare",
          "label": {
            "zh-CN": "记录跟进",
            "en-US": "Log Follow-up"
          },
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:log_lead_activity"
          }
        },
        {
          "code": "create_task",
          "icon": "CheckSquare",
          "label": {
            "zh-CN": "新建计划",
            "en-US": "New Follow-up Plan"
          },
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:create_lead_task"
          }
        },
        {
          "code": "rescore",
          "icon": "Gauge",
          "permissionCode": "crm.lead.manage",
          "label": {
            "zh-CN": "重新评分",
            "en-US": "Rescore Lead"
          },
          "action": {
            "type": "command",
            "command": "crm:rescore_lead"
          }
        },
        {
          "code": "auto_assign",
          "icon": "Users",
          "permissionCode": "crm.lead.manage",
          "label": {
            "zh-CN": "自动分配",
            "en-US": "Auto Assign Lead"
          },
          "action": {
            "type": "command",
            "command": "crm:auto_assign_lead"
          }
        },
        {
          "code": "contact",
          "label": {
            "zh-CN": "标记已联系",
            "en-US": "Mark Contacted"
          },
          "action": {
            "type": "command",
            "command": "crm:contact_lead"
          }
        },
        {
          "code": "qualify",
          "label": {
            "zh-CN": "标记合格",
            "en-US": "Qualify Lead"
          },
          "action": {
            "type": "state_transition",
            "command": "crm:qualify_lead"
          }
        },
        {
          "code": "convert",
          "primary": true,
          "visibleWhen": "record.crm_lead_status == 'qualified'",
          "label": {
            "zh-CN": "转化线索",
            "en-US": "Convert Lead"
          },
          "confirm": {
            "zh-CN": "确认将此线索转化为客户、联系人、商机和客户需求？转化前的跟进记录与评论将继续保留。",
            "en-US": "Convert this lead to an account, contact, opportunity, and customer request? Existing follow-up records and comments will be preserved."
          },
          "action": {
            "type": "command",
            "command": "crm:convert_lead"
          }
        },
        {
          "code": "lose",
          "danger": true,
          "label": {
            "zh-CN": "标记丢失",
            "en-US": "Mark Lost"
          },
          "action": {
            "type": "state_transition",
            "command": "crm:lose_lead"
          }
        }
      ]
    }
  ]
}
