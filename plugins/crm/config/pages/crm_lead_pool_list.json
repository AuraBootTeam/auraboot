{
  "pageKey": "crm_lead_pool_list",
  "name:zh-CN": "线索池设置",
  "name:en": "Lead Pool Settings",
  "modelCode": "crm_lead_pool_common",
  "kind": "list",
  "schemaVersion": 4,
  "layout": { "type": "grid", "cols": 12 },
  "blocks": [
    {
      "id": "crm_lp_toolbar",
      "blockType": "toolbar",
      "buttons": [
        { "code": "create", "primary": true, "permissionCode": "crm.lead_pool.manage", "label": "$i18n:common.button.create", "action": { "type": "navigate", "to": "crm_lead_pool_form" } },
        { "code": "run_recycle", "permissionCode": "crm.lead_pool.recycle", "label": { "zh-CN": "立即执行回收", "en": "Run Recycle Now" }, "action": { "type": "command", "command": "crm:run_lead_pool_recycle" } }
      ]
    },
    {
      "id": "crm_lp_table",
      "blockType": "table",
      "columns": [
        { "field": "crm_lp_code", "width": 150, "sortable": true },
        { "field": "crm_lp_name", "width": 200, "sortable": true },
        { "field": "crm_lp_status", "width": 100, "renderType": "tag", "dictCode": "crm_lead_pool_status" },
        { "field": "crm_lp_daily_pick_limit", "width": 120, "align": "right" },
        { "field": "crm_lp_new_cooldown_days", "width": 130, "align": "right" },
        { "field": "crm_lp_previous_owner_cooldown_days", "width": 150, "align": "right" },
        { "field": "crm_lp_auto_recycle", "width": 110 },
        { "field": "crm_lp_recycle_after_days", "width": 130, "align": "right" },
        {
          "field": "actions", "isActionColumn": true, "label": "$i18n:common.actions",
          "buttons": [
            { "code": "view", "label": "$i18n:common.button.view", "action": { "type": "navigate", "to": "crm_lead_pool_detail" } },
            { "code": "edit", "permissionCode": "crm.lead_pool.manage", "label": "$i18n:common.button.edit", "action": { "type": "navigate", "to": "crm_lead_pool_form" } },
            { "code": "quick_update", "permissionCode": "crm.lead_pool.manage", "label": { "zh-CN": "快捷保存", "en": "Quick Save" }, "action": { "type": "command", "command": "crm:update_lead_pool", "operationType": "update", "inputFields": [ { "field": "crm_lp_daily_pick_limit", "label": { "zh-CN": "每日领取上限", "en": "Daily Claim Limit" }, "type": "integer", "required": true, "defaultValue": "${row.crm_lp_daily_pick_limit}" }, { "field": "crm_lp_description", "label": { "zh-CN": "说明", "en": "Description" }, "type": "text", "defaultValue": "${row.crm_lp_description}" } ] } },
            { "code": "download_import_template", "permissionCode": "crm.lead_pool.import", "label": { "zh-CN": "下载导入模板", "en": "Download Import Template" }, "action": { "type": "command", "command": "crm:download_lead_pool_import_template", "operationType": "UPDATE" } },
            { "code": "precheck_import", "permissionCode": "crm.lead_pool.import", "label": { "zh-CN": "预检导入文件", "en": "Pre-check Import File" }, "promptUpload": { "key": "importFileId", "accept": ".xlsx", "feedbackMode": "panel" }, "action": { "type": "command", "command": "crm:precheck_lead_pool_import", "operationType": "UPDATE", "inputFieldsTitle": { "zh-CN": "预检线索池导入", "en": "Pre-check Lead Pool Import" }, "inputFieldsSubmitLabel": { "zh-CN": "开始预检", "en": "Start Pre-check" }, "inputFields": [ { "field": "importType", "label": { "zh-CN": "导入方式", "en": "Import Mode" }, "type": "segmented", "required": true, "defaultValue": "ADD", "dataSource": { "type": "static", "data": [ { "value": "ADD", "label": { "zh-CN": "新增线索", "en": "Add Leads" } }, { "value": "UPDATE", "label": { "zh-CN": "更新线索", "en": "Update Leads" } } ] } }, { "field": "importFileId", "label": { "zh-CN": "线索导入文件", "en": "Lead Import File" }, "type": "file", "fileValueMode": "file", "fileNameField": "importFilename", "required": true, "accept": ".xlsx", "maxBytes": 52428800 } ] } },
            { "code": "import_leads", "permissionCode": "crm.lead_pool.import", "label": { "zh-CN": "正式导入线索", "en": "Import Leads" }, "promptUpload": { "key": "importFileId", "accept": ".xlsx", "feedbackMode": "panel" }, "action": { "type": "command", "command": "crm:import_lead_pool_leads", "operationType": "UPDATE", "inputFieldsTitle": { "zh-CN": "正式导入线索到池", "en": "Import Leads to Pool" }, "inputFieldsSubmitLabel": { "zh-CN": "确认导入", "en": "Confirm Import" }, "inputFields": [ { "field": "importType", "label": { "zh-CN": "导入方式", "en": "Import Mode" }, "type": "segmented", "required": true, "defaultValue": "ADD", "dataSource": { "type": "static", "data": [ { "value": "ADD", "label": { "zh-CN": "新增线索", "en": "Add Leads" } }, { "value": "UPDATE", "label": { "zh-CN": "更新线索", "en": "Update Leads" } } ] } }, { "field": "importFileId", "label": { "zh-CN": "线索导入文件", "en": "Lead Import File" }, "type": "file", "fileValueMode": "file", "fileNameField": "importFilename", "required": true, "accept": ".xlsx", "maxBytes": 52428800 }, { "field": "skipErrors", "label": { "zh-CN": "忽略错误并导入合法行", "en": "Skip Errors and Import Valid Rows" }, "type": "checkbox", "defaultValue": false } ] } },
            { "code": "toggle", "permissionCode": "crm.lead_pool.manage", "label": { "zh-CN": "启用/停用", "en": "Enable/Disable" }, "action": { "type": "command", "command": "crm:toggle_lead_pool" } },
            { "code": "delete", "danger": true, "permissionCode": "crm.lead_pool.manage", "label": "$i18n:common.button.delete", "confirm": { "zh-CN": "仅空线索池可删除，确认继续？", "en": "Only an empty pool can be deleted. Continue?" }, "action": { "type": "command", "command": "crm:delete_lead_pool" } }
          ]
        }
      ],
      "searchFields": ["crm_lp_code", "crm_lp_name"],
      "defaultSort": { "field": "updated_at", "order": "desc" }
    }
  ]
}
