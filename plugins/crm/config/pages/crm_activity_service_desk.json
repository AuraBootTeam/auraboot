{
  "pageKey": "crm_activity_service_desk",
  "name:zh-CN": "活动与服务工作台",
  "name:en": "Activity & Service Desk",
  "modelCode": "crm_activity_common",
  "description": "Unified role queue for today's tasks, overdue commitments, complaints and SLA breaches.",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": { "type": "stack" },
  "extension": { "showShare": false, "showReport": false, "showPrint": false, "showEdit": false },
  "dataSources": {
    "workStats": {
      "type": "namedQuery",
      "queryCode": "crm_activity_service_stats",
      "params": {},
      "adaptor": "table",
      "format": "records"
    },
    "workQueue": {
      "type": "namedQuery",
      "queryCode": "crm_activity_service_queue",
      "params": {
        "workKeyword": "${state.searchKeyword}",
        "viewFilter": "${state.viewFilter}"
      },
      "dependOn": ["state.searchKeyword", "state.viewFilter"],
      "adaptor": "table",
      "format": "records"
    }
  },
  "blocks": [
    {
      "id": "crm_activity_service_metrics",
      "blockType": "metric-strip",
      "dataSource": "workStats",
      "variant": "cards",
      "columns": 4,
      "metrics": [
        {
          "key": "open_work",
          "label": { "zh-CN": "未完成任务", "en": "Open Tasks" },
          "valueField": "open_tasks",
          "subText": { "zh-CN": "我的承诺分母", "en": "Current commitment denominator" },
          "tone": "blue",
          "icon": "ListTodo",
          "activeWhen": "state.viewFilter == null || state.viewFilter == '' || state.viewFilter == 'all'",
          "onClick": { "action": "state.set", "args": { "viewFilter": "all" } }
        },
        {
          "key": "overdue",
          "label": { "zh-CN": "逾期任务", "en": "Overdue Tasks" },
          "valueField": "overdue_tasks",
          "subText": { "zh-CN": "需要先恢复承诺", "en": "Commitment recovery required" },
          "tone": "red",
          "icon": "ClockAlert",
          "activeWhen": "state.viewFilter == 'overdue'",
          "onClick": { "action": "state.set", "args": { "viewFilter": "overdue" } }
        },
        {
          "key": "due_today",
          "label": { "zh-CN": "今日到期", "en": "Due Today" },
          "valueField": "due_today",
          "subText": { "zh-CN": "今天必须处理", "en": "Must be handled today" },
          "tone": "amber",
          "icon": "CalendarCheck2",
          "activeWhen": "state.viewFilter == 'due_today'",
          "onClick": { "action": "state.set", "args": { "viewFilter": "due_today" } }
        },
        {
          "key": "sla_breach",
          "label": { "zh-CN": "SLA 违规", "en": "SLA Breaches" },
          "valueField": "sla_breaches",
          "subText": { "zh-CN": "服务恢复优先", "en": "Service recovery first" },
          "tone": "red",
          "icon": "Siren",
          "activeWhen": "state.viewFilter == 'sla_breach'",
          "onClick": { "action": "state.set", "args": { "viewFilter": "sla_breach" } }
        }
      ]
    },
    {
      "id": "crm_activity_service_search",
      "blockType": "filters",
      "onSearch": { "action": "dataSource.reload", "args": { "dataSourceId": "workQueue" } },
      "onReset": { "action": "state.set", "args": { "searchKeyword": "" } },
      "fields": [
        {
          "field": "item_title",
          "component": "SmartInput",
          "bindState": "searchKeyword",
          "label": { "zh-CN": "搜索工作队列", "en": "Search work queue" },
          "placeholder": { "zh-CN": "输入主题、投诉编号或负责人", "en": "Search subject, complaint code or owner" }
        }
      ]
    },
    {
      "id": "crm_activity_service_header_actions",
      "blockType": "workbench-action-bar",
      "surface": "bare",
      "density": "compact",
      "align": "end",
      "actions": [
        {
          "code": "open_task_record",
          "permissionCode": "crm.activity.read",
          "label": { "zh-CN": "打开任务", "en": "Open Task" },
          "variant": "secondary",
          "permissionCode": "crm.activity.read",
          "visibleWhen": "state.selectedWork != null && state.selectedWork.item_kind == 'task'",
          "onClick": { "action": "navigate", "args": { "to": "/p/crm_activity_common/view/${state.selectedWork.pid}" } }
        },
        {
          "code": "open_complaint_record",
          "permissionCode": "crm.complaint.read",
          "label": { "zh-CN": "打开投诉", "en": "Open Complaint" },
          "variant": "secondary",
          "permissionCode": "crm.complaint.read",
          "visibleWhen": "state.selectedWork != null && state.selectedWork.item_kind == 'complaint'",
          "onClick": { "action": "navigate", "args": { "to": "/p/crm_complaint/view/${state.selectedWork.pid}" } }
        },
        {
          "code": "create_task",
          "permissionCode": "crm.activity.manage",
          "label": { "zh-CN": "新建任务", "en": "Create Task" },
          "variant": "primary",
          "permissionCode": "crm.activity.manage",
          "onClick": { "action": "navigate", "args": { "to": "/p/crm_activity_common/new" } }
        }
      ]
    },
    {
      "id": "crm_activity_service_queue",
      "blockType": "table",
      "title": { "zh-CN": "今日工作与服务队列", "en": "Today Work and Service Queue" },
      "dataSource": "workQueue",
      "density": "compact",
      "maxHeight": 430,
      "selection": { "mode": "single", "bind": "selectedWork", "defaultFirst": true },
      "columns": [
        { "field": "item_kind", "width": 95, "dictCode": "crm_work_item_kind", "label": { "zh-CN": "类型", "en": "Type" } },
        { "field": "item_title", "width": 280, "ellipsis": true, "label": { "zh-CN": "工作项", "en": "Work Item" } },
        { "field": "item_status", "width": 110, "dictCode": "crm_work_item_status", "label": { "zh-CN": "状态", "en": "Status" } },
        { "field": "item_priority", "width": 105, "dictCode": "crm_task_priority", "label": { "zh-CN": "优先级", "en": "Priority" } },
        { "field": "due_date", "width": 125, "valueType": "date", "label": { "zh-CN": "到期/发生", "en": "Due / Opened" } },
        { "field": "item_owner", "width": 130, "label": { "zh-CN": "负责人", "en": "Owner" } },
        { "field": "attention_reason", "width": 130, "dictCode": "crm_work_attention_reason", "label": { "zh-CN": "关注原因", "en": "Attention" } }
      ]
    },
    {
      "id": "crm_activity_service_attention",
      "blockType": "status-banner",
      "context": "${state.selectedWork}",
      "statusField": "attention_reason",
      "toneMap": {
        "sla_breach": "red",
        "overdue": "red",
        "due_today": "amber",
        "ready_to_close": "green",
        "service": "amber",
        "task": "blue"
      },
      "titleMap": {
        "sla_breach": { "zh-CN": "SLA 已违规，优先恢复服务", "en": "SLA breached — restore service first" },
        "overdue": { "zh-CN": "任务承诺已逾期", "en": "Task commitment is overdue" },
        "due_today": { "zh-CN": "任务今日到期", "en": "Task is due today" },
        "ready_to_close": { "zh-CN": "投诉已解决，等待关闭", "en": "Complaint resolved and ready to close" },
        "service": { "zh-CN": "投诉处理中", "en": "Complaint requires service action" },
        "task": { "zh-CN": "按计划推进任务", "en": "Progress the task as planned" }
      },
      "descriptionMap": {
        "sla_breach": { "zh-CN": "先记录恢复动作和客户沟通，再推进投诉状态。", "en": "Record recovery and customer communication before changing complaint state." },
        "overdue": { "zh-CN": "重新确认负责人、截止时间和受影响客户。", "en": "Reconfirm owner, due date and affected customer." },
        "ready_to_close": { "zh-CN": "确认客户已接受解决结果后关闭投诉。", "en": "Close only after the customer accepts the resolution." }
      },
      "summaryFields": [
        {
          "field": "item_kind",
          "label": { "zh-CN": "工作类型", "en": "Work Type" },
          "valueMap": {
            "task": { "zh-CN": "任务", "en": "Task" },
            "complaint": { "zh-CN": "投诉", "en": "Complaint" }
          }
        },
        {
          "field": "item_status",
          "label": { "zh-CN": "当前状态", "en": "Status" },
          "valueMap": {
            "open": { "zh-CN": "待处理", "en": "Open" },
            "in_progress": { "zh-CN": "进行中", "en": "In Progress" },
            "done": { "zh-CN": "已完成", "en": "Done" },
            "cancelled": { "zh-CN": "已取消", "en": "Cancelled" },
            "investigating": { "zh-CN": "调查中", "en": "Investigating" },
            "resolved": { "zh-CN": "已解决", "en": "Resolved" },
            "closed": { "zh-CN": "已关闭", "en": "Closed" }
          }
        },
        { "field": "item_owner", "label": { "zh-CN": "负责人", "en": "Owner" } },
        { "field": "due_date", "label": { "zh-CN": "到期/发生日期", "en": "Due / Opened" } }
      ]
    },
    {
      "id": "crm_activity_service_actions",
      "blockType": "workbench-action-bar",
      "title": { "zh-CN": "下一步动作", "en": "Next Action" },
      "surface": "card",
      "density": "compact",
      "actions": [
        {
          "code": "start_task",
          "permissionCode": "crm.activity.manage",
          "label": { "zh-CN": "开始任务", "en": "Start Task" },
          "variant": "primary",
          "permissionCode": "crm.activity.manage",
          "visibleWhen": "state.selectedWork != null && state.selectedWork.item_kind == 'task' && state.selectedWork.item_status == 'open'",
          "onClick": { "action": "command.execute", "args": { "command": "crm:start_task", "operationType": "update", "targetRecordPid": "${state.selectedWork.pid}", "reload": ["workStats", "workQueue"] } }
        },
        {
          "code": "complete_task",
          "permissionCode": "crm.activity.manage",
          "label": { "zh-CN": "完成任务", "en": "Complete Task" },
          "variant": "primary",
          "permissionCode": "crm.activity.manage",
          "visibleWhen": "state.selectedWork != null && state.selectedWork.item_kind == 'task' && (state.selectedWork.item_status == 'open' || state.selectedWork.item_status == 'in_progress')",
          "confirm": { "zh-CN": "确认承诺内容已经真实完成吗？", "en": "Confirm that the commitment is actually complete?" },
          "onClick": { "action": "command.execute", "args": { "command": "crm:complete_task", "operationType": "update", "targetRecordPid": "${state.selectedWork.pid}", "reload": ["workStats", "workQueue"] } }
        },
        {
          "code": "investigate_complaint",
          "permissionCode": "crm.complaint.manage",
          "label": { "zh-CN": "开始调查", "en": "Start Investigation" },
          "variant": "primary",
          "permissionCode": "crm.complaint.manage",
          "visibleWhen": "state.selectedWork != null && state.selectedWork.item_kind == 'complaint' && state.selectedWork.item_status == 'open'",
          "onClick": { "action": "command.execute", "args": { "command": "crm:investigate_complaint", "operationType": "update", "targetRecordPid": "${state.selectedWork.pid}", "reload": ["workStats", "workQueue"] } }
        },
        {
          "code": "resolve_complaint",
          "permissionCode": "crm.complaint.manage",
          "label": { "zh-CN": "标记已解决", "en": "Mark Resolved" },
          "variant": "primary",
          "permissionCode": "crm.complaint.manage",
          "visibleWhen": "state.selectedWork != null && state.selectedWork.item_kind == 'complaint' && state.selectedWork.item_status == 'investigating'",
          "confirm": { "zh-CN": "确认根因、纠正措施和客户沟通已经记录吗？", "en": "Confirm root cause, corrective action and customer communication are recorded?" },
          "onClick": { "action": "command.execute", "args": { "command": "crm:resolve_complaint", "operationType": "update", "targetRecordPid": "${state.selectedWork.pid}", "reload": ["workStats", "workQueue"] } }
        },
        {
          "code": "close_complaint",
          "permissionCode": "crm.complaint.manage",
          "label": { "zh-CN": "关闭投诉", "en": "Close Complaint" },
          "variant": "secondary",
          "permissionCode": "crm.complaint.manage",
          "visibleWhen": "state.selectedWork != null && state.selectedWork.item_kind == 'complaint' && state.selectedWork.item_status == 'resolved'",
          "confirm": { "zh-CN": "确认客户已接受解决结果并关闭投诉吗？", "en": "Confirm customer acceptance and close the complaint?" },
          "onClick": { "action": "command.execute", "args": { "command": "crm:close_complaint", "operationType": "update", "targetRecordPid": "${state.selectedWork.pid}", "reload": ["workStats", "workQueue"] } }
        }
      ]
    },
    {
      "id": "crm_activity_service_context",
      "blockType": "evidence-panel",
      "context": "${state.selectedWork}",
      "title": { "zh-CN": "工作项上下文", "en": "Work Item Context" },
      "sections": [
        { "key": "type", "label": { "zh-CN": "类型", "en": "Type" }, "field": "item_kind", "valueMap": { "task": { "zh-CN": "任务", "en": "Task" }, "complaint": { "zh-CN": "投诉", "en": "Complaint" } } },
        { "key": "status", "label": { "zh-CN": "状态", "en": "Status" }, "field": "item_status", "valueMap": { "open": { "zh-CN": "待处理", "en": "Open" }, "in_progress": { "zh-CN": "进行中", "en": "In progress" }, "investigating": { "zh-CN": "调查中", "en": "Investigating" }, "resolved": { "zh-CN": "已解决", "en": "Resolved" } } },
        { "key": "priority", "label": { "zh-CN": "优先级", "en": "Priority" }, "field": "item_priority", "valueMap": { "critical": { "zh-CN": "紧急", "en": "Critical" }, "high": { "zh-CN": "高", "en": "High" }, "medium": { "zh-CN": "中", "en": "Medium" }, "low": { "zh-CN": "低", "en": "Low" } } },
        { "key": "owner", "label": { "zh-CN": "负责人", "en": "Owner" }, "field": "item_owner" },
        { "key": "related", "label": { "zh-CN": "关联对象", "en": "Related Object" }, "field": "related_model" },
        { "key": "reason", "label": { "zh-CN": "关注原因", "en": "Attention" }, "field": "attention_reason", "valueMap": { "sla_breach": { "zh-CN": "SLA 违规", "en": "SLA breach" }, "overdue": { "zh-CN": "已逾期", "en": "Overdue" }, "due_today": { "zh-CN": "今日到期", "en": "Due today" }, "service": { "zh-CN": "服务处理", "en": "Service action" }, "ready_to_close": { "zh-CN": "等待关闭", "en": "Ready to close" }, "task": { "zh-CN": "计划任务", "en": "Planned task" } } }
      ],
      "empty": { "title": { "zh-CN": "选择一个任务或投诉，查看状态和下一步", "en": "Select a task or complaint to review status and next action" } }
    }
  ]
}
