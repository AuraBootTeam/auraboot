{
  "pageKey": "crm_lead_common_list",
  "name:zh-CN": "线索列表",
  "name:en": "Leads",
  "modelCode": "crm_lead_common",
  "kind": "list",
  "schemaVersion": 4,
  "extension": {
    "import": {
      "enabled": true,
      "permissionCode": "model.crm_lead_common.import",
      "modes": ["insert", "update"],
      "updateKeys": ["crm_lead_code"]
    }
  },
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "crm_lead_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "all",
          "label": {
            "en": "All",
            "zh-CN": "全部"
          },
          "filter": null
        },
        {
          "key": "new",
          "label": {
            "en": "New",
            "zh-CN": "新建"
          },
          "filter": {
            "field": "crm_lead_status",
            "value": "new",
            "operator": "EQ"
          }
        },
        {
          "key": "contacted",
          "label": {
            "en": "Contacted",
            "zh-CN": "已联系"
          },
          "filter": {
            "field": "crm_lead_status",
            "value": "contacted",
            "operator": "EQ"
          }
        },
        {
          "key": "qualified",
          "label": {
            "en": "Qualified",
            "zh-CN": "已合格"
          },
          "filter": {
            "field": "crm_lead_status",
            "value": "qualified",
            "operator": "EQ"
          }
        },
        {
          "key": "converted",
          "label": {
            "en": "Converted",
            "zh-CN": "已转化"
          },
          "filter": {
            "field": "crm_lead_status",
            "value": "converted",
            "operator": "EQ"
          }
        },
        {
          "key": "lost",
          "label": {
            "en": "Lost",
            "zh-CN": "已丢失"
          },
          "filter": {
            "field": "crm_lead_status",
            "value": "lost",
            "operator": "EQ"
          }
        }
      ]
    },
    {
      "id": "crm_lead_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "permissionCode": "crm.lead.manage",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_lead_common_form"
          }
        },
        {
          "code": "ai_score",
          "icon": "Sparkles",
          "confirm": "crm.action.ai_score.confirm",
          "mobile": {
            "disabled": true,
            "reason": "Bulk AI scoring is a web-admin batch tool; no mobile use case scoped for P7."
          },
          "action": {
            "type": "flow",
            "steps": [
              {
                "endpoint": "/api/crm/ai/score-leads",
                "method": "post",
                "successMessage": {
                  "zh-CN": "AI 评分完成",
                  "en-US": "AI scoring complete"
                }
              }
            ]
          },
          "content": {
            "zh-CN": "AI 评分",
            "en": "AI Score"
          }
        }
      ]
    },
    {
      "id": "crm_lead_table",
      "blockType": "table",
      "table": {
        "selection": {
          "mode": "multiple",
          "bind": "{{state.selectedIds}}"
        },
        "bulkCapabilities": {
          "edit": {
            "permissionCode": "crm.lead.manage"
          },
          "delete": {
            "permissionCode": "crm.lead.manage"
          },
          "export": {
            "permissionCode": "crm.lead.read"
          }
        },
        "bulkActions": [
          {
            "code": "bulk_transfer_owner",
            "permissionCode": "crm.lead.manage",
            "label": { "zh-CN": "批量转移负责人", "en-US": "Transfer Selected Owners" },
            "action": {
              "type": "bulk_field_command",
              "command": "crm:update_lead",
              "input": {
                "field": "crm_lead_assigned_to",
                "label": { "zh-CN": "新负责人", "en-US": "New Owner" },
                "type": "reference",
                "component": "MemberPicker",
                "required": true,
                "props": { "multiple": false }
              }
            }
          },
          {
            "code": "bulk_update_source",
            "permissionCode": "crm.lead.manage",
            "label": { "zh-CN": "批量更新来源", "en-US": "Update Selected Sources" },
            "action": {
              "type": "bulk_field_command",
              "command": "crm:update_lead",
              "input": {
                "field": "crm_lead_source",
                "label": { "zh-CN": "线索来源", "en-US": "Lead Source" },
                "type": "enum",
                "dictCode": "crm_lead_source",
                "required": true
              }
            }
          },
          {
            "code": "bulk_delete_leads",
            "permissionCode": "crm.lead.manage",
            "variant": "danger",
            "label": { "zh-CN": "批量删除", "en-US": "Delete Selected" },
            "confirm": {
              "zh-CN": "仅新建或已联系状态可删除；其他线索会被明确拒绝。确认继续？",
              "en-US": "Only new or contacted leads can be deleted; other leads will be rejected. Continue?"
            },
            "action": {
              "type": "bulk_record_command",
              "command": "crm:delete_lead",
              "operationType": "DELETE"
            }
          },
          {
            "code": "bulk_contact",
            "permissionCode": "crm.lead.manage",
            "label": {
              "zh-CN": "批量标记已联系",
              "en-US": "Mark Selected Contacted"
            },
            "action": {
              "type": "bulk_state_transition",
              "command": "crm:contact_lead"
            }
          },
          {
            "code": "bulk_qualify",
            "permissionCode": "crm.lead.manage",
            "label": {
              "zh-CN": "批量标记合格",
              "en-US": "Qualify Selected"
            },
            "action": {
              "type": "bulk_state_transition",
              "command": "crm:qualify_lead"
            }
          },
          {
            "code": "bulk_lose",
            "permissionCode": "crm.lead.manage",
            "variant": "danger",
            "label": {
              "zh-CN": "批量标记丢失",
              "en-US": "Mark Selected Lost"
            },
            "confirm": {
              "zh-CN": "确定将选中的线索标记为丢失吗？不符合当前状态的记录会被拒绝。",
              "en-US": "Mark selected leads as lost? Records in an invalid state will be rejected."
            },
            "action": {
              "type": "bulk_state_transition",
              "command": "crm:lose_lead"
            }
          },
          {
            "code": "bulk_move_to_pool",
            "permissionCode": "crm.lead_pool.move",
            "label": {
              "zh-CN": "批量移入线索池",
              "en-US": "Move Selected to Pool"
            },
            "action": {
              "type": "bulk_field_command",
              "command": "crm:move_lead_to_pool",
              "input": {
                "field": "crm_lead_last_pool_id",
                "label": { "zh-CN": "目标线索池", "en-US": "Target Lead Pool" },
                "type": "reference",
                "referenceModelCode": "crm_lead_pool_common",
                "refTarget": {
                  "targetModel": "crm_lead_pool_common",
                  "valueField": "pid",
                  "displayField": "crm_lp_name"
                },
                "required": true
              }
            }
          }
        ]
      },
      "selection": {
        "type": "checkbox"
      },
      "columns": [
        {
          "field": "crm_lead_code",
          "width": 150,
          "sortable": true
        },
        {
          "field": "crm_lead_company",
          "width": 200,
          "ellipsis": true,
          "sortable": true,
          "editable": true
        },
        {
          "field": "crm_lead_contact_name",
          "width": 120,
          "ellipsis": true
        },
        {
          "field": "crm_lead_contact_phone",
          "width": 140
        },
        {
          "field": "crm_lead_source",
          "width": 120,
          "renderType": "tag",
          "dictCode": "crm_lead_source"
        },
        {
          "field": "crm_lead_score",
          "width": 80,
          "sortable": true,
          "editable": true
        },
        {
          "field": "crm_lead_status",
          "width": 120,
          "renderType": "tag",
          "dictCode": "crm_lead_status"
        },
        {
          "field": "crm_lead_assigned_to",
          "width": 120
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "buttons": [
            {
              "code": "view",
              "label": "$i18n:common.button.view",
              "action": {
                "type": "navigate",
                "to": "crm_lead_common_detail"
              }
            },
            {
              "code": "edit",
              "permissionCode": "crm.lead.manage",
              "label": "$i18n:common.button.edit",
              "action": {
                "type": "navigate",
                "to": "crm_lead_common_form"
              }
            },
            {
              "code": "convert_to_customer",
              "permissionCode": "crm.lead.manage",
              "label": { "zh-CN": "转为客户", "en": "Convert to Customer" },
              "visibleWhen": "row.crm_lead_status == 'qualified'",
              "confirm": {
                "zh-CN": "仅创建客户和联系人，不创建商机或客户需求。确认继续？",
                "en": "Create the account and contact only, without an opportunity or customer request?"
              },
              "action": {
                "type": "command",
                "command": "crm:convert_lead_to_customer",
                "operationType": "update"
              }
            },
            {
              "code": "move_to_pool",
              "permissionCode": "crm.lead_pool.move",
              "label": { "zh-CN": "移入线索池", "en": "Move to Pool" },
              "visibleWhen": "row.crm_lead_pool_state != 'in_pool'",
              "mobile": {
                "disabled": true,
                "reason": "Mobile uses the governed target-pool form so the selected pool is saved before the command executes."
              },
              "action": {
                "type": "command",
                "command": "crm:move_lead_to_pool",
                "operationType": "update",
                "inputFieldsTitle": { "zh-CN": "移入线索池", "en": "Move to Lead Pool" },
                "inputFields": [
                  {
                    "field": "crm_lead_last_pool_id",
                    "label": { "zh-CN": "目标线索池", "en": "Target Lead Pool" },
                    "type": "select",
                    "searchable": true,
                    "dataSource": {
                      "type": "api",
                      "endpoint": "/api/dynamic/crm_lead_pool_common/list",
                      "params": { "pageNum": 1, "pageSize": 200 },
                      "valueField": "pid",
                      "labelField": "crm_lp_name"
                    },
                    "required": true
                  }
                ]
              }
            },
            {
              "code": "move_to_pool_mobile",
              "permissionCode": "crm.lead_pool.move",
              "label": { "zh-CN": "移入线索池", "en": "Move to Pool" },
              "visibleWhen": "row.crm_lead_pool_state != 'in_pool'",
              "mobileOnly": true,
              "action": { "type": "navigate", "to": "crm_lead_move_to_pool_form" }
            },
            {
              "code": "delete",
              "danger": true,
              "permissionCode": "crm.lead.manage",
              "label": "$i18n:common.button.delete",
              "confirm": "delete.confirm",
              "action": {
                "type": "command",
                "operationType": "DELETE"
              }
            }
          ],
          "label": "$i18n:common.actions"
        }
      ],
      "searchFields": [
        "crm_lead_company",
        "crm_lead_code",
        "crm_lead_contact_name"
      ],
      "defaultSort": {
        "field": "created_at",
        "order": "desc"
      },
      "searchPlaceholder": {
        "zh-CN": "搜索线索公司、编号或联系人",
        "en": "Search lead company, code, or contact"
      },
      "empty": {
        "title": { "zh-CN": "暂无符合条件的线索", "en": "No matching leads" },
        "description": {
          "zh-CN": "调整筛选，或使用“新建线索”开始录入。",
          "en": "Adjust filters or use Create Lead to start capturing leads."
        }
      }
    }
  ]
}
