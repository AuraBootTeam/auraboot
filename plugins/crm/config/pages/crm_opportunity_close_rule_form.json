{
  "pageKey": "crm_opportunity_close_rule_form", "name:zh-CN": "关单规则编辑", "name:en": "Close Rule Editor", "modelCode": "crm_opportunity_close_rule", "kind": "form", "schemaVersion": 4, "layout": { "type": "grid", "cols": 12, "gap": 16 },
  "blocks": [
    { "id": "rule_identity", "blockType": "form-section", "title": { "zh-CN": "规则身份", "en": "Rule Identity" }, "fields": [ { "field": "crm_ocr_code", "colSpan": 6, "required": true, "placeholder": { "zh-CN": "例如 WIN-AMOUNT", "en": "e.g. WIN-AMOUNT" }, "helpText": { "zh-CN": "使用稳定且唯一的编号，便于审计。", "en": "Use a stable unique code for audit." } }, { "field": "crm_ocr_name", "colSpan": 6, "required": true, "placeholder": { "zh-CN": "例如 赢单金额校验", "en": "e.g. Won amount validation" }, "helpText": { "zh-CN": "名称应说明适用场景与校验目的。", "en": "Name the scenario and validation purpose." } }, { "field": "crm_ocr_status", "colSpan": 6, "required": true, "defaultValue": "active" }, { "field": "crm_ocr_sequence", "colSpan": 6, "required": true, "placeholder": { "zh-CN": "例如 20", "en": "e.g. 20" }, "helpText": { "zh-CN": "数字越小越先校验，首个失败会立即阻止关单。", "en": "Lower values run first; the first failure stops the close." } } ] },
    { "id": "rule_behavior", "blockType": "form-section", "title": { "zh-CN": "校验行为", "en": "Validation Behavior" }, "fields": [ { "field": "crm_ocr_close_type", "colSpan": 6, "required": true }, { "field": "crm_ocr_rule_type", "colSpan": 6, "required": true }, { "field": "crm_ocr_error_message", "colSpan": 12, "placeholder": { "zh-CN": "例如 赢单前请填写大于零的预期金额", "en": "e.g. Enter a positive expected amount before winning" }, "helpText": { "zh-CN": "留空时使用系统内置业务提示；不支持脚本或表达式。", "en": "Leave blank for the built-in message; scripts and expressions are unsupported." } } ] },
    { "id": "rule_buttons", "blockType": "form-buttons", "buttons": [ { "code": "submit", "primary": true, "permissionCode": "crm.opportunity.configure", "label": "$i18n:common.button.save", "action": { "type": "command" } }, { "code": "cancel", "label": "$i18n:common.button.cancel" } ] }
  ]
