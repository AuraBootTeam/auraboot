{
  "pageKey": "crm_activity_common_detail",
  "name:zh-CN": "活动详情",
  "name:en": "Activity Detail",
  "modelCode": "crm_activity_common",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "section_basic",
      "blockType": "form-section",
      "title": {
        "zh-CN": "活动信息",
        "en-US": "Activity Information"
      },
      "columns": 2,
      "fields": [
        {
          "field": "crm_act_type",
          "readOnly": true
        },
        {
          "field": "crm_act_subject",
          "readOnly": true
        },
        {
          "field": "crm_act_date",
          "readOnly": true
        },
        {
          "field": "crm_act_owner",
          "readOnly": true
        },
        {
          "field": "crm_act_source",
          "readOnly": true
        },
        {
          "field": "crm_act_parent_id",
          "readOnly": true
        },
        {
          "field": "crm_act_content",
          "span": 2,
          "readOnly": true
        },
        {
          "field": "crm_act_files",
          "span": 2,
          "readOnly": true
        }
      ]
    },
    {
      "id": "section_related_context",
      "blockType": "form-section",
      "title": {
        "zh-CN": "关联上下文",
        "en-US": "Related Context"
      },
      "columns": 2,
      "fields": [
        {
          "field": "crm_act_related_model",
          "readOnly": true
        },
        {
          "field": "crm_act_related_id",
          "readOnly": true
        }
      ]
    },
    {
      "id": "section_task",
      "blockType": "form-section",
      "title": {
        "zh-CN": "任务详情",
        "en-US": "Task Details"
      },
      "columns": 2,
      "fields": [
        {
          "field": "crm_act_status",
          "readOnly": true
        },
        {
          "field": "crm_act_priority",
          "readOnly": true
        },
        {
          "field": "crm_act_due_date",
          "readOnly": true
        },
        {
          "field": "crm_act_assignee",
          "readOnly": true
        }
      ]
    },
    {
      "id": "section_call_meeting",
      "blockType": "form-section",
      "title": {
        "zh-CN": "通话/会议详情",
        "en-US": "Call/Meeting Details"
      },
      "columns": 2,
      "fields": [
        {
          "field": "crm_act_duration",
          "readOnly": true
        },
        {
          "field": "crm_act_direction",
          "readOnly": true
        },
        {
          "field": "crm_act_location",
          "readOnly": true
        },
        {
          "field": "crm_act_start_time",
          "readOnly": true
        },
        {
          "field": "crm_act_end_time",
          "readOnly": true
        }
      ]
    },
    {
      "id": "activity_followup_comments",
      "blockType": "record-comments",
      "title": {
        "zh-CN": "跟进评论",
        "en-US": "Follow-up Comments"
      }
    },
    {
      "id": "crm_activity_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "edit",
          "icon": "Edit",
          "permissionCode": "crm.activity.manage",
          "label": "$i18n:common.button.edit",
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form"
          }
        },
        {
          "code": "start_task",
          "label": {
            "zh-CN": "开始任务",
            "en-US": "Start Task"
          },
          "visibleWhen": "record.crm_act_type === 'task' && record.crm_act_status === 'open'",
          "action": {
            "type": "state_transition",
            "command": "crm:start_task"
          }
        },
        {
          "code": "complete_task",
          "primary": true,
          "label": {
            "zh-CN": "完成任务",
            "en-US": "Complete Task"
          },
          "visibleWhen": "record.crm_act_type === 'task' && ['open','in_progress'].includes(record.crm_act_status)",
          "action": {
            "type": "state_transition",
            "command": "crm:complete_task"
          }
        },
        {
          "code": "cancel_task",
          "danger": true,
          "label": {
            "zh-CN": "取消任务",
            "en-US": "Cancel Task"
          },
          "visibleWhen": "record.crm_act_type === 'task' && ['open','in_progress'].includes(record.crm_act_status)",
          "action": {
            "type": "state_transition",
            "command": "crm:cancel_task"
          }
        },
        {
          "code": "delete",
          "icon": "Trash2",
          "danger": true,
          "permissionCode": "crm.activity.manage",
          "label": "$i18n:common.button.delete",
          "confirm": {
            "zh-CN": "确定删除这条跟进计划或跟进记录吗？关联评论也将不可见。",
            "en-US": "Delete this follow-up plan or record? Related comments will no longer be visible."
          },
          "action": {
            "type": "command"
          }
        }
      ]
    }
  ]
}
