{
  "pageKey": "crm_activity_common_detail",
  "name:zh-CN": "活动详情",
  "name:en": "Activity Detail",
  "modelCode": "crm_activity_common",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "activity_summary",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "活动信息",
        "en-US": "Activity Information"
      },
      "columns": 2,
      "fields": [
      {
        "field": "crm_act_type",
        "label": { "zh-CN": "活动类型", "en-US": "Activity Type" },
          "readOnly": true
        },
      {
        "field": "crm_act_subject",
        "label": { "zh-CN": "跟进主题", "en-US": "Subject" },
          "readOnly": true
        },
      {
        "field": "crm_act_date",
        "label": { "zh-CN": "活动时间", "en-US": "Activity Time" },
          "readOnly": true
        },
      {
        "field": "crm_act_owner",
        "label": { "zh-CN": "负责人", "en-US": "Owner" },
          "readOnly": true
        },
      {
        "field": "crm_act_source",
        "label": { "zh-CN": "记录来源", "en-US": "Source" },
          "readOnly": true
        },
      {
        "field": "crm_act_parent_id",
        "label": { "zh-CN": "上级活动", "en-US": "Parent Activity" },
          "readOnly": true
        },
      {
        "field": "crm_act_content",
        "label": { "zh-CN": "跟进内容", "en-US": "Follow-up Notes" },
          "span": 2,
          "readOnly": true
        },
      {
        "field": "crm_act_files",
        "label": { "zh-CN": "附件", "en-US": "Attachments" },
          "span": 2,
          "readOnly": true
        }
      ]
    },
    {
      "id": "activity_facts",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "关联事实",
        "en-US": "Related Facts"
      },
      "columns": 2,
      "fields": [
        {
          "field": "crm_act_related_model",
          "readOnly": true
        },
        {
          "field": "crm_act_related_id",
          "readOnly": true
        }
      ]
    },
    {
      "id": "section_task",
      "blockType": "form-section",
      "title": {
        "zh-CN": "任务详情",
        "en-US": "Task Details"
      },
      "columns": 2,
      "fields": [
        {
          "field": "crm_act_status",
          "readOnly": true
        },
        {
          "field": "crm_act_priority",
          "readOnly": true
        },
        {
          "field": "crm_act_due_date",
          "readOnly": true
        },
        {
          "field": "crm_act_assignee",
          "readOnly": true
        }
      ]
    },
    {
      "id": "section_call_meeting",
      "blockType": "form-section",
      "title": {
        "zh-CN": "通话/会议详情",
        "en-US": "Call/Meeting Details"
      },
      "columns": 2,
      "fields": [
        {
          "field": "crm_act_duration",
          "readOnly": true
        },
        {
          "field": "crm_act_direction",
          "readOnly": true
        },
        {
          "field": "crm_act_location",
          "readOnly": true
        },
        {
          "field": "crm_act_start_time",
          "readOnly": true
        },
        {
          "field": "crm_act_end_time",
          "readOnly": true
        }
      ]
    },
    {
      "id": "activity_history",
      "blockType": "sub-table",
      "title": {
        "zh-CN": "跟进履历",
        "en-US": "Follow-up History"
      },
      "subTable": {
        "childModel": "crm_activity_common",
        "parentField": "crm_act_parent_id",
        "readOnly": true,
        "columns": [
          {
            "field": "crm_act_type",
            "width": 100,
            "renderType": "tag",
            "dictCode": "crm_activity_type"
          },
          {
            "field": "crm_act_subject",
            "width": 260
          },
          {
            "field": "crm_act_date",
            "width": 160,
            "format": "YYYY-MM-DD HH:mm"
          },
          {
            "field": "crm_act_owner",
            "width": 140
          }
        ]
      }
    },
    {
      "id": "activity_followup_comments",
      "blockType": "record-comments",
      "title": {
        "zh-CN": "跟进评论",
        "en-US": "Follow-up Comments"
      }
    },
    {
      "id": "crm_activity_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "edit",
          "icon": "Edit",
          "permissionCode": "crm.activity.manage",
          "label": "$i18n:common.button.edit",
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form"
          }
        },
        {
          "code": "start_task",
          "label": {
            "zh-CN": "开始任务",
            "en-US": "Start Task"
          },
          "visibleWhen": "record.crm_act_type === 'task' && record.crm_act_status === 'open'",
          "action": {
            "type": "state_transition",
            "command": "crm:start_task"
          }
        },
        {
          "code": "complete_task",
          "primary": true,
          "label": {
            "zh-CN": "完成任务",
            "en-US": "Complete Task"
          },
          "visibleWhen": "record.crm_act_type === 'task' && ['open','in_progress'].includes(record.crm_act_status)",
          "action": {
            "type": "state_transition",
            "command": "crm:complete_task"
          }
        },
        {
          "code": "cancel_task",
          "danger": true,
          "label": {
            "zh-CN": "取消任务",
            "en-US": "Cancel Task"
          },
          "visibleWhen": "record.crm_act_type === 'task' && ['open','in_progress'].includes(record.crm_act_status)",
          "action": {
            "type": "state_transition",
            "command": "crm:cancel_task"
          }
        },
        {
          "code": "delete_follow_plan",
          "icon": "Trash2",
          "danger": true,
          "permissionCode": "crm.activity.manage",
          "visibleWhen": "record.crm_act_type === 'task'",
          "label": {
            "zh-CN": "删除计划",
            "en-US": "Delete Plan"
          },
          "confirm": {
            "zh-CN": "确认删除此跟进计划？删除后无法恢复，关联评论也将不可见。",
            "en-US": "Delete this follow-up plan? It cannot be restored and related comments will no longer be visible."
          },
          "action": {
            "type": "command",
            "command": "crm:delete_follow_plan"
          }
        },
        {
          "code": "delete_follow_record",
          "icon": "Trash2",
          "danger": true,
          "permissionCode": "crm.activity.manage",
          "visibleWhen": "record.crm_act_type !== 'task'",
          "label": {
            "zh-CN": "删除记录",
            "en-US": "Delete Record"
          },
          "confirm": {
            "zh-CN": "确认删除此跟进记录？删除后无法恢复，关联评论也将不可见。",
            "en-US": "Delete this follow-up record? It cannot be restored and related comments will no longer be visible."
          },
          "action": {
            "type": "command",
            "command": "crm:delete_follow_record"
          }
        }
      ]
    }
  ]
}
