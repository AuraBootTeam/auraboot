{
  "pageKey": "crm_complaint_list",
  "name:zh-CN": "投诉列表",
  "name:en": "Complaints",
  "modelCode": "crm_complaint",
  "kind": "list",
  "schemaVersion": 4,
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "crm_cmp_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "all",
          "label": {
            "en": "All",
            "zh-CN": "全部"
          },
          "filter": null
        },
        {
          "key": "open",
          "label": {
            "en": "Open",
            "zh-CN": "待处理"
          },
          "filter": {
            "field": "crm_cmp_status",
            "value": "open",
            "operator": "EQ"
          }
        },
        {
          "key": "investigating",
          "label": {
            "en": "Investigating",
            "zh-CN": "调查中"
          },
          "filter": {
            "field": "crm_cmp_status",
            "value": "investigating",
            "operator": "EQ"
          }
        },
        {
          "key": "resolved",
          "label": {
            "en": "Resolved",
            "zh-CN": "已解决"
          },
          "filter": {
            "field": "crm_cmp_status",
            "value": "resolved",
            "operator": "EQ"
          }
        },
        {
          "key": "closed",
          "label": {
            "en": "Closed",
            "zh-CN": "已关闭"
          },
          "filter": {
            "field": "crm_cmp_status",
            "value": "closed",
            "operator": "EQ"
          }
        }
      ]
    },
    {
      "id": "crm_cmp_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "permissionCode": "crm.complaint.manage",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_complaint_form"
          }
        }
      ]
    },
    {
      "id": "crm_cmp_table",
      "blockType": "table",
      "columns": [
        {
          "field": "crm_cmp_code",
          "width": 150,
          "sortable": true
        },
        {
          "field": "crm_cmp_account_id",
          "width": 200
        },
        {
          "field": "crm_cmp_type",
          "width": 120,
          "renderType": "tag",
          "dictCode": "crm_complaint_type"
        },
        {
          "field": "crm_cmp_severity",
          "width": 100,
          "renderType": "tag",
          "dictCode": "crm_severity"
        },
        {
          "field": "crm_cmp_status",
          "width": 100,
          "renderType": "tag",
          "dictCode": "crm_complaint_status"
        },
        {
          "field": "crm_cmp_date",
          "width": 160,
          "sortable": true,
          "format": "YYYY-MM-DD HH:mm"
        },
        {
          "field": "crm_cmp_resolution_date",
          "width": 160
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "buttons": [
            {
              "code": "view",
              "label": "$i18n:common.button.view",
              "action": {
                "type": "navigate",
                "to": "crm_complaint_detail"
              }
            },
            {
              "code": "edit",
              "permissionCode": "crm.complaint.manage",
              "label": "$i18n:common.button.edit",
              "action": {
                "type": "navigate",
                "to": "crm_complaint_form"
              }
            },
            {
              "code": "delete",
              "danger": true,
              "permissionCode": "crm.complaint.manage",
              "label": "$i18n:common.button.delete",
              "confirm": "delete.confirm",
              "action": {
                "type": "command"
              }
            }
          ],
          "label": "$i18n:common.actions"
        }
      ],
      "searchFields": [
        "crm_cmp_code"
      ],
      "defaultSort": {
        "field": "crm_cmp_date",
        "order": "desc"
      }
    }
  ]
}
