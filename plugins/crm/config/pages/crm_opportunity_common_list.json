{
  "pageKey": "crm_opportunity_common_list",
  "name:zh-CN": "商机列表",
  "name:en": "Opportunities",
  "modelCode": "crm_opportunity_common",
  "kind": "list",
  "schemaVersion": 4,
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "crm_opp_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "all",
          "label": {
            "en": "All",
            "zh-CN": "全部"
          },
          "filter": null
        },
        {
          "key": "qualification",
          "label": {
            "en": "Qualification",
            "zh-CN": "资格确认"
          },
          "filter": {
            "field": "crm_opp_stage",
            "value": "qualification",
            "operator": "EQ"
          }
        },
        {
          "key": "proposal",
          "label": {
            "en": "Proposal",
            "zh-CN": "方案提报"
          },
          "filter": {
            "field": "crm_opp_stage",
            "value": "proposal",
            "operator": "EQ"
          }
        },
        {
          "key": "negotiation",
          "label": {
            "en": "Negotiation",
            "zh-CN": "商务谈判"
          },
          "filter": {
            "field": "crm_opp_stage",
            "value": "negotiation",
            "operator": "EQ"
          }
        },
        {
          "key": "closed_won",
          "label": {
            "en": "Won",
            "zh-CN": "赢单"
          },
          "filter": {
            "field": "crm_opp_stage",
            "value": "closed_won",
            "operator": "EQ"
          }
        },
        {
          "key": "closed_lost",
          "label": {
            "en": "Lost",
            "zh-CN": "丢单"
          },
          "filter": {
            "field": "crm_opp_stage",
            "value": "closed_lost",
            "operator": "EQ"
          }
        }
      ]
    },
    {
      "id": "crm_opp_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "permissionCode": "crm.opportunity.manage",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_opportunity_common_form"
          }
        }
      ]
    },
    {
      "id": "crm_opp_table",
      "blockType": "table",
      "table": {
        "selection": {
          "mode": "multiple",
          "bind": "{{state.selectedIds}}"
        },
        "bulkCapabilities": {
          "edit": {
            "permissionCode": "crm.opportunity.manage"
          },
          "delete": {
            "permissionCode": "crm.opportunity.manage"
          },
          "export": {
            "permissionCode": "crm.opportunity.read"
          }
        },
        "bulkActions": [
          {
            "code": "bulk_qualify",
            "permissionCode": "crm.opportunity.manage",
            "label": {
              "zh-CN": "批量资格确认",
              "en-US": "Qualify Selected"
            },
            "action": {
              "type": "bulk_state_transition",
              "command": "crm:qualify_opportunity"
            }
          },
          {
            "code": "bulk_advance_proposal",
            "permissionCode": "crm.opportunity.manage",
            "label": {
              "zh-CN": "批量推进方案",
              "en-US": "Advance to Proposal"
            },
            "action": {
              "type": "bulk_state_transition",
              "command": "crm:advance_opp_to_proposal"
            }
          },
          {
            "code": "bulk_advance_negotiation",
            "permissionCode": "crm.opportunity.manage",
            "label": {
              "zh-CN": "批量推进谈判",
              "en-US": "Advance to Negotiation"
            },
            "action": {
              "type": "bulk_state_transition",
              "command": "crm:advance_opp_to_negotiation"
            }
          },
          {
            "code": "bulk_mark_lost",
            "permissionCode": "crm.opportunity.manage",
            "variant": "danger",
            "label": {
              "zh-CN": "批量标记丢单",
              "en-US": "Mark Selected Lost"
            },
            "confirm": {
              "zh-CN": "确定将选中的商机标记为丢单吗？不符合当前阶段的记录会被拒绝。",
              "en-US": "Mark selected opportunities as lost? Records in an invalid stage will be rejected."
            },
            "action": {
              "type": "bulk_state_transition",
              "command": "crm:lose_opportunity"
            }
          }
        ]
      },
      "columns": [
        {
          "field": "crm_opp_code",
          "width": 150,
          "sortable": true
        },
        {
          "field": "crm_opp_name",
          "width": 200,
          "sortable": true
        },
        {
          "field": "crm_opp_account_id",
          "width": 180
        },
        {
          "field": "crm_opp_stage",
          "width": 120,
          "renderType": "tag",
          "dictCode": "crm_opp_stage"
        },
        {
          "field": "crm_opp_forecast_category",
          "width": 120,
          "renderType": "tag",
          "dictCode": "crm_forecast_category"
        },
        {
          "field": "crm_opp_expected_amount",
          "width": 140,
          "sortable": true,
          "editable": true
        },
        {
          "field": "crm_opp_expected_close_date",
          "width": 140,
          "valueType": "date",
          "editable": true
        },
        {
          "field": "crm_opp_probability",
          "width": 100,
          "editable": true
        },
        {
          "field": "crm_opp_owner",
          "width": 120
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "buttons": [
            {
              "code": "view",
              "label": "$i18n:common.button.view",
              "action": {
                "type": "navigate",
                "to": "crm_opportunity_common_detail"
              }
            },
            {
              "code": "edit",
              "permissionCode": "crm.opportunity.manage",
              "label": "$i18n:common.button.edit",
              "action": {
                "type": "navigate",
                "to": "crm_opportunity_common_form"
              }
            },
            {
              "code": "delete",
              "danger": true,
              "permissionCode": "crm.opportunity.manage",
              "label": "$i18n:common.button.delete",
              "confirm": "delete.confirm",
              "action": {
                "type": "command"
              }
            }
          ],
          "label": "$i18n:common.actions"
        }
      ],
      "searchFields": [
        "crm_opp_name",
        "crm_opp_code"
      ],
      "defaultSort": {
        "field": "created_at",
        "order": "desc"
      }
    }
  ],
  "extension": {
    "enableMultiView": true
  }
}
