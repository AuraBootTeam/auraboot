{
  "pageKey": "crm_opportunity_common_detail",
  "name:zh-CN": "商机详情",
  "name:en": "Opportunity Detail",
  "modelCode": "crm_opportunity_common",
  "description": "Opportunity detail with line items, contacts, activities, and quotes",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "extension": {
    "showShare": false,
    "showReport": false,
    "showPrint": false,
    "showEdit": false,
    "headerTitleField": "crm_opp_name",
    "headerSubtitleFields": [
      "crm_opp_code",
      "crm_opp_account_id"
    ],
    "preserveListContext": true,
    "contributionSlots": [
      {
        "id": "line-items.before",
        "kind": "block",
        "anchor": {
          "target": "tab-blocks",
          "blockId": "crm_opportunity_tabs",
          "tabKey": "line_items"
        }
      },
      {
        "id": "line-items.actions",
        "kind": "action",
        "anchor": {
          "target": "sub-table-actions",
          "blockId": "block_line_items"
        }
      }
    ]
  },
  "blocks": [
    {
      "id": "crm_opp_stage_rail",
      "blockType": "stage-rail",
      "detailPlacement": "header",
      "context": "${record}",
      "stageField": "crm_opp_stage",
      "title": {
        "zh-CN": "销售阶段",
        "en-US": "Sales Stage"
      },
      "stages": [
        { "value": "discovery", "label": { "zh-CN": "需求发现", "en-US": "Discovery" } },
        { "value": "qualification", "label": { "zh-CN": "资格确认", "en-US": "Qualification" } },
        { "value": "proposal", "label": { "zh-CN": "方案报价", "en-US": "Proposal" } },
        { "value": "negotiation", "label": { "zh-CN": "商务谈判", "en-US": "Negotiation" } },
        { "value": "closed_won", "label": { "zh-CN": "赢单", "en-US": "Won" } }
      ],
      "terminalStages": [
        { "value": "closed_lost", "label": { "zh-CN": "已丢单", "en-US": "Lost" }, "tone": "red" }
      ]
    },
    {
      "id": "crm_opportunity_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "overview",
          "label": {
            "zh-CN": "概览",
            "en-US": "Overview"
          },
          "blocks": [
            {
              "id": "section_basic",
              "blockType": "form-section",
              "title": {
                "zh-CN": "商机信息",
                "en-US": "Opportunity Information"
              },
              "columns": 2,
              "fields": [
                {
                  "field": "crm_opp_code",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_name",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_account_id",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_lead_id",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_stage",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_expected_amount",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_currency_code",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_exchange_rate",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_expected_amount_base",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_base_currency_code",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_expected_close_date",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_probability",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_owner",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_forecast_category",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_competitor",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_lost_reason_code",
                  "readOnly": true
                },
                {
                  "field": "crm_opp_notes",
                  "span": 2,
                  "readOnly": true
                },
                {
                  "field": "crm_opp_lost_reason",
                  "span": 2,
                  "readOnly": true
                }
              ]
            },
            {
              "id": "block_recent_activities",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "最近活动与下一步",
                "en-US": "Recent Activity and Next Steps"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "dataSource": {
                  "type": "api",
                  "url": "/api/datasource/list",
                  "params": {
                    "datasourceId": "nq:crm_activities_by_object",
                    "objectType": "opportunity",
                    "objectId": "${recordPid}",
                    "format": "records"
                  }
                },
                "readOnly": true,
                "maxHeight": 280,
                "columns": [
                  {
                    "field": "crm_act_type",
                    "width": 110,
                    "renderType": "tag",
                    "dictCode": "crm_activity_type"
                  },
                  {
                    "field": "crm_act_subject",
                    "width": 260
                  },
                  {
                    "field": "crm_act_date",
                    "width": 170,
                    "valueType": "datetime"
                  },
                  {
                    "field": "owner_name",
                    "width": 140,
                    "label": {
                      "zh-CN": "负责人",
                      "en-US": "Owner"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "plan_and_quotes",
          "label": {
            "zh-CN": "报价与计划",
            "en-US": "Quotes & Plan"
          },
          "blocks": [
            {
              "id": "crm_opp_plan_quote_actions",
              "blockType": "toolbar",
              "buttons": [
                {
                  "code": "create_plan_task",
                  "icon": "CheckSquare",
                  "permissionCode": "crm.activity.manage",
                  "label": {
                    "zh-CN": "安排下一任务",
                    "en-US": "Plan Next Task"
                  },
                  "action": {
                    "type": "navigate",
                    "to": "crm_activity_common_form",
                    "command": "crm:create_opp_task"
                  }
                },
                {
                  "code": "log_plan_activity",
                  "icon": "MessageSquare",
                  "permissionCode": "crm.activity.manage",
                  "label": {
                    "zh-CN": "记录客户互动",
                    "en-US": "Log Customer Activity"
                  },
                  "action": {
                    "type": "navigate",
                    "to": "crm_activity_common_form",
                    "command": "crm:log_opp_activity"
                  }
                },
                {
                  "code": "create_quote_summary",
                  "icon": "FileText",
                  "primary": true,
                  "permissionCode": "crm.quote_summary.manage",
                  "label": {
                    "zh-CN": "新建报价摘要",
                    "en-US": "Create Quote Summary"
                  },
                  "action": {
                    "type": "navigate",
                    "to": "/p/crm_quote_summary_common/new?dv.crm_qs_opportunity_id={pid}&dv.crm_qs_account_id={crm_opp_account_id}",
                    "command": "crm:create_quote_summary"
                  }
                }
              ]
            },
            {
              "id": "block_opportunity_plan",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "计划与跟进",
                "en-US": "Plan and Follow-up"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "dataSource": {
                  "type": "api",
                  "url": "/api/datasource/list",
                  "params": {
                    "datasourceId": "nq:crm_activities_by_object",
                    "objectType": "opportunity",
                    "objectId": "${recordPid}",
                    "format": "records"
                  }
                },
                "readOnly": true,
                "maxHeight": 320,
                "actions": [
                  {
                    "code": "view_task",
                    "permissionCode": "crm.activity.read",
                    "label": {
                      "zh-CN": "查看",
                      "en-US": "View"
                    },
                    "action": {
                      "type": "navigate",
                      "to": "crm_activity_common_detail"
                    }
                  },
                  {
                    "code": "start_task",
                    "permissionCode": "crm.activity.manage",
                    "visibleWhen": "row.crm_act_type === 'task' && row.crm_act_status === 'open'",
                    "label": {
                      "zh-CN": "开始",
                      "en-US": "Start"
                    },
                    "action": {
                      "type": "state_transition",
                      "command": "crm:start_task"
                    }
                  },
                  {
                    "code": "complete_task",
                    "permissionCode": "crm.activity.manage",
                    "visibleWhen": "row.crm_act_type === 'task' && (row.crm_act_status === 'open' || row.crm_act_status === 'in_progress')",
                    "label": {
                      "zh-CN": "完成",
                      "en-US": "Complete"
                    },
                    "action": {
                      "type": "state_transition",
                      "command": "crm:complete_task"
                    }
                  },
                  {
                    "code": "cancel_task",
                    "permissionCode": "crm.activity.manage",
                    "danger": true,
                    "visibleWhen": "row.crm_act_type === 'task' && (row.crm_act_status === 'open' || row.crm_act_status === 'in_progress')",
                    "label": {
                      "zh-CN": "取消",
                      "en-US": "Cancel"
                    },
                    "confirm": {
                      "zh-CN": "确定取消该跟进任务？取消后不可再开始或完成。",
                      "en-US": "Cancel this follow-up task? A cancelled task cannot be started or completed."
                    },
                    "action": {
                      "type": "state_transition",
                      "command": "crm:cancel_task"
                    }
                  }
                ],
                "columns": [
                  {
                    "field": "crm_act_type",
                    "width": 105,
                    "renderType": "tag",
                    "dictCode": "crm_activity_type"
                  },
                  {
                    "field": "crm_act_subject",
                    "width": 260
                  },
                  {
                    "field": "crm_act_status",
                    "width": 110,
                    "renderType": "tag",
                    "dictCode": "crm_task_status"
                  },
                  {
                    "field": "crm_act_priority",
                    "width": 105,
                    "renderType": "tag",
                    "dictCode": "crm_task_priority"
                  },
                  {
                    "field": "crm_act_due_date",
                    "width": 125,
                    "valueType": "date"
                  },
                  {
                    "field": "owner_name",
                    "width": 140,
                    "label": {
                      "zh-CN": "负责人",
                      "en-US": "Owner"
                    }
                  }
                ]
              }
            },
            {
              "id": "block_opportunity_quotes",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "报价摘要",
                "en-US": "Quote Summaries"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_quote_summary_common",
                "parentField": "crm_qs_opportunity_id",
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_qs_code",
                    "width": 150
                  },
                  {
                    "field": "crm_qs_status",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_quote_summary_status"
                  },
                  {
                    "field": "crm_qs_quote_amount",
                    "width": 145,
                    "align": "right",
                    "valueType": "currency"
                  },
                  {
                    "field": "crm_qs_valid_until",
                    "width": 130,
                    "valueType": "date"
                  },
                  {
                    "field": "crm_qs_customer_feedback_status",
                    "width": 140,
                    "renderType": "tag",
                    "dictCode": "crm_quote_summary_feedback_status"
                  },
                  {
                    "field": "crm_qs_won_lost_result",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_quote_summary_result"
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "line_items",
          "label": {
            "zh-CN": "行项",
            "en-US": "Line Items"
          },
          "blocks": [
            {
              "id": "block_line_items",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "行项",
                "en-US": "Line Items"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_opportunity_line_common",
                "parentField": "crm_ol_opportunity_id",
                "readOnly": false,
                "columns": [
                  {
                    "field": "crm_ol_product_name",
                    "width": 200
                  },
                  {
                    "field": "crm_ol_quantity",
                    "width": 100,
                    "align": "right"
                  },
                  {
                    "field": "crm_ol_unit_price",
                    "width": 120,
                    "align": "right"
                  },
                  {
                    "field": "crm_ol_unit_cost",
                    "width": 120,
                    "align": "right"
                  },
                  {
                    "field": "crm_ol_discount",
                    "width": 100,
                    "align": "right"
                  },
                  {
                    "field": "crm_ol_amount",
                    "width": 120,
                    "align": "right"
                  },
                  {
                    "field": "crm_ol_notes",
                    "width": 200
                  }
                ],
                "actions": [
                  {
                    "code": "add",
                    "label": "$i18n:common.button.create",
                    "action": {
                      "type": "command",
                      "command": "crm:create_opp_line"
                    }
                  },
                  {
                    "code": "edit",
                    "label": "$i18n:common.button.edit",
                    "action": {
                      "type": "command",
                      "command": "crm:update_opp_line"
                    }
                  },
                  {
                    "code": "delete",
                    "danger": true,
                    "label": "$i18n:common.button.delete",
                    "action": {
                      "type": "command",
                      "command": "crm:delete_opp_line"
                    }
                  }
                ],
                "summary": {
                  "fields": [
                    {
                      "field": "crm_ol_amount",
                      "aggregation": "sum",
                      "label": {
                        "zh-CN": "合计",
                        "en-US": "Total"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "key": "related",
          "label": {
            "zh-CN": "关联",
            "en-US": "Related"
          },
          "blocks": [
            {
              "id": "block_contacts",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "联系人",
                "en-US": "Contacts"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_opportunity_contact_common",
                "parentField": "crm_oc_opportunity_id",
                "readOnly": false,
                "columns": [
                  {
                    "field": "crm_oc_contact_id",
                    "width": 200
                  },
                  {
                    "field": "crm_oc_role",
                    "width": 150,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_oc_is_primary",
                    "width": 100
                  }
                ],
                "actions": [
                  {
                    "code": "add",
                    "label": "$i18n:common.button.create",
                    "action": {
                      "type": "command",
                      "command": "crm:add_opp_contact"
                    }
                  },
                  {
                    "code": "delete",
                    "danger": true,
                    "label": "$i18n:common.button.delete",
                    "action": {
                      "type": "command",
                      "command": "crm:remove_opp_contact"
                    }
                  }
                ]
              }
            },
            {
              "id": "block_customer_requests",
              "blockType": "sub-table",
              "title": {
                "zh-CN": "客户需求",
                "en-US": "Customer Requests"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "childModel": "crm_customer_request_common",
                "parentField": "crm_cr_opportunity_id",
                "readOnly": false,
                "columns": [
                  {
                    "field": "crm_cr_code",
                    "width": 150
                  },
                  {
                    "field": "crm_cr_title",
                    "width": 240
                  },
                  {
                    "field": "crm_cr_type",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_customer_request_type"
                  },
                  {
                    "field": "crm_cr_status",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_customer_request_status"
                  },
                  {
                    "field": "crm_cr_route_status",
                    "width": 120,
                    "renderType": "tag",
                    "dictCode": "crm_customer_request_route_status"
                  },
                  {
                    "field": "crm_cr_expected_date",
                    "width": 140
                  }
                ],
                "actions": [
                  {
                    "code": "add",
                    "label": "$i18n:common.button.create",
                    "action": {
                      "type": "navigate",
                      "to": "crm_customer_request_common_form",
                      "command": "crm:create_customer_request"
                    }
                  },
                  {
                    "code": "view",
                    "label": "$i18n:common.button.view",
                    "action": {
                      "type": "navigate",
                      "to": "crm_customer_request_common_detail"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "activities",
          "label": {
            "zh-CN": "活动",
            "en-US": "Activities"
          },
          "blocks": [
            {
              "id": "block_activities",
              "blockType": "activity-timeline",
              "title": {
                "zh-CN": "活动",
                "en-US": "Activities"
              },
              "layout": {
                "colSpan": 12
              },
              "subTable": {
                "dataSource": {
                  "type": "api",
                  "url": "/api/datasource/list",
                  "params": {
                    "datasourceId": "nq:crm_activities_by_object",
                    "objectType": "opportunity",
                    "objectId": "${recordPid}",
                    "format": "records"
                  }
                },
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_act_type",
                    "width": 100,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_act_subject",
                    "width": 200
                  },
                  {
                    "field": "crm_act_date",
                    "width": 160,
                    "format": "YYYY-MM-DD HH:mm"
                  },
                  {
                    "field": "owner_name",
                    "width": 120
                  },
                  {
                    "field": "crm_ar_role",
                    "width": 100,
                    "renderType": "tag"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "crm_opp_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "edit",
          "icon": "Edit",
          "permissionCode": "crm.opportunity.manage",
          "label": "$i18n:common.button.edit",
          "action": {
            "type": "navigate",
            "to": "crm_opportunity_common_form"
          }
        },
        {
          "code": "log_activity",
          "icon": "MessageSquare",
          "label": {
            "zh-CN": "记录活动",
            "en-US": "Log Activity"
          },
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:log_opp_activity"
          }
        },
        {
          "code": "create_task",
          "icon": "CheckSquare",
          "label": {
            "zh-CN": "创建任务",
            "en-US": "Create Task"
          },
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:create_opp_task"
          }
        },
        {
          "code": "create_customer_request",
          "icon": "Inbox",
          "permissionCode": "crm.customer_request.manage",
          "label": {
            "zh-CN": "创建需求",
            "en-US": "Create Request"
          },
          "action": {
            "type": "navigate",
            "to": "/p/crm_customer_request_common/new?dv.crm_cr_opportunity_id={pid}&dv.crm_cr_account_id={crm_opp_account_id}&dv.crm_cr_lead_id={crm_opp_lead_id}",
            "command": "crm:create_customer_request"
          }
        },
        {
          "code": "qualify",
          "primary": true,
          "visibleWhen": "record.crm_opp_stage == 'discovery'",
          "label": {
            "zh-CN": "资格确认",
            "en-US": "Qualify Opportunity"
          },
          "action": {
            "type": "state_transition",
            "command": "crm:qualify_opportunity"
          }
        },
        {
          "code": "advance_proposal",
          "primary": true,
          "visibleWhen": "record.crm_opp_stage == 'qualification'",
          "label": {
            "zh-CN": "推进到方案阶段",
            "en-US": "Advance to Proposal"
          },
          "action": {
            "type": "command",
            "command": "crm:advance_opp_to_proposal"
          }
        },
        {
          "code": "advance_negotiation",
          "primary": true,
          "visibleWhen": "record.crm_opp_stage == 'proposal'",
          "label": {
            "zh-CN": "推进到谈判阶段",
            "en-US": "Advance to Negotiation"
          },
          "action": {
            "type": "command",
            "command": "crm:advance_opp_to_negotiation"
          }
        },
        {
          "code": "win",
          "primary": true,
          "visibleWhen": "record.crm_opp_stage == 'negotiation'",
          "label": {
            "zh-CN": "赢单",
            "en-US": "Win Opportunity"
          },
          "confirm": "crm.opportunity.win.confirm",
          "action": {
            "type": "state_transition",
            "command": "crm:win_opportunity"
          }
        },
        {
          "code": "lose",
          "danger": true,
          "visibleWhen": "record.crm_opp_stage != 'closed_won' && record.crm_opp_stage != 'closed_lost'",
          "label": {
            "zh-CN": "丢单",
            "en-US": "Lose Opportunity"
          },
          "confirm": "crm.opportunity.lose.confirm",
          "action": {
            "type": "state_transition",
            "command": "crm:lose_opportunity"
          }
        }
      ]
    }
  ]
}
