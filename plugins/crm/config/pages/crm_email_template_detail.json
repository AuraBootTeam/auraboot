{
  "pageKey": "crm_email_template_detail",
  "name:zh-CN": "邮件模板详情",
  "name:en": "Email Template Detail",
  "modelCode": "crm_email_template",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "block_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "overview",
          "label": {
            "zh-CN": "概览",
            "en-US": "Overview"
          },
          "blocks": [
            {
              "id": "section_basic",
              "blockType": "form-section",
              "title": {
                "zh-CN": "模板信息",
                "en-US": "Template Information"
              },
              "columns": 2,
              "fields": [
                {
                  "field": "crm_et_name",
                  "readOnly": true
                },
                {
                  "field": "crm_et_category",
                  "readOnly": true
                },
                {
                  "field": "crm_et_status",
                  "readOnly": true
                },
                {
                  "field": "crm_et_subject",
                  "span": 2,
                  "readOnly": true
                },
                {
                  "field": "crm_et_description",
                  "span": 2,
                  "readOnly": true
                }
              ]
            },
            {
              "id": "section_content",
              "blockType": "form-section",
              "title": {
                "zh-CN": "邮件内容",
                "en-US": "Email Content"
              },
              "columns": 1,
              "fields": [
                {
                  "field": "crm_et_body",
                  "span": 1,
                  "readOnly": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "crm_et_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "edit",
          "icon": "Edit",
          "permissionCode": "crm.email_template.manage",
          "label": "$i18n:common.button.edit",
          "action": {
            "type": "navigate",
            "to": "crm_email_template_form"
          }
        },
        {
          "code": "activate",
          "primary": true,
          "label": {
            "zh-CN": "启用模板",
            "en-US": "Activate Template"
          },
          "action": {
            "type": "state_transition",
            "command": "crm:activate_email_template"
          }
        },
        {
          "code": "archive",
          "label": {
            "zh-CN": "归档模板",
            "en-US": "Archive Template"
          },
          "action": {
            "type": "command",
            "command": "crm:archive_email_template"
          }
        }
      ]
    }
  ]
}
