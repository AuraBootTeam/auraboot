{
  "pageKey": "crm_review_common_detail",
  "name:zh-CN": "评审详情",
  "name:en": "Review Detail",
  "modelCode": "crm_review_common",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "crm_rv_facts",
      "blockType": "detail-section",
      "title": {
        "zh-CN": "评审事实",
        "en": "Review Facts"
      },
      "fields": [
        {
          "field": "crm_rv_code",
          "colSpan": 6
        },
        {
          "field": "crm_rv_title",
          "colSpan": 6
        },
        {
          "field": "crm_rv_review_type",
          "colSpan": 6
        },
        {
          "field": "crm_rv_status",
          "colSpan": 6
        },
        {
          "field": "crm_rv_priority",
          "colSpan": 6
        },
        {
          "field": "crm_rv_account_id",
          "colSpan": 6
        },
        {
          "field": "crm_rv_customer_request_id",
          "colSpan": 6
        },
        {
          "field": "crm_rv_reviewer_id",
          "colSpan": 6
        },
        {
          "field": "crm_rv_conclusion",
          "colSpan": 12
        },
        {
          "field": "crm_rv_recommendation",
          "colSpan": 12
        },
        {
          "field": "crm_rv_source_model",
          "colSpan": 6
        },
        {
          "field": "crm_rv_source_id",
          "colSpan": 6
        },
        {
          "field": "crm_rv_submitted_at",
          "colSpan": 6
        },
        {
          "field": "crm_rv_decided_at",
          "colSpan": 6
        },
        {
          "field": "crm_rv_common_payload",
          "colSpan": 12
        }
      ]
    },
    {
      "id": "crm_rv_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "start_review",
          "icon": "Play",
          "permissionCode": "crm.review.manage",
          "label": {
            "zh-CN": "开始评审",
            "en-US": "Start Review"
          },
          "action": {
            "type": "state_transition",
            "command": "crm:start_review"
          },
          "visibleWhen": "record.crm_rv_status === 'pending'"
        },
        {
          "code": "pass_review",
          "icon": "CheckCircle2",
          "permissionCode": "crm.review.manage",
          "label": {
            "zh-CN": "评审通过",
            "en-US": "Pass"
          },
          "action": {
            "type": "state_transition",
            "command": "crm:pass_review"
          },
          "visibleWhen": "record.crm_rv_status === 'in_review'"
        },
        {
          "code": "conditional_review",
          "icon": "AlertTriangle",
          "permissionCode": "crm.review.manage",
          "label": {
            "zh-CN": "条件通过",
            "en-US": "Conditional"
          },
          "action": {
            "type": "state_transition",
            "command": "crm:flag_review_conditional"
          },
          "visibleWhen": "record.crm_rv_status === 'in_review'"
        },
        {
          "code": "fail_review",
          "icon": "XCircle",
          "permissionCode": "crm.review.manage",
          "label": {
            "zh-CN": "评审不通过",
            "en-US": "Fail"
          },
          "action": {
            "type": "state_transition",
            "command": "crm:fail_review"
          },
          "visibleWhen": "record.crm_rv_status === 'in_review'"
        },
        {
          "code": "cancel_review",
          "icon": "Ban",
          "permissionCode": "crm.review.manage",
          "label": {
            "zh-CN": "取消评审",
            "en-US": "Cancel Review"
          },
          "action": {
            "type": "state_transition",
            "command": "crm:cancel_review"
          },
          "visibleWhen": "['pending','in_review'].includes(record.crm_rv_status)"
        },
        {
          "code": "edit",
          "icon": "Edit",
          "permissionCode": "crm.review.manage",
          "label": "$i18n:common.button.edit",
          "action": {
            "type": "navigate",
            "to": "crm_review_common_form"
          }
        }
      ]
    }
  ]
}
