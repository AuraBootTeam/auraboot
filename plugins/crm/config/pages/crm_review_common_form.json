      },
      "columns": 2,
      "fields": [
        {
          "field": "crm_rv_title",
          "layout": {
            "colSpan": 6
          },
          "required": true
        },
        {
          "field": "crm_rv_account_id",
          "layout": {
            "colSpan": 6
          }
        },
        {
          "field": "crm_rv_customer_request_id",
          "layout": {
            "colSpan": 6
          }
        },
        {
          "field": "crm_rv_reviewer_id",
          "layout": {
            "colSpan": 6
          }
        },
        {
          "field": "crm_rv_source_model",
          "layout": {
            "colSpan": 6
          }
        },
        {
          "field": "crm_rv_source_id",
          "layout": {
            "colSpan": 6
          }
        }
      ]
    },
    {
      "id": "crm_rv_status",
      "blockType": "form-section",
      "title": {
        "zh-CN": "状态与时间",
        "en": "Status & Timing"
