        {
          "field": "crm_rv_recommendation",
          "layout": {
            "colSpan": 12
          }
        },
        {
          "field": "crm_rv_common_payload",
          "layout": {
            "colSpan": 12
          }
        }
      ]
    },
    {
      "id": "crm_rv_buttons",
      "blockType": "form-buttons",
      "layout": {
        "colSpan": 12
      },
      "buttons": [
        {
          "code": "save",
          "primary": true,
          "label": "$i18n:common.button.save",
          "action": {
            "type": "command"
          }
        },
        {
          "code": "cancel",
          "label": "$i18n:common.button.cancel",
          "action": {
            "type": "builtin",
            "name": "back"
          }
        }
