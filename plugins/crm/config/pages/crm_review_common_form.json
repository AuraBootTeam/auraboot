          }
        },
        {
          "field": "crm_rv_status",
          "layout": {
            "colSpan": 4
          }
        },
        {
          "field": "crm_rv_priority",
          "layout": {
            "colSpan": 4
          }
        },
        {
          "field": "crm_rv_submitted_at",
          "layout": {
            "colSpan": 4
          }
        },
        {
          "field": "crm_rv_decided_at",
          "layout": {
            "colSpan": 4
          }
        }
