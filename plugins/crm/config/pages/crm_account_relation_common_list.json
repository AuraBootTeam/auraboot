{
  "pageKey": "crm_account_relation_common_list",
  "name:zh-CN": "客户关系列表",
  "name:en": "Account Relationships",
  "modelCode": "crm_account_relation_common",
  "kind": "list",
  "schemaVersion": 4,
  "layout": { "type": "grid", "cols": 12 },
  "blocks": [
    {
      "id": "relationship_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "permissionCode": "crm.account.manage",
          "label": { "zh-CN": "新增关系", "en-US": "Add Relationship" },
          "action": { "type": "navigate", "to": "crm_account_relation_common_form" }
        }
      ]
    },
    {
      "id": "relationship_table",
      "blockType": "table",
      "table": {
        "selection": { "mode": "multiple", "bind": "{{state.selectedIds}}" },
        "bulkCapabilities": {
          "delete": { "permissionCode": "crm.account.manage" }
        }
      },
      "columns": [
        { "field": "crm_acr_source_account_id", "width": 220 },
        { "field": "crm_acr_target_account_id", "width": 220 },
        { "field": "crm_acr_relation_type", "width": 130, "renderType": "tag", "dictCode": "crm_account_relation_type" },
        { "field": "crm_acr_strength", "width": 110, "renderType": "tag", "dictCode": "crm_account_relation_strength" },
        { "field": "crm_acr_status", "width": 100, "renderType": "tag", "dictCode": "crm_account_relation_status" },
        { "field": "crm_acr_effective_from", "width": 120 },
        { "field": "crm_acr_effective_to", "width": 120 },
        { "field": "crm_acr_owner", "width": 130 },
        {
          "field": "actions",
          "isActionColumn": true,
          "label": "$i18n:common.actions",
          "buttons": [
            { "code": "view", "label": "$i18n:common.button.view", "action": { "type": "navigate", "to": "crm_account_relation_common_detail" } },
            { "code": "edit", "permissionCode": "crm.account.manage", "label": "$i18n:common.button.edit", "action": { "type": "navigate", "to": "crm_account_relation_common_form" } },
            { "code": "delete", "danger": true, "permissionCode": "crm.account.manage", "label": "$i18n:common.button.delete", "confirm": { "zh-CN": "确认删除此客户关系？", "en-US": "Delete this account relationship?" }, "action": { "type": "command", "command": "crm:delete_account_relation" } }
          ]
        }
      ],
      "searchFields": ["crm_acr_source_account_id", "crm_acr_target_account_id", "crm_acr_relation_type"],
      "defaultSort": { "field": "updated_at", "order": "desc" },
      "empty": {
        "title": { "zh-CN": "暂无客户关系", "en": "No account relationships" },
        "description": { "zh-CN": "从客户详情的“客户关系”标签新增，或在此创建关系。", "en": "Add a relationship from an account detail or create one here." }
      }
    }
  ]
}
