{
  "pageKey": "crm_contact_common_detail",
  "name:zh-CN": "联系人详情",
  "name:en": "Contact Detail",
  "modelCode": "crm_contact_common",
  "kind": "detail",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "crm_contact_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "overview",
          "label": {
            "zh-CN": "概览",
            "en-US": "Overview"
          },
          "blocks": [
            {
              "id": "section_basic",
              "blockType": "form-section",
              "title": {
                "zh-CN": "基本信息",
                "en-US": "Basic Information"
              },
              "columns": 2,
              "fields": [
                {
                  "field": "crm_ct_account_id",
                  "readOnly": true
                },
                {
                  "field": "crm_ct_name",
                  "readOnly": true
                },
                {
                  "field": "crm_ct_title",
                  "readOnly": true
                },
                {
                  "field": "crm_ct_email",
                  "readOnly": true
                },
                {
                  "field": "crm_ct_phone",
                  "readOnly": true
                },
                {
                  "field": "crm_ct_mobile",
                  "readOnly": true
                },
                {
                  "field": "crm_ct_is_primary",
                  "readOnly": true
                },
                {
                  "field": "crm_ct_remark",
                  "span": 2,
                  "readOnly": true
                }
              ]
            }
          ]
        },
        {
          "key": "activities",
          "label": {
            "zh-CN": "活动记录",
            "en-US": "Activities"
          },
          "blocks": [
            {
              "id": "block_activities",
              "blockType": "sub-table",
              "subTable": {
                "dataSource": {
                  "type": "api",
                  "url": "/api/datasource/list",
                  "method": "get",
                  "params": {
                    "datasourceId": "nq:crm_activities_by_object",
                    "objectType": "contact",
                    "objectId": "${recordId}"
                  }
                },
                "readOnly": true,
                "columns": [
                  {
                    "field": "crm_act_type",
                    "width": 100,
                    "renderType": "tag"
                  },
                  {
                    "field": "crm_act_subject",
                    "width": 250
                  },
                  {
                    "field": "crm_act_date",
                    "width": 150
                  },
                  {
                    "field": "crm_act_owner",
                    "width": 120
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "crm_contact_detail_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "edit",
          "icon": "Edit",
          "permissionCode": "crm.contact.manage",
          "label": "$i18n:common.button.edit",
          "action": {
            "type": "navigate",
            "to": "crm_contact_common_form"
          }
        },
        {
          "code": "log_activity",
          "icon": "MessageSquare",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:log_contact_activity"
          }
        },
        {
          "code": "create_task",
          "icon": "CheckSquare",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_activity_common_form",
            "command": "crm:create_contact_task"
          }
        }
      ]
    }
  ]
}
