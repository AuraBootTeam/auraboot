{
  "pageKey": "crm_assignment_rule_list",
  "name:zh-CN": "线索分配规则",
  "name:en": "Lead Assignment Rules",
  "modelCode": "crm_assignment_rule",
  "kind": "list",
  "schemaVersion": 4,
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "crm_asgn_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "permissionCode": "crm.assignment_rule.manage",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_assignment_rule_form"
          }
        }
      ]
    },
    {
      "id": "crm_asgn_table",
      "blockType": "table",
      "columns": [
        {
          "field": "crm_asgn_code",
          "width": 160,
          "sortable": true
        },
        {
          "field": "crm_asgn_name",
          "width": 200,
          "sortable": true
        },
        {
          "field": "crm_asgn_strategy",
          "width": 140,
          "renderType": "tag",
          "dictCode": "crm_assignment_strategy"
        },
        {
          "field": "crm_asgn_match_field",
          "width": 140,
          "renderType": "tag",
          "dictCode": "crm_assignment_match_field"
        },
        {
          "field": "crm_asgn_match_value",
          "width": 130
        },
        {
          "field": "crm_asgn_rep_pool",
          "width": 200
        },
        {
          "field": "crm_asgn_status",
          "width": 110,
          "renderType": "tag",
          "dictCode": "crm_assignment_rule_status"
        },
        {
          "field": "crm_asgn_priority",
          "width": 90,
          "align": "right",
          "sortable": true
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "label": "$i18n:common.actions",
          "buttons": [
            {
              "code": "view",
              "label": "$i18n:common.button.view",
              "action": {
                "type": "navigate",
                "to": "crm_assignment_rule_detail"
              }
            },
            {
              "code": "edit",
              "permissionCode": "crm.assignment_rule.manage",
              "label": "$i18n:common.button.edit",
              "action": {
                "type": "navigate",
                "to": "crm_assignment_rule_form"
              }
            },
            {
              "code": "delete",
              "danger": true,
              "permissionCode": "crm.assignment_rule.manage",
              "label": "$i18n:common.button.delete",
              "confirm": "delete.confirm",
              "action": {
                "type": "command"
              }
            }
          ]
        }
      ],
      "searchFields": [
        "crm_asgn_code",
        "crm_asgn_name"
      ],
      "defaultSort": {
        "field": "crm_asgn_priority",
        "order": "asc"
      }
    }
  ]
}
