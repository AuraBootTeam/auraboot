{
  "pageKey": "crm_email_template_list",
  "name:zh-CN": "邮件模板列表",
  "name:en": "Email Templates",
  "modelCode": "crm_email_template",
  "kind": "list",
  "schemaVersion": 4,
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "crm_et_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "all",
          "label": {
            "en": "All",
            "zh-CN": "全部"
          },
          "filter": null
        },
        {
          "key": "draft",
          "label": {
            "en": "Draft",
            "zh-CN": "草稿"
          },
          "filter": {
            "field": "crm_et_status",
            "value": "draft",
            "operator": "EQ"
          }
        },
        {
          "key": "active",
          "label": {
            "en": "Active",
            "zh-CN": "启用中"
          },
          "filter": {
            "field": "crm_et_status",
            "value": "active",
            "operator": "EQ"
          }
        },
        {
          "key": "archived",
          "label": {
            "en": "Archived",
            "zh-CN": "已归档"
          },
          "filter": {
            "field": "crm_et_status",
            "value": "archived",
            "operator": "EQ"
          }
        }
      ]
    },
    {
      "id": "crm_et_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "permissionCode": "crm.email_template.manage",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_email_template_form"
          }
        }
      ]
    },
    {
      "id": "crm_et_table",
      "blockType": "table",
      "columns": [
        {
          "field": "crm_et_name",
          "width": 220,
          "sortable": true
        },
        {
          "field": "crm_et_subject",
          "width": 300
        },
        {
          "field": "crm_et_category",
          "width": 140,
          "renderType": "tag",
          "dictCode": "crm_email_category"
        },
        {
          "field": "crm_et_status",
          "width": 100,
          "renderType": "tag",
          "dictCode": "crm_email_template_status"
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "buttons": [
            {
              "code": "view",
              "label": "$i18n:common.button.view",
              "action": {
                "type": "navigate",
                "to": "crm_email_template_detail"
              }
            },
            {
              "code": "edit",
              "permissionCode": "crm.email_template.manage",
              "label": "$i18n:common.button.edit",
              "action": {
                "type": "navigate",
                "to": "crm_email_template_form"
              }
            },
            {
              "code": "delete",
              "danger": true,
              "permissionCode": "crm.email_template.manage",
              "label": "$i18n:common.button.delete",
              "confirm": "delete.confirm",
              "action": {
                "type": "command"
              }
            }
          ],
          "label": "$i18n:common.actions"
        }
      ],
      "searchFields": [
        "crm_et_name",
        "crm_et_subject"
      ],
      "defaultSort": {
        "field": "crm_et_name",
        "order": "asc"
      }
    }
  ]
}
