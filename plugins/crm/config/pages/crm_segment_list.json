{
  "pageKey": "crm_segment_list",
  "name:zh-CN": "细分人群",
  "name:en": "Segments",
  "modelCode": "crm_segment",
  "kind": "list",
  "schemaVersion": 4,
  "layout": {
    "type": "stack"
  },
  "blocks": [
    {
      "id": "filters",
      "blockType": "filters",
      "fields": [
        {
          "field": "crm_seg_name"
        }
      ]
    },
    {
      "id": "toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
