          "field": "crm_seg_code"
        },
        {
          "field": "crm_seg_name"
        },
        {
          "field": "crm_seg_member_count"
        },
        {
          "field": "crm_seg_last_computed"
        }
      ],
      "rowActions": [
        {
          "code": "recompute",
          "label": "$i18n:crm.segment.recompute",
          "permissionCode": "crm.segment.manage",
          "action": {
            "type": "command",
            "command": "crm:recompute_segment"
          }
        }
      ]
    }
