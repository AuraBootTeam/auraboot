{
  "pageKey": "crm_risk_common_list",
  "name:zh-CN": "风险项",
  "name:en": "Risks",
  "modelCode": "crm_risk_common",
  "kind": "list",
  "schemaVersion": 4,
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "crm_rk_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "all",
          "label": {
            "zh-CN": "全部",
            "en": "All"
          }
        },
        {
          "key": "open",
          "label": {
            "zh-CN": "未处理",
            "en": "Open"
          },
          "filter": {
            "field": "crm_rk_status",
            "operator": "EQ",
            "value": "open"
          }
        },
        {
          "key": "mitigating",
          "label": {
            "zh-CN": "缓解中",
            "en": "Mitigating"
          },
          "filter": {
            "field": "crm_rk_status",
            "operator": "EQ",
            "value": "mitigating"
          }
        },
        {
          "key": "accepted",
          "label": {
            "zh-CN": "接受风险",
            "en": "Accepted"
          },
          "filter": {
            "field": "crm_rk_status",
            "operator": "EQ",
            "value": "accepted"
          }
        },
        {
          "key": "mitigated",
          "label": {
            "zh-CN": "已缓解",
            "en": "Mitigated"
          },
          "filter": {
            "field": "crm_rk_status",
            "operator": "EQ",
            "value": "mitigated"
          }
        }
      ]
    },
    {
      "id": "crm_rk_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "icon": "Plus",
          "permissionCode": "crm.risk.manage",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_risk_common_form"
          }
        }
      ]
    },
    {
      "id": "crm_rk_table",
      "blockType": "table",
      "columns": [
        {
          "field": "crm_rk_code",
          "sortable": true
        },
        {
          "field": "crm_rk_title",
          "sortable": true
        },
        {
          "field": "crm_rk_risk_type",
          "renderType": "tag",
          "dictCode": "crm_risk_type"
        },
        {
          "field": "crm_rk_severity",
          "renderType": "tag",
          "dictCode": "crm_risk_severity",
          "sortable": true
        },
        {
          "field": "crm_rk_status",
          "renderType": "tag",
          "dictCode": "crm_risk_status",
          "sortable": true
        },
        {
          "field": "crm_rk_review_id"
        },
        {
          "field": "crm_rk_customer_request_id"
        },
        {
          "field": "crm_rk_account_id"
        },
        {
          "field": "crm_rk_owner_id"
        },
        {
          "field": "crm_rk_description"
        },
        {
          "field": "crm_rk_mitigation"
        },
        {
          "field": "crm_rk_due_at",
          "sortable": true
        },
        {
          "field": "crm_rk_resolved_at",
          "sortable": true
        },
        {
          "field": "crm_rk_source_model"
        },
        {
          "field": "crm_rk_source_id"
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "label": "$i18n:common.actions",
          "buttons": [
            {
              "code": "view",
              "icon": "Eye",
              "permissionCode": "crm.risk.read",
              "label": "$i18n:common.button.view",
              "action": {
                "type": "navigate",
                "to": "crm_risk_common_detail"
              }
            },
            {
              "code": "start_mitigation",
              "icon": "ShieldHalf",
              "permissionCode": "crm.risk.manage",
              "label": {
                "zh-CN": "开始缓解",
                "en-US": "Start Mitigation"
              },
              "action": {
                "type": "state_transition",
                "command": "crm:start_risk_mitigation"
              },
              "visibleWhen": "record.crm_rk_status === 'open'"
            },
            {
              "code": "mitigate",
              "icon": "ShieldCheck",
              "permissionCode": "crm.risk.manage",
              "label": {
                "zh-CN": "已缓解",
                "en-US": "Mitigate"
              },
              "action": {
                "type": "state_transition",
                "command": "crm:mitigate_risk"
              },
              "visibleWhen": "['open','mitigating'].includes(record.crm_rk_status)"
            },
            {
              "code": "accept_risk",
              "icon": "CheckCircle2",
              "permissionCode": "crm.risk.manage",
              "label": {
                "zh-CN": "接受风险",
                "en-US": "Accept Risk"
              },
              "action": {
                "type": "state_transition",
                "command": "crm:accept_risk"
              },
              "visibleWhen": "['open','mitigating'].includes(record.crm_rk_status)"
            },
            {
              "code": "resolve_risk",
              "icon": "BadgeCheck",
              "permissionCode": "crm.risk.manage",
              "label": {
                "zh-CN": "已解决",
                "en-US": "Resolve"
              },
              "action": {
                "type": "state_transition",
                "command": "crm:resolve_risk"
              },
              "visibleWhen": "['mitigated','accepted'].includes(record.crm_rk_status)"
            },
            {
              "code": "delete",
              "icon": "Trash2",
              "permissionCode": "crm.risk.manage",
              "label": {
                "zh-CN": "删除",
                "en-US": "Delete"
              },
              "action": {
                "type": "command"
              },
              "danger": true
            },
            {
              "code": "edit",
              "icon": "Edit",
              "permissionCode": "crm.risk.manage",
              "label": "$i18n:common.button.edit",
              "action": {
                "type": "navigate",
                "to": "crm_risk_common_form"
              }
            }
          ]
        }
      ],
      "searchFields": [
        "crm_rk_code",
        "crm_rk_title",
        "crm_rk_owner_id",
        "crm_rk_description",
        "crm_rk_source_model",
        "crm_rk_source_id"
      ],
      "defaultSort": {
        "field": "crm_rk_code",
        "order": "desc"
      },
      "selection": {
        "mode": "multiple"
      },
      "bulkActions": [
        {
          "code": "bulk_mitigate",
          "icon": "ShieldCheck",
          "permissionCode": "crm.risk.manage",
          "label": {
            "zh-CN": "批量缓解",
            "en-US": "Mitigate Selected"
          },
          "action": {
            "type": "bulk_state_transition",
            "command": "crm:mitigate_risk"
          }
        },
        {
          "code": "bulk_accept_risk",
          "icon": "CheckCircle2",
          "permissionCode": "crm.risk.manage",
          "label": {
            "zh-CN": "批量接受风险",
            "en-US": "Accept Selected"
          },
          "action": {
            "type": "bulk_state_transition",
            "command": "crm:accept_risk"
          }
        }
      ]
    }
  ]
}
