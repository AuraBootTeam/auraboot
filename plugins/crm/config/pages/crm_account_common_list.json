{
  "pageKey": "crm_account_common_list",
  "name:zh-CN": "客户列表",
  "name:en": "Accounts",
  "modelCode": "crm_account_common",
  "kind": "list",
  "schemaVersion": 4,
  "extension": {
    "import": {
      "enabled": true,
      "permissionCode": "model.crm_account_common.import",
      "modes": ["insert", "update"],
      "updateKeys": ["crm_acc_code"]
    }
  },
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "crm_account_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "all",
          "label": {
            "en": "All",
            "zh-CN": "全部"
          },
          "filter": null
        },
        {
          "key": "active",
          "label": {
            "en": "Active",
            "zh-CN": "活跃"
          },
          "filter": {
            "field": "crm_acc_status",
            "value": "active",
            "operator": "EQ"
          }
        },
        {
          "key": "inactive",
          "label": {
            "en": "Inactive",
            "zh-CN": "停用"
          },
          "filter": {
            "field": "crm_acc_status",
            "value": "inactive",
            "operator": "EQ"
          }
        }
      ]
    },
    {
      "id": "crm_account_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "permissionCode": "crm.account.manage",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_account_common_form"
          }
        }
      ]
    },
    {
      "id": "crm_account_table",
      "blockType": "table",
      "onRowClick": "navigate",
      "columns": [
        {
          "field": "crm_acc_code",
          "width": 140,
          "sortable": true
        },
        {
          "field": "crm_acc_name",
          "width": 200,
          "sortable": true
        },
        {
          "field": "crm_acc_industry",
          "width": 120,
          "renderType": "tag",
          "dictCode": "crm_account_industry"
        },
        {
          "field": "crm_acc_status",
          "width": 100,
          "renderType": "tag",
          "dictCode": "crm_account_status"
        },
        {
          "field": "crm_acc_owner",
          "width": 120,
          "label": {
            "zh-CN": "负责人",
            "en": "Owner"
          },
          "refTarget": {
            "modelCode": "sys_user",
            "valueField": "pid",
            "displayField": "displayName"
          }
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "buttons": [
            {
              "code": "view",
              "label": "$i18n:common.button.view",
              "action": {
                "type": "navigate",
                "to": "crm_account_common_detail"
              }
            },
            {
              "code": "edit",
              "permissionCode": "crm.account.manage",
              "label": "$i18n:common.button.edit",
              "action": {
                "type": "navigate",
                "to": "crm_account_common_form"
              }
            },
            {
              "code": "delete",
              "danger": true,
              "permissionCode": "crm.account.manage",
              "label": "$i18n:common.button.delete",
              "confirm": "delete.confirm",
              "action": {
                "type": "command"
              }
            }
          ],
          "label": "$i18n:common.actions"
        }
      ],
      "searchFields": [
        "crm_acc_name",
        "crm_acc_code",
        "crm_acc_industry"
      ],
      "defaultSort": {
        "field": "created_at",
        "order": "desc"
      },
      "rowActions": [
        {
          "code": "recompute",
          "label": "$i18n:crm.account.recompute",
          "permissionCode": "crm.account.manage",
          "action": {
            "type": "command",
            "command": "crm:recompute_health"
          }
        }
      ]
    }
  ]
}
