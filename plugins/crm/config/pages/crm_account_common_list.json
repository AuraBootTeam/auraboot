{
  "pageKey": "crm_account_common_list",
  "name:zh-CN": "客户列表",
  "name:en": "Accounts",
  "modelCode": "crm_account_common",
  "kind": "list",
  "schemaVersion": 4,
  "extension": {
    "import": {
      "enabled": true,
      "permissionCode": "model.crm_account_common.import",
      "modes": ["insert", "update"],
      "updateKeys": ["crm_acc_code"]
    }
  },
  "layout": {
    "type": "grid",
    "cols": 12
  },
  "blocks": [
    {
      "id": "crm_account_tabs",
      "blockType": "tabs",
      "tabs": [
        {
          "key": "all",
          "label": {
            "en": "All",
            "zh-CN": "全部"
          },
          "filter": null
        },
        {
          "key": "active",
          "label": {
            "en": "Active",
            "zh-CN": "活跃"
          },
          "filter": {
            "field": "crm_acc_status",
            "value": "active",
            "operator": "EQ"
          }
        },
        {
          "key": "inactive",
          "label": {
            "en": "Inactive",
            "zh-CN": "停用"
          },
          "filter": {
            "field": "crm_acc_status",
            "value": "inactive",
            "operator": "EQ"
          }
        }
      ]
    },
    {
      "id": "crm_account_toolbar",
      "blockType": "toolbar",
      "buttons": [
        {
          "code": "create",
          "primary": true,
          "permissionCode": "crm.account.manage",
          "label": "$i18n:common.button.create",
          "action": {
            "type": "navigate",
            "to": "crm_account_common_form"
          }
        }
      ]
    },
    {
      "id": "crm_account_table",
      "blockType": "table",
      "table": {
        "selection": { "mode": "multiple", "bind": "{{state.selectedIds}}" },
        "bulkCapabilities": {
          "edit": { "permissionCode": "crm.account.manage" },
          "delete": { "permissionCode": "crm.account.manage" },
          "export": { "permissionCode": "crm.account.read" }
        },
        "bulkActions": [
          {
            "code": "bulk_transfer_owner",
            "permissionCode": "crm.account.manage",
            "label": { "zh-CN": "批量转移负责人", "en-US": "Transfer Selected Owners" },
            "action": {
              "type": "bulk_field_command",
              "command": "crm:update_account",
              "input": {
                "field": "crm_acc_owner",
                "label": { "zh-CN": "新负责人", "en-US": "New Owner" },
                "type": "reference",
                "component": "MemberPicker",
                "required": true,
                "props": { "multiple": false }
              }
            }
          },
          {
            "code": "bulk_update_industry",
            "permissionCode": "crm.account.manage",
            "label": { "zh-CN": "批量更新行业", "en-US": "Update Selected Industries" },
            "action": {
              "type": "bulk_field_command",
              "command": "crm:update_account",
              "input": {
                "field": "crm_acc_industry",
                "label": { "zh-CN": "行业", "en-US": "Industry" },
                "type": "enum",
                "dictCode": "crm_account_industry",
                "required": true
              }
            }
          },
          {
            "code": "bulk_delete_accounts",
            "permissionCode": "crm.account.manage",
            "variant": "danger",
            "label": { "zh-CN": "批量删除", "en-US": "Delete Selected" },
            "confirm": {
              "zh-CN": "确认删除选中的客户？有关联业务的客户会被明确拒绝。",
              "en-US": "Delete the selected accounts? Accounts with related business records will be rejected."
            },
            "action": {
              "type": "bulk_record_command",
              "command": "crm:delete_account",
              "operationType": "DELETE"
            }
          },
          {
            "code": "bulk_move_to_customer_pool",
            "permissionCode": "crm.customer_pool.move",
            "label": { "zh-CN": "批量移入客户公海", "en-US": "Move Selected to Public Pool" },
            "action": {
              "type": "bulk_field_command",
              "command": "crm:move_customer_to_pool",
              "input": {
                "field": "crm_acc_last_pool_id",
                "label": { "zh-CN": "目标客户公海", "en-US": "Target Customer Pool" },
                "type": "reference",
                "referenceModelCode": "crm_customer_pool_common",
                "refTarget": {
                  "targetModel": "crm_customer_pool_common",
                  "valueField": "pid",
                  "displayField": "crm_cp_name"
                },
                "required": true
              }
            }
          }
        ]
      },
      "selection": { "type": "checkbox" },
      "onRowClick": "navigate",
      "columns": [
        {
          "field": "crm_acc_code",
          "width": 140,
          "sortable": true
        },
        {
          "field": "crm_acc_name",
          "width": 200,
          "ellipsis": true,
          "sortable": true
        },
        {
          "field": "crm_acc_industry",
          "width": 120,
          "renderType": "tag",
          "dictCode": "crm_account_industry"
        },
        {
          "field": "crm_acc_status",
          "width": 100,
          "renderType": "tag",
          "dictCode": "crm_account_status"
        },
        {
          "field": "crm_acc_owner",
          "width": 120,
          "label": {
            "zh-CN": "负责人",
            "en": "Owner"
          },
          "refTarget": {
            "modelCode": "sys_user",
            "valueField": "pid",
            "displayField": "displayName"
          }
        },
        {
          "field": "crm_acc_pool_state",
          "width": 110,
          "renderType": "tag",
          "dictCode": "crm_customer_pool_state"
        },
        {
          "field": "actions",
          "isActionColumn": true,
          "buttons": [
            {
              "code": "view",
              "label": "$i18n:common.button.view",
              "action": {
                "type": "navigate",
                "to": "crm_account_common_detail"
              }
            },
            {
              "code": "edit",
              "permissionCode": "crm.account.manage",
              "label": "$i18n:common.button.edit",
              "action": {
                "type": "navigate",
                "to": "crm_account_common_form"
              }
            },
            {
              "code": "move_to_customer_pool",
              "permissionCode": "crm.customer_pool.move",
              "label": { "zh-CN": "移入客户公海", "en": "Move to Public Pool" },
              "visibleWhen": "row.crm_acc_pool_state != 'in_pool' && row.crm_acc_status == 'active'",
              "action": {
                "type": "command",
                "command": "crm:move_customer_to_pool",
                "operationType": "update",
                "inputFieldsTitle": { "zh-CN": "移入客户公海", "en": "Move to Customer Pool" },
                "inputFields": [
                  {
                    "field": "crm_acc_last_pool_id",
                    "label": { "zh-CN": "目标客户公海", "en": "Target Customer Pool" },
                    "type": "select",
                    "searchable": true,
                    "dataSource": {
                      "type": "api",
                      "endpoint": "/api/dynamic/crm_customer_pool_common/list",
                      "params": { "pageNum": 1, "pageSize": 200 },
                      "valueField": "pid",
                      "labelField": "crm_cp_name"
                    },
                    "required": true
                  }
                ]
              }
            },
            {
              "code": "delete",
              "danger": true,
              "permissionCode": "crm.account.manage",
              "label": "$i18n:common.button.delete",
              "confirm": "delete.confirm",
              "action": {
                "type": "command",
                "operationType": "DELETE"
              }
            }
          ],
          "label": "$i18n:common.actions"
        }
      ],
      "searchFields": [
        "crm_acc_name",
        "crm_acc_code",
        "crm_acc_industry"
      ],
      "defaultSort": {
        "field": "created_at",
        "order": "desc"
      },
      "searchPlaceholder": { "zh-CN": "搜索客户名称、编号或行业", "en": "Search customer name, code, or industry" },
      "empty": {
        "title": { "zh-CN": "暂无符合条件的客户", "en": "No matching customers" },
        "description": { "zh-CN": "调整筛选，或新建客户后再移入公海。", "en": "Adjust filters or create a customer before moving it to a public pool." }
      },
      "rowActions": [
        {
          "code": "recompute",
          "label": "$i18n:crm.account.recompute",
          "permissionCode": "crm.account.manage",
          "action": {
            "type": "command",
            "command": "crm:recompute_health"
          }
        }
      ]
    }
  ]
}
