            "command": "crm:run_journey_scheduler"
          }
        }
      ]
    },
    {
      "id": "table",
      "blockType": "table",
      "columns": [
        {
          "field": "crm_jne_journey_id"
        },
        {
          "field": "crm_jne_contact_id"
        },
        {
          "field": "crm_jne_current_step"
        },
        {
          "field": "crm_jne_status",
