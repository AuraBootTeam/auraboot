{
  "name": "@auraboot/ui",
  "version": "1.0.0",
  "description": "Stable AuraBoot UI primitives shared by the Web Shell and product contributions",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts", "default": "./src/index.ts" },
    "./toast": { "types": "./src/toast.tsx", "import": "./src/toast.tsx", "default": "./src/toast.tsx" }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit" },
  "peerDependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.7.2"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" }
}
