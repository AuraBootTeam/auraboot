    {
      "pageKey": "bpm_process_management_list",
      "modelCode": "bpm_process_management",
      "name:zh-CN": "BPM 流程定义",
      "name:en": "BPM Process Management",
      "kind": "list",
      "schemaVersion": 4,
      "layout": {
        "type": "stack"
      },
      "blocks": [
        {
          "id": "toolbar",
          "blockType": "toolbar",
          "buttons": [
            {
              "code": "create",
              "label": {
                "zh-CN": "新建",
                "en-US": "Create"
              },
              "variant": "primary",
              "action": {
                "type": "navigate",
                "to": "/bpm/designer"
              }
            }
          ]
        },
        {
          "id": "tabs",
          "blockType": "tabs",
          "tabs": [
            {
              "key": "all",
              "label": {
                "zh-CN": "全部",
                "en-US": "All"
              }
            },
            {
              "key": "draft",
              "label": {
                "zh-CN": "草稿",
                "en-US": "Draft"
              },
              "filter": {
                "field": "status",
                "operator": "EQ",
                "value": "draft"
              }
            },
            {
              "key": "deployed",
              "label": {
                "zh-CN": "已部署",
                "en-US": "Deployed"
              },
              "filter": {
                "field": "status",
                "operator": "EQ",
                "value": "deployed"
              }
            },
            {
              "key": "suspended",
              "label": {
                "zh-CN": "已暂停",
                "en-US": "Suspended"
              },
              "filter": {
                "field": "status",
                "operator": "EQ",
                "value": "suspended"
              }
            }
          ]
        },
        {
          "id": "table",
          "blockType": "table",
          "columns": [
            {
              "field": "process_key",
              "label": {
                "zh-CN": "流程标识",
                "en-US": "Process Key"
              },
              "width": 180
            },
            {
              "field": "process_name",
              "label": {
                "zh-CN": "流程名称",
                "en-US": "Process Name"
              },
              "width": 220
            },
            {
              "field": "category",
              "label": {
                "zh-CN": "分类",
                "en-US": "Category"
              },
              "width": 140
            },
            {
              "field": "version",
              "label": {
                "zh-CN": "版本",
                "en-US": "Version"
              },
              "width": 90
            },
            {
              "field": "status",
              "label": {
                "zh-CN": "状态",
                "en-US": "Status"
              },
              "width": 120,
              "renderType": "tag",
              "dictCode": "bpm_process_status"
            },
            {
              "field": "deployed_at",
              "label": {
                "zh-CN": "部署时间",
                "en-US": "Deployed At"
              },
              "width": 180,
              "valueType": "datetime",
              "format": "YYYY-MM-DD HH:mm"
            }
          ],
          "rowActions": [
            {
              "code": "configure_rules",
              "label": {
                "zh-CN": "配置规则",
                "en-US": "Configure Rules"
              },
              "action": {
                "type": "navigate",
                "to": "/p/bpm_process_management/edit/{pid}"
              }
            },
            {
              "code": "open_bpmn_designer",
              "label": {
                "zh-CN": "设计流程",
                "en-US": "Design Process"
              },
              "action": {
                "type": "navigate",
                "to": "/bpm/designer?pid={pid}"
              }
            },
            {
              "code": "deploy",
              "visibleWhen": "row.status === 'draft'",
              "label": {
                "zh-CN": "部署",
                "en-US": "Deploy"
              },
              "action": {
                "type": "flow",
                "steps": [
                  {
                    "action": "api.request",
                    "endpoint": "/api/bpm/process-definitions/${record.pid}/deploy",
                    "method": "post"
                  }
                ]
              }
            },
            {
              "code": "suspend",
              "visibleWhen": "row.status === 'deployed'",
              "label": {
                "zh-CN": "暂停",
                "en-US": "Suspend"
              },
              "action": {
                "type": "flow",
                "steps": [
                  {
                    "action": "api.request",
                    "endpoint": "/api/bpm/process-definitions/${record.pid}/suspend",
                    "method": "post"
                  }
                ]
              }
            },
            {
              "code": "resume",
              "visibleWhen": "row.status === 'suspended'",
              "label": {
                "zh-CN": "恢复",
                "en-US": "Resume"
              },
              "action": {
                "type": "flow",
                "steps": [
                  {
                    "action": "api.request",
                    "endpoint": "/api/bpm/process-definitions/${record.pid}/resume",
                    "method": "post"
                  }
                ]
              }
            },
            {
              "code": "delete",
              "visibleWhen": "row.status === 'draft'",
              "danger": true,
              "label": {
                "zh-CN": "删除",
                "en-US": "Delete"
              },
              "confirm": "confirm.delete",
              "action": {
                "type": "flow",
                "steps": [
                  {
                    "action": "api.request",
                    "endpoint": "/api/bpm/process-definitions/${record.pid}",
                    "method": "delete"
                  }
                ]
              }
            }
          ],
          "defaultSort": {
            "field": "deployedAt",
            "order": "desc"
          },
          "onRowClick": "navigate",
          "detailUrl": "/p/bpm_process_management/edit/{pid}"
        }
      ],
      "extension": {
        "dataSource": {
          "type": "api",
          "endpoint": "/api/bpm/process-definitions",
          "method": "get"
        }
      }
    },
    {
      "pageKey": "bpm_process_management_form",
      "modelCode": "bpm_process_management",
      "name:zh-CN": "BPM 流程定义配置",
      "name:en": "BPM Process Definition Configuration",
      "kind": "form",
