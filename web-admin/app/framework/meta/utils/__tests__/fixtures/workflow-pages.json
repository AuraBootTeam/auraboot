        {
          "id": "bpm_rule_binding",
          "blockType": "custom",
          "component": "DecisionRuleBindingBlock",
          "props": {
            "mode": "decision",
            "consumerType": "BPM",
            "consumerNodeId": "gw_approver",
            "showImpactPreview": true,
            "showTestRunner": true,
            "fieldCatalogMode": "fallback",
            "initialDecisionCode": "approval_routing",
            "initialVersionPolicy": "LATEST_PUBLISHED",
            "fields": [
              {
                "scope": "process",
                "path": "nodeId",
                "label": "BPM 节点",
                "dataType": "string"
              },
              {
                "scope": "process",
                "path": "processKey",
                "label": "流程标识",
                "dataType": "string"
              },
              {
                "scope": "record",
                "path": "data.wd_req_days",
                "label": "请假天数",
                "dataType": "decimal"
              },
              {
                "scope": "record",
                "path": "data.wd_req_type",
                "label": "请假类型",
                "dataType": "enum",
                "options": [
                  "annual",
                  "sick",
                  "personal"
                ]
              },
              {
                "scope": "actor",
                "path": "departmentId",
                "label": "当前处理人部门",
                "dataType": "department"
              }
            ],
            "decisions": [
              {
                "code": "approval_routing",
                "name": "审批路由"
              },
              {
                "code": "task_assignee",
                "name": "任务分派"
              },
              {
                "code": "sla_deadline",
                "name": "SLA 截止时间"
              }
            ],
            "initialContextJson": "{\n  \"process\": {\n    \"nodeId\": \"task_manager_approve\",\n    \"processKey\": \"wd_leave_approval\"\n  },\n  \"record\": {\n    \"data\": {\n      \"wd_req_days\": 4,\n      \"wd_req_type\": \"annual\"\n    }\n  }\n}",
            "initialValue": {
              "consumerType": "BPM",
              "consumerCode": "wd_leave_approval",
              "consumerNodeId": "gw_approver",
              "bindingKind": "DECISION_REF",
              "enabled": true,
              "decisionBinding": {
                "decisionCode": "approval_routing",
                "versionPolicy": "LATEST_PUBLISHED",
                "inputMappings": [
                  {
                    "input": "nodeId",
                    "source": {
                      "kind": "FIELD",
                      "scope": "process",
                      "path": "nodeId"
                    }
                  },
                  {
