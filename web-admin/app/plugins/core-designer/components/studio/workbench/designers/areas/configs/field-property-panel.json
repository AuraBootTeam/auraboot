{
  "meta": {
    "type": "property-panel",
    "version": "4.0",
    "component": "DslField",
    "title": { "zh-CN": "字段属性", "en-US": "Field properties" }
  },
  "sections": [
    {
      "code": "basic",
      "title": { "zh-CN": "基本属性", "en-US": "Basic properties" },
      "layout": { "columns": 1, "gap": "small" },
      "fields": [
        {
          "field": "field",
          "component": "SmartInput",
          "props": { "label": { "zh-CN": "字段名", "en-US": "Field name" }, "disabled": true, "size": "small" }
        },
        {
          "field": "label",
          "component": "LocalizedTextInput",
          "props": { "label": { "zh-CN": "标签", "en-US": "Label" }, "placeholder": { "zh-CN": "覆盖字段标签", "en-US": "Override the field label" }, "size": "small" }
        },
        {
          "field": "placeholder",
          "component": "SmartInput",
          "props": { "label": { "zh-CN": "占位符", "en-US": "Placeholder" }, "placeholder": { "zh-CN": "请输入...", "en-US": "Enter a value..." }, "size": "small" },
          "visible": "blockType !== 'table'"
        },
        {
          "field": "component",
          "component": "SmartSelect",
          "props": {
            "label": { "zh-CN": "组件类型", "en-US": "Component type" },
            "size": "small",
            "allowClear": true,
            "placeholder": { "zh-CN": "自动选择", "en-US": "Automatic selection" }
          },
          "optionsKey": "componentOptions",
          "visible": "blockType !== 'table'"
        }
      ]
    },
    {
      "code": "validation",
      "title": { "zh-CN": "验证规则", "en-US": "Validation rules" },
      "layout": { "columns": 2, "gap": "small" },
      "visible": "blockType !== 'table'",
      "fields": [
        {
          "field": "required",
          "component": "SmartSwitch",
          "props": { "label": { "zh-CN": "必填", "en-US": "Required" } }
        },
        {
          "field": "readonly",
          "component": "SmartSwitch",
          "props": { "label": { "zh-CN": "只读", "en-US": "Read only" } }
        },
        {
          "field": "maxLength",
          "component": "SmartInput",
          "props": { "label": { "zh-CN": "最大长度", "en-US": "Maximum length" }, "type": "number", "min": 1, "size": "small" },
          "visible": "dataType === 'string' || dataType === 'text'",
          "layout": { "colSpan": 1 }
        },
        {
          "field": "minLength",
          "component": "SmartInput",
          "props": { "label": { "zh-CN": "最小长度", "en-US": "Minimum length" }, "type": "number", "min": 0, "size": "small" },
          "visible": "dataType === 'string' || dataType === 'text'",
          "layout": { "colSpan": 1 }
        },
        {
          "field": "pattern",
          "component": "SmartInput",
          "props": { "label": { "zh-CN": "正则表达式", "en-US": "Regular expression" }, "placeholder": "^[A-Z]+$", "size": "small" },
          "visible": "dataType === 'string'",
          "layout": { "colSpan": 2 }
        },
        {
          "field": "minValue",
          "component": "SmartInput",
          "props": { "label": { "zh-CN": "最小值", "en-US": "Minimum value" }, "type": "number", "size": "small" },
          "visible": "dataType === 'integer' || dataType === 'decimal'",
          "layout": { "colSpan": 1 }
        },
        {
          "field": "maxValue",
          "component": "SmartInput",
          "props": { "label": { "zh-CN": "最大值", "en-US": "Maximum value" }, "type": "number", "size": "small" },
          "visible": "dataType === 'integer' || dataType === 'decimal'",
          "layout": { "colSpan": 1 }
        }
      ]
    },
    {
      "code": "behavior",
      "title": { "zh-CN": "行为控制", "en-US": "Behavior" },
      "layout": { "columns": 2, "gap": "small" },
      "fields": [
        {
          "field": "visible",
          "component": "SmartInput",
          "props": { "label": { "zh-CN": "可见性条件", "en-US": "Visibility condition" }, "placeholder": "{{ ... }}", "size": "small" },
          "layout": { "colSpan": 2 }
        },
        {
          "field": "disabled",
          "component": "SmartInput",
          "props": { "label": { "zh-CN": "禁用条件", "en-US": "Disabled condition" }, "placeholder": "{{ ... }}", "size": "small" },
          "layout": { "colSpan": 2 }
        },
        {
          "field": "advanced",
          "component": "SmartSwitch",
          "props": { "label": { "zh-CN": "高级筛选", "en-US": "Advanced filter" } },
          "visible": "blockType === 'filters'"
        },
        {
          "field": "sortable",
          "component": "SmartSwitch",
          "props": { "label": { "zh-CN": "可排序", "en-US": "Sortable" } },
          "visible": "blockType === 'table'"
        },
        {
          "field": "copyable",
          "component": "SmartSwitch",
          "props": { "label": { "zh-CN": "可复制", "en-US": "Copyable" } },
          "visible": "blockType === 'table'"
        },
        {
          "field": "ellipsis",
          "component": "SmartSwitch",
          "props": { "label": { "zh-CN": "省略文本", "en-US": "Ellipsis" } },
          "visible": "blockType === 'table'"
        }
      ]
    },
    {
      "code": "layout",
      "title": { "zh-CN": "布局设置", "en-US": "Layout" },
      "layout": { "columns": 2, "gap": "small" },
      "fields": [
        {
          "field": "span",
          "component": "SmartSelect",
          "props": {
            "label": { "zh-CN": "跨列数", "en-US": "Column span" },
            "size": "small",
            "options": [
              { "label": { "zh-CN": "1列", "en-US": "1 column" }, "value": 1 },
              { "label": { "zh-CN": "2列", "en-US": "2 columns" }, "value": 2 },
              { "label": { "zh-CN": "3列", "en-US": "3 columns" }, "value": 3 },
              { "label": { "zh-CN": "4列", "en-US": "4 columns" }, "value": 4 }
            ]
          },
          "visible": "blockType !== 'table'"
        },
        {
          "field": "width",
          "component": "SmartInput",
          "props": { "label": { "zh-CN": "列宽 (px)", "en-US": "Column width (px)" }, "type": "number", "min": 50, "size": "small" },
          "visible": "blockType === 'table'"
        },
        {
          "field": "fixed",
          "component": "SmartSelect",
          "props": {
            "label": { "zh-CN": "固定列", "en-US": "Fixed column" },
            "size": "small",
            "allowClear": true,
            "options": [
              { "label": { "zh-CN": "左侧", "en-US": "Left" }, "value": "left" },
              { "label": { "zh-CN": "右侧", "en-US": "Right" }, "value": "right" }
            ]
          },
          "visible": "blockType === 'table'"
        },
        {
          "field": "render",
          "component": "SmartSelect",
          "props": {
            "label": { "zh-CN": "渲染类型", "en-US": "Render type" },
            "size": "small",
            "allowClear": true,
            "options": [
              { "label": { "zh-CN": "标签", "en-US": "Label" }, "value": "tag" },
              { "label": { "zh-CN": "日期时间", "en-US": "Date and time" }, "value": "datetime" },
              { "label": { "zh-CN": "货币", "en-US": "Currency" }, "value": "currency" },
              { "label": { "zh-CN": "链接", "en-US": "Link" }, "value": "link" },
              { "label": { "zh-CN": "图片", "en-US": "Image" }, "value": "image" }
            ]
          },
          "visible": "blockType === 'table'"
        }
      ]
    }
  ]
}
