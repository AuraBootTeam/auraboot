{
  "format": "auraboot.report-template",
  "version": 1,
  "dsl": {
    "$schema": "auraboot://schemas/report/v1",
    "version": "1.0.0",
    "title": "客户分析报告",
    "description": "客户与项目交付场景的设计模板；运行时重新查询当前租户可访问的数据。",
    "page": { "size": "A4", "orientation": "portrait", "margin": { "top": 20, "right": 15, "bottom": 20, "left": 15 } },
    "dataSources": { "customers": { "type": "model", "modelCode": "tpm_customer" } },
    "header": { "height": 15, "elements": [{ "type": "text", "content": "客户经营分析", "align": "left", "style": { "fontSize": 18, "fontWeight": "bold" } }] },
    "body": [
      { "id": "analysis_intro", "blockType": "rich-text", "content": "按客户梳理联系人与项目跟进信息，识别下一步行动。", "style": { "fontSize": 11 } },
      { "id": "analysis_customers", "blockType": "table", "title": "客户联系清单", "dataSource": "customers", "columns": [{ "field": "tpm_cu_name", "label": "客户名称", "width": 220 }, { "field": "tpm_cu_contact", "label": "客户联系人", "width": 180 }], "showHeader": true, "stripe": true }
    ],
    "footer": { "height": 10, "elements": [{ "type": "page-number", "align": "right" }] }
  }
}
